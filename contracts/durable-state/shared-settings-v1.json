{
  "id": "PV-SET-001",
  "kind": "shared-settings-document",
  "cases": [
    {
      "id": "versionless-merge-preserves-unknown",
      "initial": {
        "mode": "json",
        "document": {
          "confirmBeforeDelete": true,
          "keyBindings": {
            "nextImage": "ArrowRight",
            "futureChord": {
              "mode": "keep"
            }
          },
          "futureRoot": {
            "owner": "browser"
          },
          "thumbnailStatusBorders": {
            "futureStatus": "keep",
            "favorite": {
              "enabled": false,
              "color": "#112233",
              "futureFavorite": 17
            },
            "enhanced": {
              "enabled": true,
              "color": "#445566",
              "futureEnhanced": {
                "mode": "keep"
              }
            }
          }
        }
      },
      "localConfirmBeforeDelete": false,
      "operations": [
        {
          "action": "confirm",
          "value": false
        },
        {
          "action": "borders",
          "dirty": [
            "favorite"
          ],
          "favorite": {
            "enabled": true,
            "color": "#ABCDEF"
          },
          "enhanced": {
            "enabled": false,
            "color": "#010203"
          }
        }
      ],
      "expected": {
        "initialProtected": false,
        "effectiveConfirmBeforeDelete": true,
        "statuses": [
          "Succeeded",
          "Succeeded"
        ],
        "fileExists": true,
        "bytesUnchanged": false,
        "final": {
          "mode": "json",
          "document": {
            "confirmBeforeDelete": false,
            "keyBindings": {
              "nextImage": "ArrowRight",
              "futureChord": {
                "mode": "keep"
              }
            },
            "futureRoot": {
              "owner": "browser"
            },
            "thumbnailStatusBorders": {
              "futureStatus": "keep",
              "favorite": {
                "enabled": true,
                "color": "#abcdef",
                "futureFavorite": 17
              },
              "enhanced": {
                "enabled": true,
                "color": "#445566",
                "futureEnhanced": {
                  "mode": "keep"
                }
              }
            }
          }
        }
      }
    },
