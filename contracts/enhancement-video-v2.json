    "canvasPolicy": {
      "kind": "source-aspect-aligned-v1",
      "alignment": 32,
      "minDimension": 256,
      "maxDimension": 1344,
      "maxPixelArea": 414720,
      "normalization": "use the shared source-aspect normalizer when its aligned result is within these bounds; otherwise enumerate every aligned bounded bucket and minimize abs((width / height) / sourceAspect - 1) + (1 - area / 414720) * 0.25, then prefer larger area, larger width, and larger height in that order",
      "sourceGeometryPersistence": "do not persist observed source width or height; persist only the selected effective width and height",
      "firstFrame": "apply EXIF orientation, use the exact selected canvas, and cover-center without blurred or synthetic side fill"
    },
    "canary": {
      "width": 864,
      "height": 480,
      "meaning": "startup evidence only; not a fixed output canvas"
    },
    "frameCount": 124,
    "playbackFps": 24,
    "displayDurationSeconds": 5.167,
    "exactDurationSeconds": 5.166666666666667,
    "steps": 20,
    "sampler": "res_multistep",
    "scheduler": "simple",
    "denoise": 1,
    "codec": "h264",
    "container": "mp4",
    "bitDepth": 8,
    "delivery": {
      "pixelFormat": "yuv420p",
      "videoCodec": "h264",
      "audioCodec": "aac",
