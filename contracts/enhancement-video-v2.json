          "maximum": 40,
          "capability": "capabilities.videoH3StepsV1"
        },
        "maximumPixelArea": {
          "defaultForLegacyRows": 414720,
          "allowedValues": [230400, 307200, 414720],
          "capability": "capabilities.videoH3CanvasTiersV1"
        }
      },
