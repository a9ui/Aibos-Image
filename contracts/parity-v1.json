{
  "schemaVersion": 1,
  "sourceOfTruth": "docs/product-contract.md",
  "contracts": [
    {
      "id": "PV-SH-001",
      "kind": "search-history-identity",
      "cases": [
        {
          "id": "explicit-trim-and-empty-token",
          "samples": [
            {
              "input": "\ufeff  trim  \ufeff, ,\u0085parity\u0085",
              "normalized": "trim, parity",
              "comparisonKey": "trim, parity"
            }
          ]
        },
        {
          "id": "nfkc-dotted-i-equivalence",
          "samples": [
            {
              "input": "\uff23\uff21\uff34, \u0130",
              "normalized": "\uff23\uff21\uff34, \u0130",
              "comparisonKey": "cat, i\u0307"
            },
            {
              "input": "cat, i\u0307",
              "normalized": "cat, i\u0307",
              "comparisonKey": "cat, i\u0307"
            }
          ]
        },
        {
          "id": "greek-cyrillic-equivalence",
          "samples": [
            {
              "input": "\u041c\u041e\u0421\u041a\u0412\u0410, \u039f\u03a3",
              "normalized": "\u041c\u041e\u0421\u041a\u0412\u0410, \u039f\u03a3",
              "comparisonKey": "\u043c\u043e\u0441\u043a\u0432\u0430, \u03bf\u03c3"
            },
            {
              "input": "\u043c\u043e\u0441\u043a\u0432\u0430, \u03bf\u03c3",
              "normalized": "\u043c\u043e\u0441\u043a\u0432\u0430, \u03bf\u03c3",
              "comparisonKey": "\u043c\u043e\u0441\u043a\u0432\u0430, \u03bf\u03c3"
            }
          ]
        }
      ]
    },
    {
      "id": "PV-SH-002",
      "kind": "search-history-document",
      "cases": [
        {
          "id": "latest-mutation-preserves-unknown",
          "initial": {
            "mode": "json",
            "document": {
              "version": 1,
              "entries": [" keep ", "KEEP", "other"],
              "updatedAtUtc": "2026-07-21T00:00:00.000Z",
              "ownerMarker": { "keep": true }
            }
          },
          "operations": [
            { "action": "commit", "query": "new" },
            { "action": "delete", "query": "other" }
          ],
          "expected": {
            "initialSupported": true,
            "initialMalformed": false,
            "initialFutureVersion": false,
            "finalSupported": true,
            "finalMalformed": false,
            "finalFutureVersion": false,
            "fileExists": true,
            "statuses": ["Succeeded", "Succeeded"],
            "entries": ["new", "keep"],
            "unknownRoot": { "ownerMarker": { "keep": true } },
            "bytesUnchanged": false
          }
        },
        {
          "id": "malformed-protected",
          "initial": {
            "mode": "raw",
            "text": "{\"version\":1,\"entries\":\"invalid\"}\n"
          },
          "operations": [
            { "action": "commit", "query": "must not publish" }
          ],
          "expected": {
            "initialSupported": false,
            "initialMalformed": true,
            "initialFutureVersion": false,
            "finalSupported": false,
            "finalMalformed": true,
            "finalFutureVersion": false,
            "fileExists": true,
            "statuses": ["Protected"],
            "entries": [],
            "unknownRoot": {},
            "bytesUnchanged": true
          }
        },
        {
          "id": "future-version-protected",
          "initial": {
            "mode": "json",
            "document": {
              "version": 2,
              "entries": [],
              "updatedAtUtc": "2026-07-21T00:00:00.000Z",
              "futureRoot": { "keep": true }
            }
          },
          "operations": [
            { "action": "clear" }
          ],
          "expected": {
            "initialSupported": false,
            "initialMalformed": false,
            "initialFutureVersion": true,
            "finalSupported": false,
            "finalMalformed": false,
            "finalFutureVersion": true,
            "fileExists": true,
            "statuses": ["Protected"],
            "entries": [],
            "unknownRoot": {},
            "bytesUnchanged": true
          }
        },
        {
          "id": "fifty-entry-mru-bound",
          "initial": { "mode": "missing" },
          "generatedCommits": {
            "prefix": "query-",
            "count": 52,
            "pad": 2
          },
          "expected": {
            "initialSupported": true,
            "initialMalformed": false,
            "initialFutureVersion": false,
            "finalSupported": true,
            "finalMalformed": false,
            "finalFutureVersion": false,
            "fileExists": true,
            "statuses": { "all": "Succeeded", "count": 52 },
            "entryWindow": { "count": 50, "first": "query-51", "last": "query-02" },
            "unknownRoot": {},
            "bytesUnchanged": false
          }
        }
      ]
    },
    {
      "id": "PV-ALB-001",
      "kind": "album-document",
      "cases": [
        {
          "id": "missing-is-empty-without-create",
          "initial": { "mode": "missing" },
          "operations": [],
          "expected": {
            "initialSupported": true,
            "initialExists": false,
            "initialMalformed": false,
            "initialFutureVersion": false,
            "initialRevision": 0,
            "initialAlbumCount": 0,
            "statuses": [],
            "finalRevision": 0,
            "finalAlbumCount": 0,
            "fileExists": false,
            "bytesUnchangedAfterRead": true,
            "bytesUnchangedAfterOperations": true,
            "unknownRoot": {}
          }
        },
        {
          "id": "versionless-empty-migrates-on-mutation",
          "initial": {
            "mode": "json",
            "document": {
              "albums": [],
              "futureRoot": { "keep": true }
            }
          },
          "operations": [
            {
              "action": "create",
              "name": "Migrated",
              "albumId": "legacy-upgraded",
              "expectedRevision": 0
            }
          ],
          "expected": {
            "initialSupported": true,
            "initialExists": true,
            "initialMalformed": false,
            "initialFutureVersion": false,
            "initialRevision": 0,
            "initialAlbumCount": 0,
            "statuses": ["Succeeded"],
            "finalRevision": 1,
            "finalAlbumCount": 1,
            "fileExists": true,
            "bytesUnchangedAfterRead": true,
            "bytesUnchangedAfterOperations": false,
            "unknownRoot": { "futureRoot": { "keep": true } }
          }
        },
        {
          "id": "ambiguous-versionless-protected",
          "initial": {
            "mode": "raw",
            "text": "{\"albums\":[{\"id\":\"broken\"}],\"ownerMarker\":{\"keep\":true}}\n"
          },
          "operations": [
            { "action": "create", "name": "Blocked", "albumId": "blocked" }
          ],
          "expected": {
            "initialSupported": false,
            "initialExists": true,
            "initialMalformed": true,
            "initialFutureVersion": false,
            "initialRevision": null,
            "initialAlbumCount": null,
            "statuses": ["Protected"],
            "finalRevision": null,
            "finalAlbumCount": null,
            "fileExists": true,
            "bytesUnchangedAfterRead": true,
            "bytesUnchangedAfterOperations": true,
            "unknownRoot": {}
          }
        },
        {
          "id": "future-version-protected",
          "initial": {
            "mode": "json",
            "document": {
              "version": 2,
              "revision": 9,
              "updatedAtUtc": "2026-07-21T00:00:00.000Z",
              "albums": [],
              "recentAlbumIds": [],
              "futureRoot": { "keep": true }
            }
          },
          "operations": [
            { "action": "create", "name": "Blocked", "albumId": "blocked" }
          ],
          "expected": {
            "initialSupported": false,
            "initialExists": true,
            "initialMalformed": false,
            "initialFutureVersion": true,
            "initialRevision": null,
            "initialAlbumCount": null,
            "statuses": ["Protected"],
            "finalRevision": null,
            "finalAlbumCount": null,
            "fileExists": true,
            "bytesUnchangedAfterRead": true,
            "bytesUnchangedAfterOperations": true,
            "unknownRoot": {}
          }
        }
      ]
    },
    {
      "id": "PV-ALB-002",
      "kind": "album-operations",
      "cases": [
        {
          "id": "revision-idempotency-conflict-and-cleanup",
          "initial": {
            "mode": "json",
            "document": {
              "version": 1,
              "revision": 5,
              "updatedAtUtc": "2026-07-21T00:00:00.000Z",
              "albums": [
                {
                  "id": "album-1",
                  "name": "Before",
                  "pinned": false,
                  "coverMemberId": "member-one",
                  "createdAtUtc": "2026-07-21T00:00:00.000Z",
                  "updatedAtUtc": "2026-07-21T00:00:00.000Z",
                  "revision": 1,
                  "members": [
                    {
                      "id": "member-one",
                      "imagePath": "${ROOT}/one.png",
                      "addedAtUtc": "2026-07-21T00:00:00.000Z"
                    },
                    {
                      "id": "member-retained",
                      "imagePath": "${ROOT}/retained.png",
                      "addedAtUtc": "2026-07-21T00:00:00.000Z",
                      "futureMember": { "keep": true }
                    }
                  ],
                  "futureAlbum": { "keep": true }
                }
              ],
              "recentAlbumIds": ["album-1"],
              "futureRoot": { "keep": true }
            }
          },
          "operations": [
            {
              "action": "add",
              "albumId": "album-1",
              "paths": ["${ROOT}/retained.png"],
              "expectedRevision": 5
            },
            {
              "action": "add",
              "albumId": "album-1",
              "paths": ["${ROOT}/added.png"],
              "expectedRevision": 5
            },
            {
              "action": "update",
              "albumId": "album-1",
              "name": "Must conflict",
              "expectedRevision": 5
            },
            {
              "action": "update",
              "albumId": "album-1",
              "name": "After",
              "pinned": true,
              "expectedRevision": 6
            },
            {
              "action": "cleanupPaths",
              "paths": ["${ROOT}/one.png"],
              "expectedRevision": 7
            },
            {
              "action": "cleanupPaths",
              "paths": ["${ROOT}/one.png"],
              "expectedRevision": 8
            }
          ],
          "expected": {
            "initialSupported": true,
            "initialExists": true,
            "initialMalformed": false,
            "initialFutureVersion": false,
            "initialRevision": 5,
            "initialAlbumCount": 1,
            "statuses": ["Succeeded", "Succeeded", "Conflict", "Succeeded", "Succeeded", "Succeeded"],
            "changed": [false, true, false, true, true, false],
            "revisions": [5, 6, 6, 7, 8, 8],
            "finalRevision": 8,
            "finalAlbumCount": 1,
            "fileExists": true,
            "bytesUnchangedAfterRead": true,
            "bytesUnchangedAfterOperations": false,
            "finalAlbum": {
              "id": "album-1",
              "name": "After",
              "pinned": true,
              "coverMemberId": null,
              "revision": 4,
              "memberPaths": ["${ROOT}/retained.png", "${ROOT}/added.png"]
            },
            "unknownRoot": { "futureRoot": { "keep": true } },
            "unknownAlbum": { "futureAlbum": { "keep": true } },
            "unknownMember": {
              "memberId": "member-retained",
              "fields": { "futureMember": { "keep": true } }
            }
          }
        }
      ]
    }
  ]
}
