{
  "schemaVersion": 1,
  "contractId": "PV-ENHANCE-VIDEO-001",
  "protocol": "aibos.enhancement-video/v1",
  "jobStoreVersion": 1,
  "operationEnvelope": {
    "acceptedValues": [
      "upscale",
      "photoreal",
      "video"
    ],
    "legacyMissingOperation": "upscale",
    "presentInvalidOrUnknownOperation": "reader-only unsupported row; never coerce, execute, retry, reorder, open, or delete as an image enhancement",
    "storeVersionChange": false
  },
  "videoSnapshot": {
    "mediaKind": "video",
    "field": "video",
    "requiredFields": [
      "presetId",
      "backendId",
      "requested.durationSeconds",
      "requested.playbackFps",
      "requested.prompt",
      "effective.frameCount",
      "effective.width",
      "effective.height",
      "effective.positivePrompt",
      "effective.negativePrompt",
      "seed",
      "codec",
      "bitDepth"
    ],
    "optionalAdditiveFields": [
      "delivery"
    ],
    "deliveryCompatibility": {
      "missing": "legacy v1 output uses requested.playbackFps and effective.frameCount as final playback metadata",
      "present": "must be the exact deliveryV1 shape and values for the requested duration",
      "malformedPresent": "reader-only protected row; never cancel, retry, reorder, open, or delete through a managed-video mutation path"
    },
    "unknownFields": "preserve when a compatible writer rewrites the row",
    "retry": "reuse the complete persisted snapshot and seed"
  },
  "sourceSelectionV1": {
    "requestField": "sourceProducerJobId",
    "absent": "use sourceId as the indexed Original source",
    "present": "the server resolves the id to one succeeded photoreal job; clients never provide its managed output path",
    "producerRequirements": [
      "operation is exactly photoreal",
      "status is succeeded and outputPath is present",
      "producer sourceId, sourcePath, and sourceSignature still match the current indexed Original",
      "output passes lexical and canonical managed-root ownership checks",
      "output is an existing supported still image"
    ],
    "persistedIdentity": "video sourceId remains the Original catalog identity; sourcePath, sourceSignature, and sourceSha256 identify the actual Original or photoreal input; sourceProducerJobId records photoreal provenance",
    "retry": "preserve sourceProducerJobId and revalidate the producer plus pinned source identity",
    "deletion": "do not delete a photoreal output while a queued or running video job depends on its producer id",
    "wpf": "the modal captures the currently displayed photoreal version; gallery context actions explicitly choose Original or latest photoreal"
  },
  "normalV1": {
    "presetId": "wan22-ti2v-5b-normal-v1",
    "backendId": "wan22-ti2v-5b-core-v1",
    "model": "wan2.2_ti2v_5B_fp16.safetensors",
    "nominalDurationSeconds": 6,
    "playbackFps": 16,
    "frameCount": 97,
    "maximumPixelArea": 409600,
    "alignment": 32,
    "steps": 20,
    "cfg": 5,
    "sampler": "uni_pc",
    "scheduler": "simple",
    "shift": 8,
    "denoise": 1,
    "seedRange": {
      "minimum": 0,
      "maximum": 2147483647,
      "fixedAtEnqueue": true
    },
    "codec": "h264",
    "container": "mp4",
    "bitDepth": 8,
    "timingMeaning": "playbackFps and frameCount describe Wan native generation; a legacy snapshot without delivery also uses them as final playback metadata",
    "blankPrompt": "built-in conservative anime idle motion with identity, line-art, composition, first-frame, and locked-camera preservation",
    "customPrompt": "preservation preamble plus the user's instruction; blank-only idle and locked-camera clauses must not contradict an explicit custom motion request"
  },
  "deliveryV1": {
    "field": "video.delivery",
    "additiveWithinProtocol": true,
    "backendId": "vs-rife-5.7.0-rife-4.25-v1",
    "model": "4.25",
    "targetFps": 30,
    "durationSeconds": [
      4,
      6
    ],
    "frameCountByDuration": {
      "4": 120,
      "6": 180
    },
    "pixelFormat": "yuv420p",
    "audio": false,
    "finalPlaybackMetadata": "valid delivery values replace native playbackFps and effective.frameCount in managed-video labels and playback metadata",
    "invalidPresentValue": "fail closed; presence is never treated as legacy absence"
  },
  "normalization": {
    "frameCount": "4 * floor(durationSeconds * playbackFps / 4) + 1",
    "resolution": [
      "A = 409600 and r = sourceWidth / sourceHeight",
      "w0 = sqrt(A * r) and h0 = sqrt(A / r)",
      "round both dimensions to the nearest multiple of 32",
      "while width * height exceeds A, reduce by 32 the dimension that produces the smaller source-aspect error",
      "after the over-budget loop, compare the current bucket with each valid adjacent candidate formed by reducing width or height by 32",
      "score each candidate as relativeAspectError + 0.25 * unusedAreaRatio, where relativeAspectError = abs((candidateWidth / candidateHeight) / r - 1) and unusedAreaRatio = (A - candidateWidth * candidateHeight) / A",
      "move to the lowest-score adjacent candidate only when its score strictly improves the current score, and repeat until neither adjacent candidate improves it",
      "prepare a separate contain-resized, edge-padded PNG at the exact bucket; never crop or rewrite the source"
    ],
    "examples": {
      "16:9": "832x480",
      "3:2": "768x512",
      "4:3": "736x544",
      "1:1": "640x640",
      "bird-975x1614": "480x800"
    },
    "refinementFixture": {
      "sourceWidth": 975,
      "sourceHeight": 1614,
      "maximumPixelArea": 409600,
      "expectedWidth": 480,
      "expectedHeight": 800
    }
  },
