    "flat": true,
    "extension": ".mp4",
    "identity": "job id, safe source name, source signature hash, and video preset hash",
    "sourceMutation": false,
    "staging": "a core SaveVideo staging file is allowed only as an exact adapter-owned transient and must be removed after success, cancel, or failure"
  },
  "readerFirst": {
    "canonicalAuthority": "a9ui/Aibos-Image",
    "wpfWriterEnabled": false,
    "h25WriterEnabled": false,
    "requirements": [
