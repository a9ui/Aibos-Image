<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <RootNamespace>PhotoViewer.Wpf</RootNamespace>
    <AssemblyName>PhotoViewer.Wpf</AssemblyName>
    <Product>Aibos Image</Product>
    <AssemblyTitle>Aibos</AssemblyTitle>
    <Description>Local-first Aibos Image WPF renderer</Description>
    <!-- Canonical product version. Keep this SemVer value in sync with each
         user-facing Aibos release; the title bar and binary metadata read it. -->
    <VersionPrefix>0.1.0</VersionPrefix>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Brand\Generated\Aibos.App.ico</ApplicationIcon>
    <!-- Published Aibos builds use the registered .NET 10 runtime directly.
         This prevents an unrelated stale DOTNET_ROOT from repeatedly invoking
         the runtime installer while keeping the portable package lightweight. -->
    <AppHostDotNetSearch>Global</AppHostDotNetSearch>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Brand\Generated\Aibos.App.ico" />
    <Resource Include="Brand\Generated\Aibos.Mark.20.png" />
    <Resource Include="Brand\Generated\Aibos.Mark.24.png" />
    <Resource Include="Brand\Generated\Aibos.Mark.64.png" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite.Core" Version="10.0.9" />
    <PackageReference Include="SQLitePCLRaw.bundle_winsqlite3" Version="2.1.11" />
  </ItemGroup>

</Project>
