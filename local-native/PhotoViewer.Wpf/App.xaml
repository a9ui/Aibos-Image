<Application x:Class="PhotoViewer.Wpf.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:PhotoViewer.Wpf">
  <Application.Resources>

    <!-- ═══════════ Design tokens (source of truth: browser globals.css) ═══════════ -->
    <Color x:Key="BgPrimaryColor">#FF080A0F</Color>
    <Color x:Key="BgSecondaryColor">#F20E121A</Color>
    <Color x:Key="BgTertiaryColor">#E6121721</Color>
    <Color x:Key="BgElevatedColor">#F2181D27</Color>
    <Color x:Key="AccentColor">#FF7A82FF</Color>
    <Color x:Key="AccentLightColor">#FF9AA0FF</Color>
    <Color x:Key="FavoriteColor">#FFFF4D73</Color>
    <Color x:Key="HeaderBgColor">#EB0B0F16</Color>
    <Color x:Key="TextPrimaryColor">#F2FFFFFF</Color>
    <Color x:Key="TextSecondaryColor">#B8C4CAD8</Color>
    <Color x:Key="TextTertiaryColor">#8FAAB3C4</Color>
    <Color x:Key="TextDisabledColor">#66FFFFFF</Color>
    <Color x:Key="SelectionTextColor">#FFFFFF</Color>
    <Color x:Key="FocusColor">#B7E4FF</Color>
    <Color x:Key="FavoriteTextColor">#FFFF4D73</Color>
    <Color x:Key="FavoriteThumbnailStatusBorderColor">#F4C45B</Color>
    <Color x:Key="EnhancedThumbnailStatusBorderColor">#38BDF8</Color>
    <Color x:Key="SuccessColor">#4DD4A3</Color>
    <Color x:Key="WarningColor">#F4C45B</Color>
    <Color x:Key="DangerColor">#FF687F</Color>
    <Color x:Key="DangerTextColor">#FFD7DE</Color>
    <Color x:Key="GlassBorderColor">#24FFFFFF</Color>
    <Color x:Key="GlassBorderHoverColor">#3DFFFFFF</Color>
    <Color x:Key="BorderStrongColor">#52FFFFFF</Color>
    <Color x:Key="HoverFillColor">#14FFFFFF</Color>
    <Color x:Key="PressedFillColor">#24FFFFFF</Color>
    <Color x:Key="SoftFillColor">#12FFFFFF</Color>
    <Color x:Key="AccentSoftColor">#267A82FF</Color>
    <Color x:Key="AccentGlassColor">#207A82FF</Color>
    <Color x:Key="FavoriteSoftColor">#2AFF4D73</Color>
    <Color x:Key="SuccessSoftColor">#173128</Color>
    <Color x:Key="SuccessBorderColor">#356D5B</Color>
    <Color x:Key="LogoColor">#7B83FF</Color>
    <Color x:Key="FavStepColor">#4E57CF</Color>

    <!-- Lightweight opaque workbench tokens: square, quiet, and fast. -->
    <SolidColorBrush x:Key="BgPrimary" Color="{DynamicResource BgPrimaryColor}"/>
    <SolidColorBrush x:Key="BgSecondary" Color="{DynamicResource BgSecondaryColor}"/>
    <SolidColorBrush x:Key="BgTertiary" Color="{DynamicResource BgTertiaryColor}"/>
    <SolidColorBrush x:Key="BgElevated" Color="{DynamicResource BgElevatedColor}"/>
    <SolidColorBrush x:Key="HeaderBg" Color="{DynamicResource HeaderBgColor}"/>
    <SolidColorBrush x:Key="TextPrimary" Color="{DynamicResource TextPrimaryColor}"/>
    <SolidColorBrush x:Key="TextSecondary" Color="{DynamicResource TextSecondaryColor}"/>
    <SolidColorBrush x:Key="TextTertiary" Color="{DynamicResource TextTertiaryColor}"/>
    <SolidColorBrush x:Key="TextDisabled" Color="{DynamicResource TextDisabledColor}"/>
    <SolidColorBrush x:Key="SelectionText" Color="{DynamicResource SelectionTextColor}"/>
    <SolidColorBrush x:Key="Accent" Color="{DynamicResource AccentColor}"/>
    <SolidColorBrush x:Key="AccentLight" Color="{DynamicResource AccentLightColor}"/>
    <SolidColorBrush x:Key="Focus" Color="{DynamicResource FocusColor}"/>
    <SolidColorBrush x:Key="Favorite" Color="{DynamicResource FavoriteColor}"/>
    <SolidColorBrush x:Key="FavoriteText" Color="{DynamicResource FavoriteTextColor}"/>
    <SolidColorBrush x:Key="FavoriteThumbnailStatusBorderBrush" Color="{DynamicResource FavoriteThumbnailStatusBorderColor}"/>
    <SolidColorBrush x:Key="EnhancedThumbnailStatusBorderBrush" Color="{DynamicResource EnhancedThumbnailStatusBorderColor}"/>
    <SolidColorBrush x:Key="Success" Color="{DynamicResource SuccessColor}"/>
    <SolidColorBrush x:Key="Warning" Color="{DynamicResource WarningColor}"/>
    <SolidColorBrush x:Key="Danger" Color="{DynamicResource DangerColor}"/>
    <SolidColorBrush x:Key="DangerText" Color="{DynamicResource DangerTextColor}"/>
    <SolidColorBrush x:Key="GlassBorder" Color="{DynamicResource GlassBorderColor}"/>
    <SolidColorBrush x:Key="GlassBorderHover" Color="{DynamicResource GlassBorderHoverColor}"/>
    <SolidColorBrush x:Key="BorderStrong" Color="{DynamicResource BorderStrongColor}"/>
    <SolidColorBrush x:Key="HoverFill" Color="{DynamicResource HoverFillColor}"/>
    <SolidColorBrush x:Key="PressedFill" Color="{DynamicResource PressedFillColor}"/>
    <SolidColorBrush x:Key="SoftFill" Color="{DynamicResource SoftFillColor}"/>
    <SolidColorBrush x:Key="AccentSoft" Color="{DynamicResource AccentSoftColor}"/>
    <SolidColorBrush x:Key="AccentGlass" Color="{DynamicResource AccentGlassColor}"/>
    <SolidColorBrush x:Key="FavoriteSoft" Color="{DynamicResource FavoriteSoftColor}"/>
    <SolidColorBrush x:Key="SuccessSoft" Color="{DynamicResource SuccessSoftColor}"/>
    <SolidColorBrush x:Key="SuccessBorder" Color="{DynamicResource SuccessBorderColor}"/>

    <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas, monospace</FontFamily>

    <SolidColorBrush x:Key="LogoBrush" Color="{DynamicResource LogoColor}"/>
    <SolidColorBrush x:Key="FavStepGradient" Color="{DynamicResource FavStepColor}"/>

    <!-- ═══════════ Converters ═══════════ -->
    <local:MultiplyConverter x:Key="Multiply"/>
    <local:CountToVisibilityConverter x:Key="CountToVis"/>
    <local:BoolToVisibilityConverter x:Key="BoolToVis"/>

    <!-- ═══════════ Base text ═══════════ -->
    <Style TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
      <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
      <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
    </Style>

    <Style TargetType="ToolTip">
      <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
      <Setter Property="Background" Value="{StaticResource BgElevated}"/>
      <Setter Property="BorderBrush" Value="{StaticResource GlassBorderHover}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="8,4"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="HasDropShadow" Value="False"/>
      <Setter Property="MaxWidth" Value="420"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ToolTip">
            <Border CornerRadius="4" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
              <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}" TextElement.FontSize="{TemplateBinding FontSize}"/>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="Content" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></Trigger>
        <Trigger Property="Content" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger>
      </Style.Triggers>
    </Style>

    <Style TargetType="ContextMenu">
      <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
      <Setter Property="Background" Value="{StaticResource BgElevated}"/>
      <Setter Property="BorderBrush" Value="{StaticResource GlassBorderHover}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="4"/>
      <Setter Property="HasDropShadow" Value="False"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ContextMenu">
            <Border CornerRadius="4" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
              <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle"/>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="MenuItem">
      <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Padding" Value="10,6"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="MenuItem">
            <Border x:Name="bd" CornerRadius="3" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
              <ContentPresenter ContentSource="Header" RecognizesAccessKey="True"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsHighlighted" Value="True">
                <Setter TargetName="bd" Property="Background" Value="{StaticResource HoverFill}"/>
                <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="Separator">
      <Setter Property="Margin" Value="6,4"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Separator">
            <Border Height="1" Background="{StaticResource GlassBorder}"/>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="CommonButtonFocusVisual" TargetType="Control">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Control">
            <Border Margin="-2" CornerRadius="4" BorderBrush="{StaticResource Focus}" BorderThickness="2" IsHitTestVisible="False"/>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="CommonButtonBase" TargetType="Button">
      <Setter Property="FocusVisualStyle" Value="{StaticResource CommonButtonFocusVisual}"/>
    </Style>

    <Style TargetType="Button" BasedOn="{StaticResource CommonButtonBase}"/>

    <Style x:Key="SectionHeader" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource TextTertiary}"/>
      <Setter Property="FontSize" Value="10.5"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="TextOptions.TextFormattingMode" Value="Ideal"/>
    </Style>

    <!-- ═══════════ Icon button (36x36) ═══════════ -->
    <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource CommonButtonBase}">
      <Setter Property="Width" Value="32"/>
      <Setter Property="Height" Value="32"/>
      <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bd" CornerRadius="4" Background="Transparent" BorderBrush="Transparent" BorderThickness="1">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}"/>
            </Border>
            <ControlTemplate.Triggers>
              <MultiTrigger>
                <MultiTrigger.Conditions><Condition Property="IsMouseOver" Value="True"/><Condition Property="IsEnabled" Value="True"/></MultiTrigger.Conditions>
                <Setter TargetName="bd" Property="Background" Value="{StaticResource HoverFill}"/>
                <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
              </MultiTrigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.4"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="bd" Property="Background" Value="{StaticResource PressedFill}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="IconButtonActive" TargetType="Button" BasedOn="{StaticResource IconButton}">
      <Setter Property="Foreground" Value="{StaticResource AccentLight}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bd" CornerRadius="4" Background="{StaticResource AccentSoft}" BorderBrush="{StaticResource Accent}" BorderThickness="1">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}"/>
            </Border>
            <ControlTemplate.Triggers>
              <MultiTrigger>
                <MultiTrigger.Conditions><Condition Property="IsMouseOver" Value="True"/><Condition Property="IsEnabled" Value="True"/></MultiTrigger.Conditions>
                <Setter TargetName="bd" Property="Background" Value="{StaticResource AccentGlass}"/>
              </MultiTrigger>
              <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Full-height modal edge zones: tint the edge and brighten the chevron without circular chrome. -->
    <Style x:Key="ModalEdgeButton" TargetType="Button" BasedOn="{StaticResource CommonButtonBase}">
      <Setter Property="Foreground" Value="{StaticResource TextDisabled}"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="edgeTint" Background="{TemplateBinding Background}">
              <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
            </Border>
            <ControlTemplate.Triggers>
              <MultiTrigger>
                <MultiTrigger.Conditions><Condition Property="IsMouseOver" Value="True"/><Condition Property="IsEnabled" Value="True"/></MultiTrigger.Conditions>
                <Setter TargetName="edgeTint" Property="Background" Value="{StaticResource HoverFill}"/>
                <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
              </MultiTrigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="edgeTint" Property="Background" Value="{StaticResource AccentSoft}"/>
                <Setter Property="Foreground" Value="{StaticResource AccentLight}"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.35"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ═══════════ Window caption buttons ═══════════ -->
    <Style x:Key="CaptionButton" TargetType="Button" BasedOn="{StaticResource CommonButtonBase}">
      <Setter Property="Width" Value="40"/>
      <Setter Property="Height" Value="32"/>
      <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bd" CornerRadius="3" Background="Transparent">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <MultiTrigger>
                <MultiTrigger.Conditions><Condition Property="IsMouseOver" Value="True"/><Condition Property="IsEnabled" Value="True"/></MultiTrigger.Conditions>
                <Setter TargetName="bd" Property="Background" Value="{StaticResource HoverFill}"/>
                <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
              </MultiTrigger>
              <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="CloseButton" TargetType="Button" BasedOn="{StaticResource CaptionButton}">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bd" CornerRadius="3" Background="Transparent">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <MultiTrigger>
                <MultiTrigger.Conditions><Condition Property="IsMouseOver" Value="True"/><Condition Property="IsEnabled" Value="True"/></MultiTrigger.Conditions>
                <Setter TargetName="bd" Property="Background" Value="{StaticResource Danger}"/>
                <Setter Property="Foreground" Value="{StaticResource SelectionText}"/>
              </MultiTrigger>
              <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ═══════════ Pill button ═══════════ -->
    <Style x:Key="Pill" TargetType="ToggleButton">
      <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ToggleButton">
            <Border x:Name="bd" CornerRadius="4" Padding="7,3"
                    Background="{StaticResource BgTertiary}"
                    BorderBrush="{StaticResource GlassBorder}" BorderThickness="1">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <MultiTrigger>
                <MultiTrigger.Conditions><Condition Property="IsMouseOver" Value="True"/><Condition Property="IsEnabled" Value="True"/></MultiTrigger.Conditions>
                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource GlassBorderHover}"/>
                <Setter TargetName="bd" Property="Background" Value="{StaticResource BgElevated}"/>
                <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
              </MultiTrigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="bd" Property="Background" Value="{StaticResource AccentSoft}"/>
                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Accent}"/>
                <Setter Property="Foreground" Value="{StaticResource AccentLight}"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ═══════════ Sidebar link ═══════════ -->
    <Style x:Key="SidebarLink" TargetType="Button" BasedOn="{StaticResource CommonButtonBase}">
      <Setter Property="Foreground" Value="{StaticResource AccentLight}"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FontSize" Value="12.5"/>
      <Setter Property="HorizontalAlignment" Value="Left"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <ContentPresenter/>
            <ControlTemplate.Triggers>
              <MultiTrigger>
                <MultiTrigger.Conditions><Condition Property="IsMouseOver" Value="True"/><Condition Property="IsEnabled" Value="True"/></MultiTrigger.Conditions>
                <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
              </MultiTrigger>
              <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Transparent text actions still expose a clear pointer-hover and keyboard-focus state. -->
    <Style x:Key="TransparentButton" TargetType="Button" BasedOn="{StaticResource CommonButtonBase}">
      <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bd" CornerRadius="4" Padding="{TemplateBinding Padding}"
                    Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
              <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
            </Border>
            <ControlTemplate.Triggers>
              <MultiTrigger>
                <MultiTrigger.Conditions><Condition Property="IsMouseOver" Value="True"/><Condition Property="IsEnabled" Value="True"/></MultiTrigger.Conditions>
                <Setter TargetName="bd" Property="Background" Value="{StaticResource HoverFill}"/>
                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource GlassBorderHover}"/>
                <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
              </MultiTrigger>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource AccentLight}"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/><Setter Property="Cursor" Value="Arrow"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ═══════════ Segmented control (RadioButton) ═══════════ -->
    <Style x:Key="Seg" TargetType="RadioButton">
      <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="bd" CornerRadius="3" Padding="8,4" Background="Transparent">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <MultiTrigger>
                <MultiTrigger.Conditions><Condition Property="IsMouseOver" Value="True"/><Condition Property="IsEnabled" Value="True"/></MultiTrigger.Conditions>
                <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
              </MultiTrigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="bd" Property="Background" Value="{StaticResource Accent}"/>
                <Setter Property="Foreground" Value="{StaticResource SelectionText}"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="SettingsNavItem" TargetType="RadioButton">
      <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Height" Value="32"/>
      <Setter Property="Margin" Value="0,1"/>
      <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="bd" CornerRadius="3" Padding="10,0" Background="Transparent" BorderBrush="Transparent" BorderThickness="2,0,0,0">
              <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <MultiTrigger>
                <MultiTrigger.Conditions><Condition Property="IsMouseOver" Value="True"/><Condition Property="IsEnabled" Value="True"/></MultiTrigger.Conditions>
                <Setter TargetName="bd" Property="Background" Value="{StaticResource HoverFill}"/>
                <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
              </MultiTrigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="bd" Property="Background" Value="{StaticResource AccentSoft}"/>
                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Accent}"/>
                <Setter Property="Foreground" Value="{StaticResource AccentLight}"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ═══════════ Ghost / danger action buttons ═══════════ -->
    <Style x:Key="GhostButton" TargetType="Button" BasedOn="{StaticResource CommonButtonBase}">
      <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Height" Value="32"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bd" CornerRadius="4" Padding="10,0"
                    Background="{StaticResource SoftFill}"
                    BorderBrush="{StaticResource GlassBorder}" BorderThickness="1">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <MultiTrigger>
                <MultiTrigger.Conditions><Condition Property="IsMouseOver" Value="True"/><Condition Property="IsEnabled" Value="True"/></MultiTrigger.Conditions>
                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource GlassBorderHover}"/>
                <Setter TargetName="bd" Property="Background" Value="{StaticResource HoverFill}"/>
                <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
              </MultiTrigger>
              <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bd" CornerRadius="4" Padding="10,0"
                    Background="{StaticResource SoftFill}"
                    BorderBrush="{StaticResource GlassBorder}" BorderThickness="1">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <MultiTrigger>
                <MultiTrigger.Conditions><Condition Property="IsMouseOver" Value="True"/><Condition Property="IsEnabled" Value="True"/></MultiTrigger.Conditions>
                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Danger}"/>
                <Setter TargetName="bd" Property="Background" Value="{StaticResource FavoriteSoft}"/>
                <Setter Property="Foreground" Value="{StaticResource DangerText}"/>
              </MultiTrigger>
              <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ═══════════ Search TextBox ═══════════ -->
    <Style x:Key="SearchBox" TargetType="TextBox">
      <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
      <Setter Property="CaretBrush" Value="{StaticResource AccentLight}"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <ScrollViewer x:Name="PART_ContentHost"/>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Dark date input: keep the sidebar controls inside the viewer surface. -->
    <Style x:Key="DarkDatePicker" TargetType="DatePicker">
      <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
      <Setter Property="Background" Value="{StaticResource BgTertiary}"/>
      <Setter Property="BorderBrush" Value="{StaticResource GlassBorder}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="FontSize" Value="11.5"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="DatePicker">
            <Grid>
              <Border x:Name="InputBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="28"/>
                  </Grid.ColumnDefinitions>
                  <DatePickerTextBox x:Name="PART_TextBox" Grid.Column="0" Padding="7,0,3,0" Background="Transparent" BorderThickness="0" Foreground="{TemplateBinding Foreground}" CaretBrush="{StaticResource AccentLight}" VerticalContentAlignment="Center"/>
                  <Button x:Name="PART_Button" Grid.Column="1" Style="{StaticResource TransparentButton}" Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextSecondary}" Focusable="False" ToolTip="Open calendar">
                    <Path Data="M4,6 h16 v14 h-16 z M4,10 h16 M8,3 v6 M16,3 v6" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.35" Stretch="Uniform" Width="14" Height="14"/>
                  </Button>
                </Grid>
              </Border>
              <Popup x:Name="PART_Popup" Placement="Bottom" StaysOpen="False" AllowsTransparency="True">
                <Border Background="{StaticResource BgElevated}" BorderBrush="{StaticResource GlassBorderHover}" BorderThickness="1" CornerRadius="8" Padding="4" SnapsToDevicePixels="True">
                  <Calendar x:Name="PART_Calendar" Background="{StaticResource BgElevated}" Foreground="{StaticResource TextPrimary}" BorderBrush="{StaticResource GlassBorder}"/>
                </Border>
              </Popup>
            </Grid>
            <ControlTemplate.Triggers>
              <MultiTrigger>
                <MultiTrigger.Conditions><Condition Property="IsMouseOver" Value="True"/><Condition Property="IsEnabled" Value="True"/></MultiTrigger.Conditions>
                <Setter TargetName="InputBorder" Property="BorderBrush" Value="{StaticResource GlassBorderHover}"/>
                <Setter TargetName="InputBorder" Property="Background" Value="{StaticResource BgElevated}"/>
              </MultiTrigger>
              <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Setter TargetName="InputBorder" Property="BorderBrush" Value="{StaticResource AccentLight}"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="InputBorder" Property="Opacity" Value="0.42"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Resources>
        <Style TargetType="DatePickerTextBox">
          <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
          <Setter Property="CaretBrush" Value="{StaticResource AccentLight}"/>
          <Setter Property="Background" Value="Transparent"/>
          <Setter Property="BorderThickness" Value="0"/>
          <Setter Property="Template">
            <Setter.Value>
              <ControlTemplate TargetType="DatePickerTextBox">
                <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                  <ScrollViewer x:Name="PART_ContentHost" VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"/>
                </Border>
              </ControlTemplate>
            </Setter.Value>
          </Setter>
        </Style>
        <Style TargetType="CalendarDayButton">
          <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
          <Setter Property="Background" Value="Transparent"/>
          <Setter Property="BorderBrush" Value="Transparent"/>
          <Setter Property="Template">
            <Setter.Value>
              <ControlTemplate TargetType="CalendarDayButton">
                <Border x:Name="Day" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="4" Margin="1">
                  <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <ControlTemplate.Triggers>
                  <MultiTrigger><MultiTrigger.Conditions><Condition Property="IsMouseOver" Value="True"/><Condition Property="IsEnabled" Value="True"/></MultiTrigger.Conditions><Setter TargetName="Day" Property="Background" Value="{StaticResource HoverFill}"/></MultiTrigger>
                  <Trigger Property="IsSelected" Value="True"><Setter TargetName="Day" Property="Background" Value="{StaticResource Accent}"/><Setter Property="Foreground" Value="White"/></Trigger>
                  <Trigger Property="IsToday" Value="True"><Setter TargetName="Day" Property="BorderBrush" Value="{StaticResource AccentLight}"/></Trigger>
                  <Trigger Property="IsInactive" Value="True"><Setter Property="Foreground" Value="{StaticResource TextTertiary}"/></Trigger>
                  <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.38"/></Trigger>
                </ControlTemplate.Triggers>
              </ControlTemplate>
            </Setter.Value>
          </Setter>
        </Style>
        <Style TargetType="CalendarButton">
          <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
          <Setter Property="Background" Value="Transparent"/>
          <Setter Property="BorderBrush" Value="Transparent"/>
          <Setter Property="Template">
            <Setter.Value>
              <ControlTemplate TargetType="CalendarButton">
                <Border x:Name="CalendarButtonBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="4" Margin="1">
                  <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <ControlTemplate.Triggers>
                  <MultiTrigger><MultiTrigger.Conditions><Condition Property="IsMouseOver" Value="True"/><Condition Property="IsEnabled" Value="True"/></MultiTrigger.Conditions><Setter TargetName="CalendarButtonBorder" Property="Background" Value="{StaticResource HoverFill}"/></MultiTrigger>
                  <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.38"/></Trigger>
                </ControlTemplate.Triggers>
              </ControlTemplate>
            </Setter.Value>
          </Setter>
        </Style>
      </Style.Resources>
    </Style>

    <!-- ═══════════ Favorite stepper buttons ═══════════ -->
    <Style x:Key="StepButton" TargetType="Button" BasedOn="{StaticResource CommonButtonBase}">
      <Setter Property="Foreground" Value="{StaticResource FavoriteText}"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Width" Value="30"/>
      <Setter Property="Height" Value="34"/>
      <Setter Property="FontSize" Value="15"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bd" Background="{StaticResource FavoriteSoft}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <MultiTrigger>
                <MultiTrigger.Conditions><Condition Property="IsMouseOver" Value="True"/><Condition Property="IsEnabled" Value="True"/></MultiTrigger.Conditions>
                <Setter TargetName="bd" Property="Background" Value="{StaticResource AccentSoft}"/>
              </MultiTrigger>
              <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ═══════════ Image card (ListBoxItem) ═══════════ -->
    <Style x:Key="CompactCardFavoriteButton" TargetType="Button" BasedOn="{StaticResource CommonButtonBase}">
      <Setter Property="Foreground" Value="{StaticResource SelectionText}"/>
      <Setter Property="Background" Value="#B8000000"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="FontSize" Value="9"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="compactFavoriteButtonBackground" Background="{TemplateBinding Background}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <MultiTrigger>
                <MultiTrigger.Conditions>
                  <Condition Property="IsMouseOver" Value="True"/>
                  <Condition Property="IsEnabled" Value="True"/>
                </MultiTrigger.Conditions>
                <Setter TargetName="compactFavoriteButtonBackground" Property="Background" Value="#E0F43F5E"/>
              </MultiTrigger>
              <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <ControlTemplate x:Key="CompactCardItemTemplate" TargetType="ListBoxItem">
      <Border x:Name="compactRing" Width="{Binding CardWidth}" Height="{Binding CardHeight}"
              Background="{StaticResource BgTertiary}" BorderBrush="Transparent" BorderThickness="0"
              CornerRadius="3" ClipToBounds="True">
        <Grid>
          <Image Source="{Binding Thumbnail}" Stretch="{Binding CardThumbnailStretch}" RenderOptions.BitmapScalingMode="LowQuality"/>
          <Border CornerRadius="3" BorderBrush="{DynamicResource EnhancedThumbnailStatusBorderBrush}" BorderThickness="2"
                  IsHitTestVisible="False" Visibility="{Binding Enhanced, Converter={StaticResource BoolToVis}}"/>
          <Border CornerRadius="2" Margin="2" BorderBrush="{DynamicResource FavoriteThumbnailStatusBorderBrush}" BorderThickness="2"
                  IsHitTestVisible="False" Visibility="{Binding Fav, Converter={StaticResource CountToVis}}"/>
          <Grid x:Name="compactFavoriteControls" VerticalAlignment="Bottom"
                Height="{Binding CompactFavoriteControlHeight}" Opacity="0" IsHitTestVisible="False">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Button Grid.Column="0" Style="{StaticResource CompactCardFavoriteButton}" Content="-"
                    CommandParameter="decrease" Tag="{Binding}" ToolTip="Decrease favorite level"
                    AutomationProperties.Name="{Binding FileName, StringFormat={}Decrease favorite level for {0}}"/>
            <Button Grid.Column="1" Style="{StaticResource CompactCardFavoriteButton}" Content="+"
                    CommandParameter="increase" Tag="{Binding}" ToolTip="Increase favorite level"
                    AutomationProperties.Name="{Binding FileName, StringFormat={}Increase favorite level for {0}}"/>
          </Grid>
        </Grid>
      </Border>
      <ControlTemplate.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter TargetName="compactFavoriteControls" Property="Opacity" Value="1"/>
          <Setter TargetName="compactFavoriteControls" Property="IsHitTestVisible" Value="True"/>
        </Trigger>
        <Trigger Property="IsSelected" Value="True">
          <Setter TargetName="compactRing" Property="BorderBrush" Value="{StaticResource AccentLight}"/>
          <Setter TargetName="compactRing" Property="BorderThickness" Value="2"/>
        </Trigger>
        <DataTrigger Binding="{Binding IsCanonicalSelected}" Value="True">
          <Setter TargetName="compactRing" Property="BorderBrush" Value="{StaticResource AccentLight}"/>
          <Setter TargetName="compactRing" Property="BorderThickness" Value="2"/>
        </DataTrigger>
      </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style x:Key="CardItem" TargetType="ListBoxItem">
      <Setter Property="Margin" Value="0,0,14,14"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Border x:Name="ring" CornerRadius="5" Padding="2" Background="Transparent"
                    RenderTransformOrigin="0.5,0.5">
              <Grid>
                <Border CornerRadius="4" ClipToBounds="True" Background="{StaticResource BgSecondary}"
                        Width="{Binding CardWidth}" Height="{Binding CardHeight}">
                  <Grid>
                    <Rectangle Fill="{StaticResource BgTertiary}"/>
                    <Image Source="{Binding Thumbnail}" Stretch="{Binding CardThumbnailStretch}" RenderOptions.BitmapScalingMode="HighQuality"/>

                    <!-- unseen dot -->
                    <Ellipse Width="8" Height="8" Margin="8" HorizontalAlignment="Left" VerticalAlignment="Top"
                             Fill="{StaticResource AccentLight}"
                             Visibility="{Binding ShowUnseenDotOnCard, Converter={StaticResource BoolToVis}}"/>

                    <!-- Browser-parity direct Favorite controls. Routed Click is handled by the owning gallery. -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="2">
                      <Button Style="{StaticResource IconButton}" Width="{Binding CardFavoriteButtonSize}" Height="{Binding CardFavoriteButtonSize}"
                              CommandParameter="decrease" Tag="{Binding}" Margin="0,0,2,0" Visibility="{Binding ShowFavoriteBadge, Converter={StaticResource BoolToVis}}"
                              ToolTip="Decrease favorite level" AutomationProperties.Name="{Binding FileName, StringFormat={}Decrease favorite level for {0}}">
                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xEB51;" Foreground="{StaticResource Favorite}" FontSize="14"/>
                      </Button>
                      <Button Style="{StaticResource IconButton}" Width="{Binding CardFavoriteButtonSize}" Height="{Binding CardFavoriteButtonSize}"
                              CommandParameter="increase" Tag="{Binding}" ToolTip="Increase favorite level"
                              AutomationProperties.Name="{Binding FileName, StringFormat={}Increase favorite level for {0}}">
                        <StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe MDL2 Assets" Text="{Binding FavoriteGlyph}" Foreground="{StaticResource Favorite}" FontSize="14"/><TextBlock Text="{Binding Fav}" Foreground="{StaticResource Favorite}" FontSize="10" FontWeight="SemiBold" Margin="3,0,0,0" Visibility="{Binding ShowFavoriteBadge, Converter={StaticResource BoolToVis}}"/></StackPanel>
                      </Button>
                    </StackPanel>

                    <!-- Stable concise identity: filename and dimensions stay
                         readable without adding prompt text or changing card geometry. -->
                    <Border x:Name="overlay" VerticalAlignment="Bottom" Height="58" Opacity="1" Padding="10,0,10,8" Visibility="{Binding ShowCardDetails, Converter={StaticResource BoolToVis}}">
                      <Border.Background>
                        <LinearGradientBrush StartPoint="0,1" EndPoint="0,0">
                          <GradientStop Color="#D0000000" Offset="0"/>
                          <GradientStop Color="#00000000" Offset="1"/>
                        </LinearGradientBrush>
                      </Border.Background>
                      <StackPanel VerticalAlignment="Bottom">
                        <TextBlock Text="{Binding FileName}" Foreground="#F2FFFFFF"
                                   FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding SizeText}" Foreground="{StaticResource TextTertiary}"
                                   FontSize="10.5" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                      </StackPanel>
                    </Border>

                    <!-- Status borders stay above hover chrome and bind to the tile's existing O(1) state. -->
                    <Border CornerRadius="3" BorderBrush="{DynamicResource EnhancedThumbnailStatusBorderBrush}" BorderThickness="2"
                            IsHitTestVisible="False" Visibility="{Binding Enhanced, Converter={StaticResource BoolToVis}}"/>
                    <Border CornerRadius="2" Margin="4" BorderBrush="{DynamicResource FavoriteThumbnailStatusBorderBrush}" BorderThickness="2"
                            IsHitTestVisible="False" Visibility="{Binding Fav, Converter={StaticResource CountToVis}}"/>
                    <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="5" Padding="4,1" CornerRadius="4"
                            Background="#D9142630" BorderBrush="#FF38BDF8" BorderThickness="1"
                            IsHitTestVisible="False" Visibility="{Binding ShowEnhancedBadge, Converter={StaticResource BoolToVis}}">
                      <TextBlock Text="AI" Foreground="#FFBAE6FD" FontSize="9" FontWeight="SemiBold"/>
                    </Border>
                  </Grid>
                </Border>
              </Grid>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="overlay" Property="Opacity" Value="1"/>
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="ring" Property="Background" Value="{StaticResource AccentLight}"/>
                <Setter TargetName="overlay" Property="Opacity" Value="1"/>
              </Trigger>
              <DataTrigger Binding="{Binding IsCanonicalSelected}" Value="True">
                <Setter TargetName="ring" Property="Background" Value="{StaticResource AccentLight}"/>
                <Setter TargetName="overlay" Property="Opacity" Value="1"/>
              </DataTrigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <DataTrigger Binding="{Binding UseCompactCardTemplate}" Value="True">
          <Setter Property="Template" Value="{StaticResource CompactCardItemTemplate}"/>
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <!-- ═══════════ List-view row ═══════════ -->
    <Style x:Key="ListRowItem" TargetType="ListBoxItem">
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Border x:Name="bd" Padding="14,8" Background="Transparent" BorderBrush="Transparent" BorderThickness="2,0,0,0">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Width="{Binding ListThumbnailWidth}" Height="{Binding ListThumbnailHeight}" CornerRadius="7" ClipToBounds="True" Margin="0,0,12,0">
                  <Grid>
                    <Rectangle Fill="{StaticResource BgTertiary}"/>
                    <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <Border CornerRadius="6" BorderBrush="{DynamicResource EnhancedThumbnailStatusBorderBrush}" BorderThickness="2"
                            IsHitTestVisible="False" Visibility="{Binding Enhanced, Converter={StaticResource BoolToVis}}"/>
                    <Border CornerRadius="4" Margin="4" BorderBrush="{DynamicResource FavoriteThumbnailStatusBorderBrush}" BorderThickness="2"
                            IsHitTestVisible="False" Visibility="{Binding Fav, Converter={StaticResource CountToVis}}"/>
                    <Ellipse Width="8" Height="8" Margin="7" HorizontalAlignment="Left" VerticalAlignment="Top" Fill="{StaticResource AccentLight}" Visibility="{Binding ShowUnseenDot, Converter={StaticResource BoolToVis}}"/>
                  </Grid>
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                  <TextBlock Text="{Binding FileName}" Foreground="{StaticResource TextPrimary}" FontSize="13" FontWeight="Medium" TextTrimming="CharacterEllipsis"/>
                  <TextBlock Text="{Binding Path}" Foreground="{StaticResource TextTertiary}" FontSize="10.5" FontFamily="{StaticResource MonoFont}" TextTrimming="CharacterEllipsis" Margin="0,1,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                  <Button Style="{StaticResource IconButton}" Width="28" Height="28" CommandParameter="decrease" Tag="{Binding}"
                          ToolTip="Decrease favorite level" AutomationProperties.Name="{Binding FileName, StringFormat={}Decrease favorite level for {0}}">
                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xEB51;" Foreground="{StaticResource Favorite}" FontSize="14"/>
                  </Button>
                  <Button Style="{StaticResource IconButton}" MinWidth="34" Width="Auto" Height="28" Padding="5,0" CommandParameter="increase" Tag="{Binding}"
                          ToolTip="Increase favorite level" AutomationProperties.Name="{Binding FileName, StringFormat={}Increase favorite level for {0}}">
                    <StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe MDL2 Assets" Text="{Binding FavoriteGlyph}" Foreground="{StaticResource Favorite}" FontSize="14"/><TextBlock Text="{Binding Fav}" Foreground="{StaticResource Favorite}" FontSize="10" FontWeight="SemiBold" Margin="3,0,0,0"/></StackPanel>
                  </Button>
                </StackPanel>
              </Grid>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="Background" Value="#08FFFFFF"/>
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="bd" Property="Background" Value="{StaticResource AccentSoft}"/>
                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Accent}"/>
              </Trigger>
              <DataTrigger Binding="{Binding IsCanonicalSelected}" Value="True">
                <Setter TargetName="bd" Property="Background" Value="{StaticResource AccentSoft}"/>
                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Accent}"/>
              </DataTrigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ═══════════ Landing primary/browse buttons ═══════════ -->
    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource CommonButtonBase}">
      <Setter Property="Foreground" Value="{StaticResource SelectionText}"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Height" Value="40"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <ControlTemplate.Resources>
              <Style TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource SelectionText}"/></Style>
            </ControlTemplate.Resources>
            <Border x:Name="bd" CornerRadius="4" Padding="22,0" Background="{StaticResource Accent}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}"/>
            </Border>
            <ControlTemplate.Triggers>
              <MultiTrigger>
                <MultiTrigger.Conditions><Condition Property="IsMouseOver" Value="True"/><Condition Property="IsEnabled" Value="True"/></MultiTrigger.Conditions>
                <Setter TargetName="bd" Property="Background" Value="{StaticResource AccentLight}"/>
              </MultiTrigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.5"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="BrowseButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
      <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
      <Setter Property="FontWeight" Value="Medium"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bd" CornerRadius="4" Padding="18,0" Background="{StaticResource BgTertiary}" BorderBrush="{StaticResource GlassBorder}" BorderThickness="1">
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <ContentPresenter/>
              </StackPanel>
            </Border>
            <ControlTemplate.Triggers>
              <MultiTrigger>
                <MultiTrigger.Conditions><Condition Property="IsMouseOver" Value="True"/><Condition Property="IsEnabled" Value="True"/></MultiTrigger.Conditions>
                <Setter TargetName="bd" Property="Background" Value="{StaticResource BgElevated}"/>
                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource GlassBorderHover}"/>
                <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
              </MultiTrigger>
              <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="DangerFilled" TargetType="Button" BasedOn="{StaticResource CommonButtonBase}">
      <Setter Property="Foreground" Value="{StaticResource SelectionText}"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Height" Value="32"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <ControlTemplate.Resources>
              <Style TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource SelectionText}"/></Style>
            </ControlTemplate.Resources>
            <Border x:Name="bd" CornerRadius="4" Padding="14,0" Background="{StaticResource Danger}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}"/>
            </Border>
            <ControlTemplate.Triggers>
              <MultiTrigger>
                <MultiTrigger.Conditions><Condition Property="IsMouseOver" Value="True"/><Condition Property="IsEnabled" Value="True"/></MultiTrigger.Conditions>
                <Setter TargetName="bd" Property="Background" Value="#F87171"/>
              </MultiTrigger>
              <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ═══════════ Slim dark scrollbars ═══════════ -->
    <Style x:Key="ScrollThumb" TargetType="Thumb">
      <Setter Property="OverridesDefaultStyle" Value="True"/>
      <Setter Property="IsTabStop" Value="False"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Thumb">
            <Border x:Name="t" CornerRadius="4" Background="#22FFFFFF" Margin="2"/>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="t" Property="Background" Value="#3CFFFFFF"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="ScrollHidden" TargetType="RepeatButton">
      <Setter Property="OverridesDefaultStyle" Value="True"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="IsTabStop" Value="False"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="ScrollBar">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Width" Value="10"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ScrollBar">
            <Grid Background="Transparent">
              <Track x:Name="PART_Track" IsDirectionReversed="True">
                <Track.Thumb><Thumb Style="{StaticResource ScrollThumb}" MinHeight="28"/></Track.Thumb>
                <Track.IncreaseRepeatButton><RepeatButton Style="{StaticResource ScrollHidden}" Command="ScrollBar.PageDownCommand"/></Track.IncreaseRepeatButton>
                <Track.DecreaseRepeatButton><RepeatButton Style="{StaticResource ScrollHidden}" Command="ScrollBar.PageUpCommand"/></Track.DecreaseRepeatButton>
              </Track>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="Orientation" Value="Horizontal">
          <Setter Property="Width" Value="Auto"/>
          <Setter Property="Height" Value="10"/>
          <Setter Property="Template">
            <Setter.Value>
              <ControlTemplate TargetType="ScrollBar">
                <Grid Background="Transparent">
                  <Track x:Name="PART_Track">
                    <Track.Thumb><Thumb Style="{StaticResource ScrollThumb}" MinWidth="28"/></Track.Thumb>
                    <Track.IncreaseRepeatButton><RepeatButton Style="{StaticResource ScrollHidden}" Command="ScrollBar.PageRightCommand"/></Track.IncreaseRepeatButton>
                    <Track.DecreaseRepeatButton><RepeatButton Style="{StaticResource ScrollHidden}" Command="ScrollBar.PageLeftCommand"/></Track.DecreaseRepeatButton>
                  </Track>
                </Grid>
              </ControlTemplate>
            </Setter.Value>
          </Setter>
        </Trigger>
      </Style.Triggers>
    </Style>

  </Application.Resources>
</Application>
