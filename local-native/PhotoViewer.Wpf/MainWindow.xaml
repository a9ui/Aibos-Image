                  <CheckBox x:Name="EnhancementJobsCanceledFilter" Style="{StaticResource EnhancementJobsFilterPill}" Content="キャンセル" Tag="canceled" Click="EnhancementJobsStatusFilter_Click" ToolTip="キャンセル済みのJobだけを表示"/>
                </UniformGrid>
                <TextBlock Text="AI処理の種類" Foreground="{StaticResource TextSecondary}" FontSize="11" FontWeight="SemiBold" Margin="4,14,0,4"/>
                <UniformGrid x:Name="EnhancementJobsOperationFiltersPanel" Columns="1">
                  <CheckBox x:Name="EnhancementJobsAllOperationsFilter" Style="{StaticResource EnhancementJobsFilterPill}" Content="すべて" Tag="all" IsChecked="True" Click="EnhancementJobsOperationFilter_Click" ToolTip="すべてのAI処理を表示"/>
                  <CheckBox x:Name="EnhancementJobsUpscaleFilter" Style="{StaticResource EnhancementJobsFilterPill}" Content="高画質化" Tag="upscale" Click="EnhancementJobsOperationFilter_Click" ToolTip="高画質化Jobだけを表示"/>
