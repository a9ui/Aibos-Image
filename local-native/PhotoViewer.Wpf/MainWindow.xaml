          <ColumnDefinition x:Name="ModalPreviousZoneColumn" Width="5*"/>
          <ColumnDefinition x:Name="ModalCenterZoneColumn" Width="90*"/>
          <ColumnDefinition x:Name="ModalNextZoneColumn" Width="5*"/>
