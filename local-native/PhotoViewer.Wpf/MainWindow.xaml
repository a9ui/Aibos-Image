            <TextBlock Text="{DynamicResource UiViewerDropTitle}" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center"/>
            <TextBlock Text="{DynamicResource UiViewerDropHelp}" Foreground="{StaticResource TextSecondary}" FontSize="12.5" Margin="0,5,0,0" HorizontalAlignment="Center"/>
          </StackPanel>
        </Border>
       </Grid>
      </Border>

      <GridSplitter Grid.Row="0" Grid.Column="2" x:Name="RightPanelSplitter" Width="6" HorizontalAlignment="Stretch"
                    Background="Transparent" Focusable="True" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext"
                    KeyboardIncrement="20" ShowsPreview="True" PreviewKeyDown="RightPanelSplitter_PreviewKeyDown"
                    DragStarted="RightPanelSplitter_DragStarted" DragCompleted="RightPanelSplitter_DragCompleted"
                    ToolTip="Resize right preview panel" AutomationProperties.Name="Resize right preview panel"/>

      <!-- ─────── Right preview ─────── -->
