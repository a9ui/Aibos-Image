                          LoadedBehavior="Manual" UnloadedBehavior="Manual"
                          ScrubbingEnabled="True" IsHitTestVisible="False"
                          Loaded="ModalVideoEditV2Video_Loaded"
                          IsVisibleChanged="ModalVideoEditV2Video_IsVisibleChanged"
                          MediaOpened="ModalVideo_MediaOpened"
                          MediaEnded="ModalVideo_MediaEnded"
                          MediaFailed="ModalVideo_MediaFailed"
                          AutomationProperties.Name="Generated video playback"/>
          </Grid>
        </Border>

        <Button x:Name="ModalPreviousButton" Grid.Column="0" Width="Auto" Height="Auto" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Style="{StaticResource ModalEdgeButton}" ToolTip="Previous image (Left arrow)" Click="ModalPrevious_Click" AutomationProperties.Name="Previous image edge zone" AutomationProperties.HelpText="Navigate to the previous image. The sequence wraps at the first image.">
          <Path x:Name="ModalPreviousChevron" Data="M15,18 l-6,-6 l6,-6" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Stretch="Uniform" Width="18" Height="18"/>
        </Button>
        <Button x:Name="ModalNextButton" Grid.Column="2" Width="Auto" Height="Auto" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Style="{StaticResource ModalEdgeButton}" ToolTip="Next image (Right arrow)" Click="ModalNext_Click" AutomationProperties.Name="Next image edge zone" AutomationProperties.HelpText="Navigate to the next image. The sequence wraps at the first image.">
          <Path x:Name="ModalNextChevron" Data="M9,18 l6,-6 l-6,-6" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Stretch="Uniform" Width="18" Height="18"/>
        </Button>

