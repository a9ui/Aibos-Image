                <TextBlock Text="履歴の表示件数" Foreground="{StaticResource TextSecondary}" FontSize="11" FontWeight="SemiBold" Margin="4,14,0,4"/>
                <ComboBox x:Name="EnhancementJobsHistoryLimitComboBox"
