                  <RadioButton x:Name="ModalSettingsTabButton" Style="{StaticResource Seg}" GroupName="ModalMetadataTabs"
                               Content="Settings" Tag="settings" Click="ModalMetadataTab_Click"
                                AutomationProperties.Name="Generation settings metadata tab" AutomationProperties.HelpText="Show generation settings stored for the currently displayed image or video version."/>
                </UniformGrid>
              </Border>

