                      SelectionChanged="ModalVideoVersion_SelectionChanged"
                      AutomationProperties.Name="Generated video version"/>
            <TextBlock x:Name="ModalShortcutHintText" Text="   ← → navigate   ·   Esc close" Foreground="{StaticResource TextTertiary}" FontSize="11" VerticalAlignment="Center" Margin="6,0,4,0"/>
          </StackPanel>
        </Border>
        <Border x:Name="ModalFilmstripOverlay" Grid.ColumnSpan="3" HorizontalAlignment="Stretch" VerticalAlignment="Bottom" Height="84" Margin="14,0,14,64" Padding="8,7" CornerRadius="4" Background="{StaticResource GlassChrome}" BorderBrush="{StaticResource GlassBorderHover}" BorderThickness="1" Visibility="Collapsed" Panel.ZIndex="28">
          <ListBox x:Name="ModalFilmstripOverlayList" Background="Transparent" BorderThickness="0" ItemTemplate="{StaticResource ModalFilmstripItemTemplate}" ItemContainerStyle="{StaticResource ModalFilmstripItemStyle}" SelectionMode="Single" SelectionChanged="ModalFilmstrip_SelectionChanged" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Disabled" ScrollViewer.CanContentScroll="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" AutomationProperties.Name="Bottom image filmstrip">
            <ListBox.ItemsPanel><ItemsPanelTemplate><VirtualizingStackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ListBox.ItemsPanel>
          </ListBox>
        </Border>
        <Border x:Name="ModalInteractionFeedback" Grid.ColumnSpan="3" VerticalAlignment="Top" HorizontalAlignment="Center" CornerRadius="4" Background="{StaticResource GlassChrome}" BorderBrush="{StaticResource GlassBorderHover}" BorderThickness="1" Padding="10,4" Margin="0,18,0,0" Visibility="Collapsed" IsHitTestVisible="False" Panel.ZIndex="20">
          <TextBlock x:Name="ModalInteractionFeedbackText" Foreground="{StaticResource TextPrimary}" FontSize="12" FontWeight="SemiBold"/>
        </Border>
        <Border x:Name="ModalFavoritePulse" Grid.ColumnSpan="3"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                CornerRadius="24" Background="{StaticResource GlassChrome}"
                BorderBrush="{StaticResource Favorite}" BorderThickness="1"
                Padding="18,11" Visibility="Collapsed" Opacity="1"
                IsHitTestVisible="False" Panel.ZIndex="44"
                RenderTransformOrigin="0.5,0.5"
                AutomationProperties.Name="Favorite level increased">
          <Border.RenderTransform>
            <ScaleTransform x:Name="ModalFavoritePulseScale" ScaleX="1" ScaleY="1"/>
          </Border.RenderTransform>
          <StackPanel Orientation="Horizontal">
            <Path Data="M12,21 C-4,10 3,-2 12,5 C21,-2 28,10 12,21 z"
                  Fill="{StaticResource Favorite}" Stretch="Uniform"
                  Width="24" Height="24"/>
            <TextBlock x:Name="ModalFavoritePulseLevelText" Text="1"
                       Foreground="{StaticResource FavoriteText}"
                       FontSize="17" FontWeight="Bold"
                       Margin="9,0,0,0" VerticalAlignment="Center"/>
          </StackPanel>
        </Border>
      </Grid>
    </Grid>

  </Grid>
</Window>
