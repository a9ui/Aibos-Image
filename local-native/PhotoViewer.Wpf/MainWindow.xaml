              <Separator/>
              <MenuItem Header="次に高画質化" Click="GalleryContextUpscaleNext_Click" AutomationProperties.Name="次に高画質化"/>
              <MenuItem Header="次に実写化" Click="GalleryContextPhotorealNext_Click" AutomationProperties.Name="次に実写化"/>
              <MenuItem Header="動画化" AutomationProperties.Name="Choose video generation source">
                <MenuItem Header="Originalから..." Tag="original" Click="GalleryContextVideo_Click" AutomationProperties.Name="Generate video from Original"/>
                <MenuItem Header="最新の実写版から..." Tag="photoreal" Click="GalleryContextVideo_Click" AutomationProperties.Name="Generate video from latest photoreal version"/>
              </MenuItem>
              <Separator/>
              <MenuItem Header="拡大表示" Click="GalleryContextOpenModal_Click" AutomationProperties.Name="Open enlarged image"/>
              <MenuItem Header="外部アプリで開く" Click="OpenSelectedExternally_Click" AutomationProperties.Name="Open selected image externally"/>
              <MenuItem Header="元画像の場所を開く" Click="ShowSelectedInFolder_Click" AutomationProperties.Name="Show selected source in folder"/>
              <MenuItem Header="Albumへ追加" Click="AddCurrentToAlbum_Click" AutomationProperties.Name="Add selected image to Album"/>
            </ContextMenu>
          </ListBox.ContextMenu>
          <ListBox.GroupStyle>
            <GroupStyle>
              <GroupStyle.HeaderTemplate>
                <DataTemplate>
                  <DockPanel Margin="2,16,10,10">
                    <TextBlock DockPanel.Dock="Left" Text="{Binding Name}" Foreground="{DynamicResource TextPrimary}" FontSize="14.5" FontWeight="Bold" VerticalAlignment="Center"/>
                    <TextBlock DockPanel.Dock="Left" Text="{Binding ItemCount, StringFormat=' ·  {0} images'}" Foreground="{StaticResource TextTertiary}" FontSize="11.5" VerticalAlignment="Center" Margin="4,0,0,0"/>
                    <Rectangle Height="1" VerticalAlignment="Center" Margin="12,0,0,0">
                      <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                          <GradientStop Color="{DynamicResource DividerStrongColor}" Offset="0"/>
                          <GradientStop Color="{DynamicResource DividerSubtleColor}" Offset="1"/>
                        </LinearGradientBrush>
                      </Rectangle.Fill>
                    </Rectangle>
                  </DockPanel>
                </DataTemplate>
              </GroupStyle.HeaderTemplate>
            </GroupStyle>
          </ListBox.GroupStyle>
        </local:VirtualizedGalleryListBox>

        <!-- List mode -->
        <local:VirtualizedGalleryListBox x:Name="RowsList" Visibility="Collapsed" Background="Transparent" BorderThickness="0" Padding="8,8,4,24"
                 ItemContainerStyle="{StaticResource ListRowItem}" SelectionMode="Extended" SelectionChanged="CardsList_SelectionChanged"
                 ContextMenuOpening="Gallery_ContextMenuOpening"
                 PreviewKeyDown="GalleryList_PreviewKeyDown"
                 PreviewMouseDown="GalleryAutoScroll_PreviewMouseDown" PreviewMouseUp="GalleryAutoScroll_PreviewMouseUp" LostMouseCapture="GalleryAutoScroll_LostMouseCapture"
                 PreviewMouseLeftButtonDown="FileDragSurface_PreviewMouseLeftButtonDown" PreviewMouseMove="FileDragSurface_PreviewMouseMove" PreviewMouseLeftButtonUp="FileDragSurface_PreviewMouseLeftButtonUp"
                 ToolTip="Drag images to Explorer to copy file paths" AutomationProperties.Name="Image list" AutomationProperties.HelpText="Select images, then drag beyond the system threshold to copy the real files to Explorer."
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.CanContentScroll="True"
