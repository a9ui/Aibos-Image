                            SelectedIndex="0"
                            SelectionChanged="I2iV2SeedMode_SelectionChanged"
                            AutomationProperties.Name="複数ターゲットAI編集 seed mode">
                    <ComboBoxItem Content="Random（推奨）" Tag="random"/>
                    <ComboBoxItem Content="Fixed" Tag="fixed"/>
                  </ComboBox>
                </StackPanel>
                <StackPanel Grid.Column="2">
                  <TextBlock Text="Fixed値（0〜2147483647）"
                             Foreground="{StaticResource TextPrimary}"
                             FontSize="11.5" Margin="0,0,0,4"/>
                  <TextBox x:Name="I2iV2SeedValueTextBox" MaxLength="10" IsEnabled="False"
                           Padding="7,4" Foreground="{StaticResource TextPrimary}"
                           Background="{StaticResource BgPrimary}"
                           CaretBrush="{StaticResource TextPrimary}"
                           SelectionBrush="{StaticResource AccentFill}"
                           BorderBrush="{StaticResource BorderStrong}"
                           TextChanged="I2iV2EditField_TextChanged"
                           AutomationProperties.Name="Fixed 複数ターゲットAI編集 seed"/>
                </StackPanel>
              </Grid>
              <TextBlock x:Name="I2iV2SeedStatusText" Visibility="Collapsed"
                         Foreground="{StaticResource TextSecondary}" FontSize="10.5"
                         TextWrapping="Wrap" Margin="0,6,0,0"/>

              <Border Margin="0,14,0,0" Padding="10" CornerRadius="5"
                      Background="{StaticResource BgPrimary}"
                      BorderBrush="{StaticResource GlassBorder}" BorderThickness="1">
                <StackPanel>
                  <TextBlock Text="基本の保持設定"
                             Foreground="{StaticResource TextPrimary}" FontSize="10.8"
                             FontWeight="SemiBold"/>
                  <TextBlock x:Name="I2iV2PreservationText"
                             Text="顔の同一性と元の構図を自動保持します。"
                             Foreground="{StaticResource TextSecondary}" FontSize="10.8"
                             TextWrapping="Wrap" Margin="0,4,0,0"/>
                  <TextBlock Text="保持文と生成用の内部promptはcompanionが固定policyから作ります。ここには、変えたい内容だけを入力できます。"
                             Foreground="{StaticResource TextTertiary}" FontSize="10.2"
                             TextWrapping="Wrap" Margin="0,4,0,0"/>
                </StackPanel>
              </Border>
              <TextBlock x:Name="I2iV2EditStatusText"
                         Foreground="{StaticResource TextSecondary}" FontSize="10.8"
                         TextWrapping="Wrap" Margin="0,12,0,0"
                         AutomationProperties.LiveSetting="Polite"/>
            </StackPanel>
          </ScrollViewer>
          <DockPanel Grid.Row="2" Margin="0,14,0,0" LastChildFill="False">
            <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}"
                    Content="閉じる" MinWidth="72" Height="32" Margin="8,0,0,0"
                    Click="CloseI2iV2Edit_Click"/>
            <Button x:Name="I2iV2QueueButton" DockPanel.Dock="Right"
                    Style="{StaticResource PrimaryButton}" Content="GO"
                    MinWidth="108" Height="32" IsEnabled="False"
                    Click="QueueI2iV2Edit_Click"
                    AutomationProperties.Name="GO: 複数ターゲットAI編集ジョブをキューへ追加"
                    AutomationProperties.HelpText="GOを押した時だけcompanionを起動し、ジョブを追加します。"/>
            <Button x:Name="I2iV2ResetButton" DockPanel.Dock="Right"
                    Style="{StaticResource GhostButton}" Content="入力をリセット"
                    MinWidth="96" Height="32" Click="ResetI2iV2Edit_Click"
                    AutomationProperties.Name="現在の画像のAI編集入力をリセット"/>
          </DockPanel>
        </Grid>
      </Border>
    </Grid>

    <!-- Unified I2I v3 board. Blank region fields remain structurally locked. -->
    <Grid x:Name="I2iV3EditDialog" Grid.RowSpan="3" Panel.ZIndex="660"
          Visibility="Collapsed" Background="#A9000000"
          MouseLeftButtonDown="I2iV3EditBackdrop_MouseLeftButtonDown"
          AutomationProperties.Name="統合AI編集ボード">
      <Border x:Name="I2iV3EditBoardBorder" Width="690" MaxHeight="820" Margin="18"
              HorizontalAlignment="Center" VerticalAlignment="Center"
              Padding="18" CornerRadius="8" Background="{StaticResource BgElevated}"
              BorderBrush="{StaticResource BorderStrong}" BorderThickness="1"
              KeyboardNavigation.TabNavigation="Cycle">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <DockPanel Grid.Row="0" LastChildFill="True" Margin="0,0,0,12">
            <Button x:Name="I2iV3CloseButton" DockPanel.Dock="Right"
                    Style="{StaticResource IconButton}" Width="32" Height="32"
                    Click="CloseI2iV3Edit_Click" ToolTip="閉じる"
                    AutomationProperties.Name="統合AI編集ボードを閉じる">
              <Path Data="M18,6 L6,18 M6,6 L18,18" Stroke="{StaticResource TextSecondary}"
                    StrokeThickness="1.8" Stretch="Uniform" Width="14" Height="14"/>
            </Button>
            <StackPanel>
              <TextBlock Text="AI編集" Foreground="{StaticResource TextPrimary}"
                         FontSize="18" FontWeight="SemiBold"/>
              <TextBlock Text="全体・表情・服装・背景・ポーズを1件にまとめて編集  [I]"
                         Foreground="{StaticResource TextTertiary}" FontSize="10.5" Margin="0,3,0,0"/>
            </StackPanel>
          </DockPanel>
          <ScrollViewer x:Name="I2iV3EditScrollViewer" Grid.Row="1"
                        VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
              <TextBlock Text="入力元" Foreground="{StaticResource TextTertiary}" FontSize="10.5"/>
              <TextBlock x:Name="I2iV3SourceText" Text="Original"
                         Foreground="{StaticResource TextPrimary}" FontSize="12.5"
                         FontWeight="SemiBold" Margin="0,2,0,12"/>

              <TextBlock Text="編集スタイル" Foreground="{StaticResource TextPrimary}" FontSize="11.5"/>
              <Grid Margin="0,4,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="2*"/><ColumnDefinition Width="8"/>
                  <ColumnDefinition Width="*"/><ColumnDefinition Width="8"/>
                  <ColumnDefinition Width="Auto"/><ColumnDefinition Width="6"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <ComboBox x:Name="I2iV3StyleComboBox" Grid.Column="0"
                          Style="{StaticResource PhotorealSettingsComboBox}"
                          DisplayMemberPath="Label" SelectionChanged="I2iV3Style_SelectionChanged"
                          AutomationProperties.Name="保存したAI編集スタイル"/>
                <TextBox x:Name="I2iV3StyleNameTextBox" Grid.Column="2" MaxLength="48"
                         Padding="7,4" TextChanged="I2iV3EditField_TextChanged"
                         Foreground="{StaticResource TextPrimary}" Background="{StaticResource BgPrimary}"
                         CaretBrush="{StaticResource TextPrimary}" BorderBrush="{StaticResource BorderStrong}"
                         AutomationProperties.Name="AI編集スタイル名"/>
                <Button x:Name="I2iV3SaveStyleButton" Grid.Column="4" Style="{StaticResource GhostButton}"
                        Content="保存" MinWidth="58" Click="SaveI2iV3Style_Click"/>
                <Button x:Name="I2iV3DeleteStyleButton" Grid.Column="6" Style="{StaticResource GhostButton}"
                        Content="削除" MinWidth="58" Click="DeleteI2iV3Style_Click"/>
              </Grid>
              <TextBlock x:Name="I2iV3StyleStatusText" Foreground="{StaticResource TextTertiary}"
                         FontSize="10.3" TextWrapping="Wrap" Margin="0,5,0,0"/>

              <TextBlock Text="全体（入力すると画像全体を変更）"
                         Foreground="{StaticResource TextPrimary}" FontSize="11.5" Margin="0,12,0,4"/>
              <TextBox x:Name="I2iV3OverallTextBox" MaxLength="2000" MinHeight="56"
                       AcceptsReturn="True" TextWrapping="Wrap" Padding="8,6"
                       TextChanged="I2iV3EditField_TextChanged"
                       Foreground="{StaticResource TextPrimary}" Background="{StaticResource BgPrimary}"
                       CaretBrush="{StaticResource TextPrimary}" BorderBrush="{StaticResource BorderStrong}"
                       AutomationProperties.Name="画像全体のAI編集プロンプト"/>

              <Grid Margin="0,12,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                  <TextBlock Text="表情" Foreground="{StaticResource TextPrimary}" FontSize="11.5" Margin="0,0,0,4"/>
                  <TextBox x:Name="I2iV3ExpressionTextBox" MaxLength="2000" MinHeight="66"
                           AcceptsReturn="True" TextWrapping="Wrap" Padding="8,6"
                           TextChanged="I2iV3EditField_TextChanged"
                           Foreground="{StaticResource TextPrimary}" Background="{StaticResource BgPrimary}"
                           CaretBrush="{StaticResource TextPrimary}" BorderBrush="{StaticResource BorderStrong}"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                  <TextBlock Text="服装" Foreground="{StaticResource TextPrimary}" FontSize="11.5" Margin="0,0,0,4"/>
                  <TextBox x:Name="I2iV3OutfitTextBox" MaxLength="2000" MinHeight="66"
                           AcceptsReturn="True" TextWrapping="Wrap" Padding="8,6"
                           TextChanged="I2iV3EditField_TextChanged"
                           Foreground="{StaticResource TextPrimary}" Background="{StaticResource BgPrimary}"
                           CaretBrush="{StaticResource TextPrimary}" BorderBrush="{StaticResource BorderStrong}"/>
                </StackPanel>
              </Grid>
              <Grid Margin="0,12,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                  <TextBlock Text="背景" Foreground="{StaticResource TextPrimary}" FontSize="11.5" Margin="0,0,0,4"/>
                  <TextBox x:Name="I2iV3BackgroundTextBox" MaxLength="2000" MinHeight="66"
                           AcceptsReturn="True" TextWrapping="Wrap" Padding="8,6"
                           TextChanged="I2iV3EditField_TextChanged"
                           Foreground="{StaticResource TextPrimary}" Background="{StaticResource BgPrimary}"
                           CaretBrush="{StaticResource TextPrimary}" BorderBrush="{StaticResource BorderStrong}"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                  <TextBlock Text="ポーズ" Foreground="{StaticResource TextPrimary}" FontSize="11.5" Margin="0,0,0,4"/>
                  <TextBox x:Name="I2iV3PoseTextBox" MaxLength="2000" MinHeight="66"
                           AcceptsReturn="True" TextWrapping="Wrap" Padding="8,6"
                           TextChanged="I2iV3EditField_TextChanged"
                           Foreground="{StaticResource TextPrimary}" Background="{StaticResource BgPrimary}"
                           CaretBrush="{StaticResource TextPrimary}" BorderBrush="{StaticResource BorderStrong}"/>
                </StackPanel>
              </Grid>
              <TextBlock Text="空欄の領域は変更しません。全体を入力した場合だけ、マスクに限定しない全画面編集になります。"
                         Foreground="{StaticResource TextTertiary}" FontSize="10.3" TextWrapping="Wrap" Margin="0,6,0,0"/>

              <Grid Margin="0,14,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                  <DockPanel><TextBlock Text="STEP" Foreground="{StaticResource TextPrimary}" FontSize="11.5"/><TextBlock x:Name="I2iV3StepsValueText" Text="8" DockPanel.Dock="Right" Foreground="{StaticResource Accent}"/></DockPanel>
                  <Slider x:Name="I2iV3StepsSlider" Minimum="4" Maximum="20" Value="8" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="I2iV3SettingSlider_ValueChanged"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                  <DockPanel><TextBlock Text="CFG" Foreground="{StaticResource TextPrimary}" FontSize="11.5"/><TextBlock x:Name="I2iV3CfgValueText" Text="1.0" DockPanel.Dock="Right" Foreground="{StaticResource Accent}"/></DockPanel>
                  <Slider x:Name="I2iV3CfgSlider" Minimum="0.5" Maximum="3" Value="1" TickFrequency="0.1" IsSnapToTickEnabled="True" ValueChanged="I2iV3SettingSlider_ValueChanged"/>
                </StackPanel>
              </Grid>

              <TextBlock Text="服装マスクの外側" Foreground="{StaticResource TextPrimary}" FontSize="11.5" Margin="0,12,0,4"/>
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <ComboBox x:Name="I2iV3OutfitMaskModeComboBox" Grid.Column="0"
                          Style="{StaticResource PhotorealSettingsComboBox}" SelectedIndex="0"
                          SelectionChanged="I2iV3OutfitMaskMode_SelectionChanged">
                  <ComboBoxItem Content="自動（推奨）" Tag="auto"/><ComboBoxItem Content="手動" Tag="manual"/>
                </ComboBox>
                <StackPanel Grid.Column="2">
                  <DockPanel><TextBlock Text="外縁を広げる量" Foreground="{StaticResource TextSecondary}" FontSize="10.8"/><TextBlock x:Name="I2iV3OutfitMaskExpandValueText" Text="自動 64 px" DockPanel.Dock="Right" Foreground="{StaticResource Accent}"/></DockPanel>
                  <Slider x:Name="I2iV3OutfitMaskExpandSlider" Minimum="0" Maximum="160" Value="32" TickFrequency="8" IsSnapToTickEnabled="True" IsEnabled="False" ValueChanged="I2iV3SettingSlider_ValueChanged"/>
                </StackPanel>
              </Grid>

              <Grid Margin="0,12,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                  <TextBlock Text="Seed" Foreground="{StaticResource TextPrimary}" FontSize="11.5" Margin="0,0,0,4"/>
                  <ComboBox x:Name="I2iV3SeedModeComboBox" Style="{StaticResource PhotorealSettingsComboBox}" SelectedIndex="0" SelectionChanged="I2iV3SeedMode_SelectionChanged">
                    <ComboBoxItem Content="Random（推奨）" Tag="random"/><ComboBoxItem Content="Fixed" Tag="fixed"/>
                  </ComboBox>
                </StackPanel>
                <StackPanel Grid.Column="2">
                  <TextBlock Text="Fixed値（0〜2147483647）" Foreground="{StaticResource TextPrimary}" FontSize="11.5" Margin="0,0,0,4"/>
                  <TextBox x:Name="I2iV3SeedValueTextBox" MaxLength="10" IsEnabled="False" Padding="7,4"
                           TextChanged="I2iV3EditField_TextChanged" Foreground="{StaticResource TextPrimary}"
                           Background="{StaticResource BgPrimary}" CaretBrush="{StaticResource TextPrimary}"
                           BorderBrush="{StaticResource BorderStrong}"/>
                </StackPanel>
              </Grid>
              <TextBlock x:Name="I2iV3EditStatusText" Foreground="{StaticResource TextSecondary}"
                         FontSize="10.8" TextWrapping="Wrap" Margin="0,12,0,0"
                         AutomationProperties.LiveSetting="Polite"/>
            </StackPanel>
          </ScrollViewer>
          <DockPanel Grid.Row="2" Margin="0,14,0,0" LastChildFill="False">
            <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="閉じる"
                    MinWidth="72" Height="32" Margin="8,0,0,0" Click="CloseI2iV3Edit_Click"/>
            <Button x:Name="I2iV3QueueButton" DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}"
                    Content="GO  [Ctrl+Enter]" MinWidth="132" Height="32" IsEnabled="False"
                    Click="QueueI2iV3Edit_Click" AutomationProperties.Name="統合AI編集をキューへ追加"/>
            <Button x:Name="I2iV3ResetButton" DockPanel.Dock="Right" Style="{StaticResource GhostButton}"
                    Content="入力をリセット" MinWidth="96" Height="32" Click="ResetI2iV3Edit_Click"/>
          </DockPanel>
        </Grid>
      </Border>
    </Grid>

    <!-- ═══════════════ Modal ═══════════════ -->
    <!-- App settings are separate from the modal generation-metadata Settings tab. -->
    <Grid x:Name="AppSettingsDialog" Grid.RowSpan="3" Panel.ZIndex="500" Visibility="Collapsed" Background="{StaticResource BgPrimary}"
          MouseLeftButtonDown="AppSettingsBackdrop_MouseLeftButtonDown" PreviewMouseWheel="AppSettingsDialog_PreviewMouseWheel"
          AutomationProperties.Name="App settings dialog" AutomationProperties.HelpText="Change local safety settings and keyboard shortcuts. Escape or a backdrop click closes this dialog.">
      <Border x:Name="AppSettingsDialogSurface" Width="680" MaxHeight="660" Margin="24" CornerRadius="6" Background="{StaticResource BgSecondary}" BorderBrush="{StaticResource GlassBorder}" BorderThickness="1" HorizontalAlignment="Center" VerticalAlignment="Center" KeyboardNavigation.TabNavigation="Cycle" KeyboardNavigation.ControlTabNavigation="Cycle">
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <Grid.ColumnDefinitions><ColumnDefinition Width="152"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <DockPanel Grid.Row="0" Grid.ColumnSpan="2" Margin="16,12,12,10" LastChildFill="False"><TextBlock Text="{DynamicResource UiSettings}" Foreground="{StaticResource TextPrimary}" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center"/><Button x:Name="AppSettingsCloseButton" DockPanel.Dock="Right" Style="{StaticResource IconButton}" Click="CloseAppSettings_Click" ToolTip="{DynamicResource UiClose}" AutomationProperties.Name="Close app settings"><Path Data="M18,6 L6,18 M6,6 L18,18" Stroke="{StaticResource TextSecondary}" StrokeThickness="1.8" Stretch="Uniform" Width="14" Height="14"/></Button></DockPanel>
          <Border Grid.Row="1" Grid.RowSpan="2" Grid.Column="0" Background="{StaticResource BgPrimary}" BorderBrush="{StaticResource GlassBorder}" BorderThickness="0,1,1,0" Padding="10,11">
            <StackPanel>
              <RadioButton x:Name="SettingsGeneralNav" Style="{StaticResource SettingsNavItem}" GroupName="AppSettingsNavigation" Content="{DynamicResource UiSettingsGeneral}" Tag="general" IsChecked="True" Click="AppSettingsNavigation_Click" AutomationProperties.Name="General settings"/>
              <RadioButton x:Name="SettingsUpscaleNav" Style="{StaticResource SettingsNavItem}" GroupName="AppSettingsNavigation" Content="AI高画質化" Tag="upscale" Click="AppSettingsNavigation_Click" AutomationProperties.Name="AI upscale settings"/>
              <RadioButton x:Name="SettingsPhotorealNav" Style="{StaticResource SettingsNavItem}" GroupName="AppSettingsNavigation" Content="AI実写化" Tag="photoreal" Click="AppSettingsNavigation_Click" AutomationProperties.Name="AI photorealization settings"/>
              <RadioButton x:Name="SettingsVideoNav" Style="{StaticResource SettingsNavItem}" GroupName="AppSettingsNavigation" Content="動画化" Tag="video" Click="AppSettingsNavigation_Click" AutomationProperties.Name="Video generation settings"/>
              <RadioButton x:Name="SettingsVideoToolsV2Nav" Style="{StaticResource SettingsNavItem}" GroupName="AppSettingsNavigation" Content="{DynamicResource UiVideoToolsV2Settings}" Tag="video-tools-v2" Click="AppSettingsNavigation_Click" AutomationProperties.Name="AI video edit and enhancement settings"/>
              <RadioButton x:Name="SettingsDisplayNav" Style="{StaticResource SettingsNavItem}" GroupName="AppSettingsNavigation" Content="{DynamicResource UiSettingsDisplay}" Tag="display" Click="AppSettingsNavigation_Click" AutomationProperties.Name="Display settings"/>
              <RadioButton x:Name="SettingsThumbnailsNav" Style="{StaticResource SettingsNavItem}" GroupName="AppSettingsNavigation" Content="{DynamicResource UiSettingsThumbnails}" Tag="thumbnails" Click="AppSettingsNavigation_Click" AutomationProperties.Name="Thumbnail settings"/>
              <RadioButton x:Name="SettingsKeyboardNav" Style="{StaticResource SettingsNavItem}" GroupName="AppSettingsNavigation" Content="{DynamicResource UiSettingsKeyboard}" Tag="keyboard" Click="AppSettingsNavigation_Click" AutomationProperties.Name="Keyboard settings"/>
              <RadioButton x:Name="SettingsStorageNav" Style="{StaticResource SettingsNavItem}" GroupName="AppSettingsNavigation" Content="{DynamicResource UiSettingsStorage}" Tag="storage" Click="AppSettingsNavigation_Click" AutomationProperties.Name="Shared data storage"/>
              <RadioButton x:Name="SettingsAboutNav" Style="{StaticResource SettingsNavItem}" GroupName="AppSettingsNavigation" Content="{DynamicResource UiSettingsAbout}" Tag="about" Click="AppSettingsNavigation_Click" AutomationProperties.Name="About and diagnostics"/>
            </StackPanel>
          </Border>
          <ScrollViewer x:Name="AppSettingsScrollViewer" Grid.Row="1" Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="False" Padding="18,10,10,0" AutomationProperties.Name="App settings content">
          <StackPanel>
          <TextBlock x:Name="GeneralSettingsHeading" Text="GENERAL" Foreground="{StaticResource TextTertiary}" FontSize="10.5" FontWeight="SemiBold" Margin="0,0,0,8" AutomationProperties.Name="General settings section"/>
          <TextBlock Text="{DynamicResource UiInterfaceLanguageHeading}" Foreground="{StaticResource TextTertiary}" FontSize="10.5" FontWeight="SemiBold" Margin="0,0,0,6"/>
          <Border Width="224" HorizontalAlignment="Left" Background="{StaticResource BgTertiary}" BorderBrush="{StaticResource GlassBorder}" BorderThickness="1" CornerRadius="4" Padding="3">
            <UniformGrid Columns="2">
              <RadioButton x:Name="UiEnglishRadioButton" Style="{StaticResource Seg}" GroupName="UiLanguage" Content="English" Tag="en" Click="UiLanguage_Click" AutomationProperties.Name="Use English interface"/>
              <RadioButton x:Name="UiJapaneseRadioButton" Style="{StaticResource Seg}" GroupName="UiLanguage" Content="日本語" Tag="ja" Click="UiLanguage_Click" AutomationProperties.Name="日本語の画面表示を使う"/>
            </UniformGrid>
          </Border>
          <TextBlock Text="{DynamicResource UiInterfaceLanguageHelp}" Foreground="{StaticResource TextTertiary}" FontSize="11.5" TextWrapping="Wrap" Margin="0,6,0,4"/>
          <TextBlock x:Name="UiLanguageStatusText" Foreground="{StaticResource TextSecondary}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,18" AutomationProperties.LiveSetting="Polite"/>
          <CheckBox x:Name="ConfirmBeforeDeleteCheckBox" Content="{DynamicResource UiConfirmBeforeDelete}" Foreground="{StaticResource TextSecondary}" Checked="ConfirmBeforeDelete_Changed" Unchecked="ConfirmBeforeDelete_Changed" AutomationProperties.Name="Confirm before delete"/>
          <TextBlock Text="{DynamicResource UiConfirmBeforeDeleteHelp}" Foreground="{StaticResource TextTertiary}" FontSize="11.5" TextWrapping="Wrap" Margin="24,4,0,18"/>
          <TextBlock x:Name="DisplaySettingsHeading" Text="DISPLAY" Foreground="{StaticResource TextTertiary}" FontSize="10.5" FontWeight="SemiBold" Margin="0,0,0,6" AutomationProperties.Name="Display settings section"/>
          <CheckBox x:Name="AppSettingsShowGridFileInfoOverlayCheckBox" Content="{DynamicResource UiGridFileInfoOverlay}" Foreground="{StaticResource TextSecondary}" Checked="ShowGridFileInfoOverlay_Changed" Unchecked="ShowGridFileInfoOverlay_Changed" AutomationProperties.Name="Show filename and file size over Grid thumbnails" AutomationProperties.HelpText="{DynamicResource UiGridFileInfoOverlayHelp}"/>
          <TextBlock Text="{DynamicResource UiGridFileInfoOverlayHelp}" Foreground="{StaticResource TextTertiary}" FontSize="11.5" TextWrapping="Wrap" Margin="24,4,0,14"/>
          <CheckBox x:Name="ShowLoadTimingCheckBox" Content="{DynamicResource UiShowLoadTiming}" Foreground="{StaticResource TextSecondary}" Checked="ShowLoadTiming_Changed" Unchecked="ShowLoadTiming_Changed" AutomationProperties.Name="Show folder load timing" AutomationProperties.HelpText="{DynamicResource UiShowLoadTimingHelp}"/>
          <TextBlock Text="{DynamicResource UiShowLoadTimingHelp}" Foreground="{StaticResource TextTertiary}" FontSize="11.5" TextWrapping="Wrap" Margin="24,4,0,14"/>
          <CheckBox x:Name="AppSettingsUnseenDotsCheckBox" Content="{DynamicResource UiUnseenDots}" Foreground="{StaticResource TextSecondary}" Checked="ShowUnseenDots_Changed" Unchecked="ShowUnseenDots_Changed" AutomationProperties.Name="Show unseen dots in gallery" AutomationProperties.HelpText="Changes dot visibility only. Seen history is not changed."/>
          <TextBlock Text="{DynamicResource UiUnseenDotsHelp}" Foreground="{StaticResource TextTertiary}" FontSize="11.5" TextWrapping="Wrap" Margin="24,4,0,14"/>
           <CheckBox x:Name="FavoriteChangeNotificationsCheckBox" Content="{DynamicResource UiFavoriteChangeNotifications}" Foreground="{StaticResource TextSecondary}" Checked="FavoriteChangeNotifications_Changed" Unchecked="FavoriteChangeNotifications_Changed" AutomationProperties.Name="Show favorite change notifications"/>
           <TextBlock Text="{DynamicResource UiFavoriteChangeNotificationsHelp}" Foreground="{StaticResource TextTertiary}" FontSize="11.5" TextWrapping="Wrap" Margin="24,4,0,14"/>
           <TextBlock Text="{DynamicResource UiNotifySettingsTitle}" Foreground="{StaticResource TextTertiary}" FontSize="10.5" FontWeight="SemiBold" Margin="0,0,0,7" AutomationProperties.Name="AI processing notification settings"/>
           <Grid Width="390" HorizontalAlignment="Left" Margin="0,0,0,5">
             <Grid.RowDefinitions>
               <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
             </Grid.RowDefinitions>
             <Grid.ColumnDefinitions>
               <ColumnDefinition Width="190"/><ColumnDefinition Width="96"/><ColumnDefinition Width="96"/>
             </Grid.ColumnDefinitions>
             <TextBlock Grid.Row="0" Grid.Column="1" Text="{DynamicResource UiNotifySucceededColumn}" Foreground="{StaticResource TextTertiary}" FontSize="11" HorizontalAlignment="Center" Margin="0,0,0,5"/>
             <TextBlock Grid.Row="0" Grid.Column="2" Text="{DynamicResource UiNotifyFailedColumn}" Foreground="{StaticResource TextTertiary}" FontSize="11" HorizontalAlignment="Center" Margin="0,0,0,5"/>
             <TextBlock Grid.Row="1" Grid.Column="0" Text="{DynamicResource UiNotifyKindUpscale}" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,8,6"/>
             <CheckBox x:Name="NotifyUpscaleSucceededCheckBox" Grid.Row="1" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Checked="EnhancementNotificationPreference_Changed" Unchecked="EnhancementNotificationPreference_Changed" AutomationProperties.Name="Notify when upscale completes"/>
             <CheckBox x:Name="NotifyUpscaleFailedCheckBox" Grid.Row="1" Grid.Column="2" HorizontalAlignment="Center" VerticalAlignment="Center" Checked="EnhancementNotificationPreference_Changed" Unchecked="EnhancementNotificationPreference_Changed" AutomationProperties.Name="Notify when upscale fails"/>
             <TextBlock Grid.Row="2" Grid.Column="0" Text="{DynamicResource UiNotifyKindPhotoreal}" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,8,6"/>
             <CheckBox x:Name="NotifyPhotorealSucceededCheckBox" Grid.Row="2" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Checked="EnhancementNotificationPreference_Changed" Unchecked="EnhancementNotificationPreference_Changed" AutomationProperties.Name="Notify when photorealization completes"/>
             <CheckBox x:Name="NotifyPhotorealFailedCheckBox" Grid.Row="2" Grid.Column="2" HorizontalAlignment="Center" VerticalAlignment="Center" Checked="EnhancementNotificationPreference_Changed" Unchecked="EnhancementNotificationPreference_Changed" AutomationProperties.Name="Notify when photorealization fails"/>
             <TextBlock Grid.Row="3" Grid.Column="0" Text="{DynamicResource UiNotifyKindVideoGeneration}" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,8,6"/>
             <CheckBox x:Name="NotifyVideoSucceededCheckBox" Grid.Row="3" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Checked="EnhancementNotificationPreference_Changed" Unchecked="EnhancementNotificationPreference_Changed" AutomationProperties.Name="Notify when video generation completes"/>
