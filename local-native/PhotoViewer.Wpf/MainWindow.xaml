                      </StackPanel>
                    </Border>
                    <Button x:Name="FavoriteIncreaseButton" Style="{StaticResource StepButton}" Content="+" ToolTip="Increase" Click="FavoriteIncrease_Click" AutomationProperties.Name="Increase favorite level"/>
                  </StackPanel>
                </Border>
                <Button x:Name="RightPreviewEnhanceButton" Style="{StaticResource GhostButton}" Width="38" Margin="0,0,3,8"
