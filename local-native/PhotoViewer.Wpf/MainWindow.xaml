<Window x:Class="PhotoViewer.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:PhotoViewer.Wpf"
        Title="Aibos Image" Icon="Brand/Generated/Aibos.App.ico"
        Height="820" Width="1280" MinHeight="560" MinWidth="900"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize"
        Background="{StaticResource BgPrimary}" Foreground="{StaticResource TextPrimary}"
        FontFamily="Segoe UI" TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True" SnapsToDevicePixels="True">

  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="52" ResizeBorderThickness="6" CornerRadius="0" GlassFrameThickness="0" UseAeroCaptionButtons="False"/>
  </WindowChrome.WindowChrome>

  <Window.Resources>
    <Style x:Key="PhotorealSettingsComboBoxItem" TargetType="{x:Type ComboBoxItem}">
      <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
      <Setter Property="Background" Value="{StaticResource BgPrimary}"/>
      <Setter Property="Padding" Value="8,5"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type ComboBoxItem}">
            <Border x:Name="ItemSurface"
                    Background="{TemplateBinding Background}"
                    BorderBrush="Transparent" BorderThickness="1"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="Center"
                                TextElement.Foreground="{TemplateBinding Foreground}"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsHighlighted" Value="True">
                <Setter TargetName="ItemSurface" Property="Background" Value="{StaticResource AccentFillHover}"/>
                <Setter TargetName="ItemSurface" Property="BorderBrush" Value="{StaticResource AccentLight}"/>
                <Setter Property="Foreground" Value="{StaticResource SelectionText}"/>
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="ItemSurface" Property="Background" Value="{StaticResource AccentFill}"/>
                <Setter TargetName="ItemSurface" Property="BorderBrush" Value="{StaticResource AccentLight}"/>
                <Setter Property="Foreground" Value="{StaticResource SelectionText}"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="ItemSurface" Property="Background" Value="{StaticResource BgTertiary}"/>
                <Setter Property="Foreground" Value="{StaticResource TextDisabled}"/>
                <Setter Property="Opacity" Value="1"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="IsHighlighted" Value="True">
          <Setter Property="Foreground" Value="{StaticResource SelectionText}"/>
          <Setter Property="Background" Value="{StaticResource AccentFillHover}"/>
        </Trigger>
        <Trigger Property="IsSelected" Value="True">
          <Setter Property="Foreground" Value="{StaticResource SelectionText}"/>
          <Setter Property="Background" Value="{StaticResource AccentFill}"/>
        </Trigger>
        <Trigger Property="IsEnabled" Value="False">
          <Setter Property="Foreground" Value="{StaticResource TextDisabled}"/>
          <Setter Property="Background" Value="{StaticResource BgTertiary}"/>
          <Setter Property="Opacity" Value="1"/>
        </Trigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="PhotorealSettingsComboBox" TargetType="{x:Type ComboBox}">
      <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
      <Setter Property="TextElement.Foreground" Value="{StaticResource TextPrimary}"/>
      <Setter Property="Background" Value="{StaticResource BgPrimary}"/>
      <Setter Property="BorderBrush" Value="{StaticResource BorderStrong}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="7,4"/>
      <Setter Property="ItemContainerStyle" Value="{StaticResource PhotorealSettingsComboBoxItem}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type ComboBox}">
            <Grid>
              <ToggleButton x:Name="DropDownToggle"
                            Focusable="False" ClickMode="Press"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Foreground="{TemplateBinding Foreground}"
                            IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                <ToggleButton.Template>
                  <ControlTemplate TargetType="{x:Type ToggleButton}">
                    <Border x:Name="ClosedSurface"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="3">
                      <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="ClosedSurface" Property="BorderBrush" Value="{StaticResource AccentLight}"/>
                      </Trigger>
                      <Trigger Property="IsChecked" Value="True">
                        <Setter TargetName="ClosedSurface" Property="BorderBrush" Value="{StaticResource Focus}"/>
                      </Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </ToggleButton.Template>
                <Grid Margin="{TemplateBinding Padding}">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="18"/>
                  </Grid.ColumnDefinitions>
                  <ContentPresenter Grid.Column="0"
                                    Content="{TemplateBinding SelectionBoxItem}"
                                    ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                    ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                    ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                    TextElement.Foreground="{TemplateBinding Foreground}"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Left"
                                    RecognizesAccessKey="True"/>
                  <Path Grid.Column="1" Data="M 0 0 L 4 4 L 8 0 Z"
                        Fill="{TemplateBinding Foreground}"
                        Width="8" Height="4"
                        HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>
              </ToggleButton>
              <Popup x:Name="PART_Popup"
                     Placement="Bottom"
                     IsOpen="{TemplateBinding IsDropDownOpen}"
                     AllowsTransparency="True"
                     Focusable="False"
                     PopupAnimation="Fade">
                <Border x:Name="DropDownSurface"
                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                        MaxHeight="{TemplateBinding MaxDropDownHeight}"
                        Background="{StaticResource BgPrimary}"
                        BorderBrush="{StaticResource BorderStrong}"
                        BorderThickness="1"
                        CornerRadius="3"
                        Padding="2">
                  <ScrollViewer CanContentScroll="True"
                                HorizontalScrollBarVisibility="Disabled"
                                VerticalScrollBarVisibility="Auto">
                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                  </ScrollViewer>
                </Border>
              </Popup>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Setter TargetName="DropDownToggle" Property="BorderBrush" Value="{StaticResource Focus}"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="DropDownToggle" Property="Background" Value="{StaticResource BgTertiary}"/>
                <Setter TargetName="DropDownToggle" Property="Foreground" Value="{StaticResource TextDisabled}"/>
                <Setter TargetName="DropDownToggle" Property="Opacity" Value="1"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="IsEnabled" Value="False">
          <Setter Property="Foreground" Value="{StaticResource TextDisabled}"/>
          <Setter Property="TextElement.Foreground" Value="{StaticResource TextDisabled}"/>
          <Setter Property="Background" Value="{StaticResource BgTertiary}"/>
          <Setter Property="Opacity" Value="1"/>
        </Trigger>
      </Style.Triggers>
    </Style>
    <ItemsPanelTemplate x:Key="VirtualizedCardItemsPanel">
      <local:VirtualizingWrapPanel HorizontalSpacing="10" VerticalSpacing="10" OverscanRows="0"/>
    </ItemsPanelTemplate>
    <Style x:Key="FavoriteLevelPill" TargetType="{x:Type CheckBox}" BasedOn="{StaticResource Pill}">
      <Setter Property="Height" Value="30"/>
      <Setter Property="MinHeight" Value="30"/>
      <Setter Property="MinWidth" Value="28"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="Margin" Value="1,0"/>
      <Setter Property="FocusVisualStyle" Value="{StaticResource CommonButtonFocusVisual}"/>
    </Style>
    <Style x:Key="EnhancementJobsFilterPill" TargetType="{x:Type CheckBox}" BasedOn="{StaticResource FavoriteLevelPill}">
      <Setter Property="FontSize" Value="11.5"/>
      <Setter Property="Margin" Value="2"/>
      <Setter Property="ToolTipService.ShowDuration" Value="12000"/>
    </Style>
  </Window.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="34"/>
    </Grid.RowDefinitions>

    <!-- ═══════════════ Header ═══════════════ -->
    <Border x:Name="WorkbenchHeaderSurface" Grid.Row="0" MinHeight="52" Background="{StaticResource HeaderBg}" BorderBrush="{StaticResource GlassBorderHover}" BorderThickness="0,0,0,1">
      <Grid Margin="10,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="96"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <!-- left cluster -->
        <StackPanel x:Name="HeaderLeftActions" Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
          <Button x:Name="ToggleSidebar" Style="{StaticResource IconButtonActive}" Click="ToggleSidebar_Click"
                  ToolTip="Hide sidebar" AutomationProperties.Name="Toggle sidebar" WindowChrome.IsHitTestVisibleInChrome="True">
            <Path Data="M3,4 h18 v16 h-18 z M9,4 v16" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.8" Stretch="Uniform" Width="18" Height="18"/>
          </Button>
          <Button x:Name="LogoHomeButton" Style="{StaticResource TransparentButton}" Background="Transparent" BorderThickness="0" Padding="8,4" Margin="0,0,0,0"
                  Click="Logo_Click" ToolTip="Back to folder selection" AutomationProperties.Name="Back to folder selection" WindowChrome.IsHitTestVisibleInChrome="True">
            <StackPanel Orientation="Horizontal">
              <Image Source="Brand/Generated/Aibos.Mark.20.png" Width="20" Height="20"
                     Stretch="Uniform" SnapsToDevicePixels="True" RenderOptions.BitmapScalingMode="HighQuality"
                     AutomationProperties.Name="Aibos Gallery Fold mark"/>
              <TextBlock Text="Aibos" FontSize="18.5" FontWeight="Bold" Foreground="{StaticResource LogoBrush}"
                         VerticalAlignment="Center" Margin="7,0,0,0"/>
              <TextBlock x:Name="HeaderProductVersionText" Text="v0.2.0"
                         FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextTertiary}"
                         VerticalAlignment="Center" Margin="6,3,0,0"
                         AutomationProperties.Name="Aibos Image product version"/>
            </StackPanel>
          </Button>
          <Button Style="{StaticResource IconButton}" ToolTip="Refresh active folder" AutomationProperties.Name="Refresh active folder" Click="RefreshActiveFolder_Click" WindowChrome.IsHitTestVisibleInChrome="True">
            <Path Data="M22,11 a10,10 0 1 1 -3,-7 M22,4 v5 h-5" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.8" Stretch="Uniform" Width="17" Height="17"/>
          </Button>
          <Button x:Name="GalleryScrollToTopButton" Style="{StaticResource IconButton}"
                  ToolTip="{DynamicResource UiGalleryScrollToTop}" AutomationProperties.Name="{DynamicResource UiGalleryScrollToTop}"
                  Click="GalleryScrollToTop_Click" WindowChrome.IsHitTestVisibleInChrome="True">
            <Path Data="M5,6 H19 M12,19 V9 M7.5,13.5 L12,9 L16.5,13.5"
                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                  StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                  StrokeLineJoin="Round" Stretch="Uniform" Width="17" Height="17"/>
          </Button>
          <Button x:Name="FavoriteUndoButton" Style="{StaticResource IconButton}"
                  Width="30" Height="28" IsEnabled="False" Margin="4,0,0,0"
                  Click="FavoriteUndo_Click" ToolTip="Undo favorite change (Ctrl+Z)"
                  AutomationProperties.Name="Undo favorite change"
                  WindowChrome.IsHitTestVisibleInChrome="True">
            <Path Data="M9,7 L4,12 L9,17 M5,12 H14 A6,6 0 0 1 20,18"
                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                  StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                  StrokeLineJoin="Round" Width="17" Height="17" Stretch="Uniform"/>
          </Button>
          <Button x:Name="FavoriteRedoButton" Style="{StaticResource IconButton}"
                  Width="30" Height="28" IsEnabled="False" Margin="2,0,0,0"
                  Click="FavoriteRedo_Click" ToolTip="Redo favorite change (Ctrl+Y)"
                  AutomationProperties.Name="Redo favorite change"
                  WindowChrome.IsHitTestVisibleInChrome="True">
            <Path Data="M15,7 L20,12 L15,17 M19,12 H10 A6,6 0 0 0 4,18"
                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                  StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                  StrokeLineJoin="Round" Width="17" Height="17" Stretch="Uniform"/>
          </Button>
          <Button x:Name="FavoriteHistoryButton" Style="{StaticResource IconButton}"
                  Width="30" Height="28" Margin="2,0,0,0"
                  Click="FavoriteHistory_Click" ToolTip="Show favorite changes made in this session"
                  AutomationProperties.Name="Show favorite change history"
                  WindowChrome.IsHitTestVisibleInChrome="True">
            <Path Data="M12,4 A8,8 0 1 1 5.2,7.8 M5,4 V8 H9 M12,8 V12 L15,14"
                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                  StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                  StrokeLineJoin="Round" Width="17" Height="17" Stretch="Uniform"/>
          </Button>
        </StackPanel>

        <Popup x:Name="FavoriteHistoryPopup" PlacementTarget="{Binding ElementName=FavoriteHistoryButton}" Placement="Bottom"
               AllowsTransparency="True" PopupAnimation="Fade" StaysOpen="False">
          <Border Width="360" MaxHeight="360" Margin="0,5,0,0" CornerRadius="7" Padding="10"
                  Background="{StaticResource BgElevated}" BorderBrush="{StaticResource GlassBorder}" BorderThickness="1">
            <DockPanel LastChildFill="True">
              <TextBlock DockPanel.Dock="Top" Text="Favorite history" Foreground="{StaticResource TextPrimary}"
                         FontSize="13" FontWeight="SemiBold" Margin="2,0,2,7"/>
              <TextBlock x:Name="FavoriteHistoryEmptyText" DockPanel.Dock="Top"
                         Text="No favorite changes in this session." Foreground="{StaticResource TextTertiary}"
                         FontSize="11.5" TextWrapping="Wrap" Margin="2,6"/>
              <ListBox x:Name="FavoriteHistoryList" Background="Transparent" BorderThickness="0"
                       MaxHeight="300" Visibility="Collapsed"
                       ScrollViewer.VerticalScrollBarVisibility="Auto"
                       AutomationProperties.Name="Favorite change history">
                <ListBox.ItemContainerStyle>
                  <Style TargetType="ListBoxItem">
                    <Setter Property="Focusable" Value="False"/>
                    <Setter Property="IsHitTestVisible" Value="False"/>
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="Margin" Value="0,0,0,5"/>
                  </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <Border CornerRadius="5" Background="{StaticResource BgTertiary}" Padding="8,6">
                      <StackPanel>
                        <TextBlock Text="{Binding DisplayText}" Foreground="{StaticResource TextSecondary}"
                                   FontSize="11.5" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding TimeText}" Foreground="{StaticResource TextTertiary}"
                                   FontSize="10" Margin="0,2,0,0"/>
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </DockPanel>
          </Border>
        </Popup>

        <!-- search -->
        <Border x:Name="SearchBoxContainer" Grid.Column="1" MinWidth="240" MaxWidth="480" HorizontalAlignment="Stretch" Margin="10,5"
                CornerRadius="4" Background="{StaticResource BgSecondary}" BorderBrush="{StaticResource GlassBorder}" BorderThickness="1"
                WindowChrome.IsHitTestVisibleInChrome="True">
          <Grid Margin="10,1,4,2">
            <Grid.RowDefinitions>
              <RowDefinition Height="29"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <DockPanel Grid.Row="0" LastChildFill="True">
              <Path DockPanel.Dock="Left" Data="M11,11 m-8,0 a8,8 0 1 0 16,0 a8,8 0 1 0 -16,0 M21,21 l-4.3,-4.3" Stroke="{StaticResource TextTertiary}" StrokeThickness="1.8" Stretch="Uniform" Width="15" Height="15" Margin="0,0,8,0" VerticalAlignment="Center"/>
              <Button x:Name="ClearSearchInputButton" DockPanel.Dock="Right" Style="{StaticResource IconButton}"
                      Width="26" Height="26" Margin="5,0,0,0" Visibility="Collapsed"
                      Click="ClearSearchInput_Click" ToolTip="Clear search"
                      AutomationProperties.Name="Clear search input"
                      AutomationProperties.HelpText="Clear the entire current search query.">
                <Path Data="M4,4 L16,16 M16,4 L4,16"
                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                      StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                      Width="11" Height="11" Stretch="Uniform"/>
              </Button>
              <Grid>
                <TextBox Style="{StaticResource SearchBox}" x:Name="SearchInput" FontSize="13" VerticalAlignment="Center"
                         TextChanged="SearchInput_TextChanged" GotKeyboardFocus="SearchInput_GotKeyboardFocus"
                         PreviewMouseLeftButtonDown="SearchInput_PreviewMouseLeftButtonDown"
                         PreviewKeyDown="SearchInput_PreviewKeyDown" LostKeyboardFocus="SearchInput_LostKeyboardFocus"
                         AutomationProperties.Name="Search images" AutomationProperties.HelpText="Search filenames and prompts. Choose a suggestion or press Enter to add a colored search term. Backspace removes the last term when the input is empty."/>
                <TextBlock x:Name="SearchWatermark" Text="{DynamicResource UiSearchPlaceholder}" Foreground="{StaticResource TextTertiary}" FontSize="12.5" VerticalAlignment="Center" IsHitTestVisible="False" TextTrimming="CharacterEllipsis"/>
              </Grid>
            </DockPanel>
            <ScrollViewer x:Name="SearchTermChipsScroller" Grid.Row="1" Height="23"
                          HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled"
                          CanContentScroll="True" Visibility="Collapsed"
                          AutomationProperties.Name="Active search terms"
                          AutomationProperties.HelpText="Each search term has a remove button.">
              <StackPanel x:Name="SearchTermChipsPanel" Orientation="Horizontal"/>
            </ScrollViewer>
          </Grid>
        </Border>

        <Popup x:Name="SearchHistoryPopup" PlacementTarget="{Binding ElementName=SearchBoxContainer}" Placement="Bottom"
               AllowsTransparency="True" PopupAnimation="Fade" StaysOpen="False">
          <Border Width="{Binding PlacementTarget.ActualWidth, ElementName=SearchHistoryPopup}" MaxHeight="320" Margin="0,5,0,0"
                  Background="{StaticResource BgElevated}" BorderBrush="{StaticResource GlassBorder}" BorderThickness="1"
                  CornerRadius="6" Padding="0,6,0,6">
            <DockPanel LastChildFill="True">
              <StackPanel x:Name="SearchSuggestionSection" DockPanel.Dock="Top" Visibility="Collapsed">
                <TextBlock Text="{DynamicResource UiSearchSuggestions}" Margin="12,0,12,5"
                           Foreground="{StaticResource TextTertiary}" FontSize="11.5" FontWeight="SemiBold"/>
                <ListBox x:Name="SearchSuggestionList" MaxHeight="156" Margin="6,0,6,6"
                         AutomationProperties.Name="Search term suggestions"
                         Background="Transparent" BorderThickness="0" Padding="0" SelectionMode="Single"
                         SelectionChanged="SearchSuggestionList_SelectionChanged"
                         PreviewKeyDown="SearchSuggestionList_PreviewKeyDown">
                  <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                      <Setter Property="Padding" Value="0"/>
                      <Setter Property="Background" Value="Transparent"/>
                      <Setter Property="BorderThickness" Value="0"/>
                    </Style>
                  </ListBox.ItemContainerStyle>
                  <ListBox.ItemTemplate>
                    <DataTemplate>
                      <Button Style="{StaticResource TransparentButton}" Tag="{Binding}" Click="SearchSuggestionSelect_Click"
                              Margin="0,1" Padding="8,5" HorizontalContentAlignment="Stretch"
                              Background="{Binding Background}" Foreground="{Binding Foreground}"
                              BorderBrush="{Binding Foreground}" BorderThickness="1"
                              ToolTip="{Binding Tag}" AutomationProperties.Name="{Binding Tag, StringFormat={}Add search term {0}}"
                              AutomationProperties.HelpText="Add this suggestion as one complete search term.">
                        <Grid>
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                          </Grid.ColumnDefinitions>
                          <TextBlock Text="{Binding Tag}" TextTrimming="CharacterEllipsis" FontSize="12.5" FontWeight="SemiBold"/>
                          <TextBlock Grid.Column="1" Text="{Binding UsageText}" Margin="8,0,0,0" Opacity="0.76" FontSize="10.5"/>
                        </Grid>
                      </Button>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
              </StackPanel>
              <Grid DockPanel.Dock="Top" Margin="12,0,6,5">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{DynamicResource UiRecentSearches}" Foreground="{StaticResource TextTertiary}" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <Button x:Name="ClearSearchHistoryButton" Grid.Column="1" Style="{StaticResource TransparentButton}" Padding="8,3" Background="Transparent" BorderThickness="0"
                        Foreground="{StaticResource TextTertiary}" Click="ClearSearchHistory_Click" Content="{DynamicResource UiClearAll}" FontSize="11" ToolTip="Clear shared search history"
                        AutomationProperties.Name="Clear shared search history"/>
              </Grid>
              <TextBlock x:Name="SearchHistoryStatusText" DockPanel.Dock="Top" Margin="12,1,12,5"
                         Foreground="{StaticResource DangerText}" FontSize="11" TextWrapping="Wrap" Visibility="Collapsed"
                         AutomationProperties.Name="Shared search history status" AutomationProperties.LiveSetting="Assertive"/>
              <TextBlock x:Name="SearchHistoryAnnouncementText" DockPanel.Dock="Top" Margin="12,1,12,3"
                         Foreground="{StaticResource TextTertiary}" FontSize="10.5" TextWrapping="Wrap"
                         AutomationProperties.Name="Shared search history announcement" AutomationProperties.LiveSetting="Polite"/>
              <TextBlock x:Name="SearchHistoryEmptyText" DockPanel.Dock="Top" Text="{DynamicResource UiNoRecentSearches}" Margin="12,8"
                         Foreground="{StaticResource TextTertiary}" FontSize="12" Visibility="Collapsed"/>
              <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MaxHeight="250">
                <ListBox x:Name="SearchHistoryList" AutomationProperties.Name="Shared search history"
                         Background="Transparent" BorderThickness="0" Padding="0" SelectionMode="Single"
                         SelectionChanged="SearchHistoryList_SelectionChanged" PreviewKeyDown="SearchHistoryList_PreviewKeyDown">
                  <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                      <Setter Property="Padding" Value="0"/>
                      <Setter Property="Background" Value="Transparent"/>
                      <Setter Property="BorderThickness" Value="0"/>
                    </Style>
                  </ListBox.ItemContainerStyle>
                  <ListBox.ItemTemplate>
                    <DataTemplate>
                      <Grid MinHeight="34">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*"/>
                          <ColumnDefinition Width="34"/>
                        </Grid.ColumnDefinitions>
                      <Button Grid.Column="0" Style="{StaticResource TransparentButton}" Tag="{Binding Query}" Click="SearchHistorySelect_Click"
                                Background="Transparent" BorderThickness="0" Padding="12,6,4,6"
                                Foreground="{StaticResource TextSecondary}" HorizontalContentAlignment="Left"
                                ToolTip="{Binding Query}" AutomationProperties.Name="{Binding Query, StringFormat={}Use search {0}}">
                          <TextBlock Text="{Binding Query}" TextTrimming="CharacterEllipsis" FontSize="12.5"/>
                        </Button>
                        <Button Grid.Column="1" Tag="{Binding Query}" Click="SearchHistoryDelete_Click" Style="{StaticResource IconButton}"
                                Content="×" FontSize="16" Padding="2" ToolTip="Remove from search history"
                                AutomationProperties.Name="{Binding Query, StringFormat={}Remove search {0}}"/>
                      </Grid>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
              </ScrollViewer>
            </DockPanel>
          </Border>
        </Popup>

        <!-- Guaranteed caption drag target. It remains available before any
             lower-priority header action is allowed to consume the width. -->
        <Border x:Name="HeaderDragRegion" Grid.Column="2" Background="Transparent" Cursor="SizeAll"
                WindowChrome.IsHitTestVisibleInChrome="True"
                PreviewMouseLeftButtonDown="WindowDragRegion_PreviewMouseLeftButtonDown"
                ToolTip="Drag to move · double-click to maximize or restore"
                AutomationProperties.Name="Window drag region"
                AutomationProperties.HelpText="Drag this grip to move or snap the window. Double-click to maximize or restore.">
          <StackPanel Width="24" VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False" Opacity="0.7">
            <Rectangle Height="1" Fill="{StaticResource TextTertiary}" Margin="0,0,0,3"/>
            <Rectangle Height="1" Fill="{StaticResource TextTertiary}" Margin="0,0,0,3"/>
            <Rectangle Height="1" Fill="{StaticResource TextTertiary}"/>
          </StackPanel>
        </Border>

        <!-- right cluster -->
        <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
          <Button x:Name="OpenAlbumsButton" Style="{StaticResource IconButton}" Foreground="{StaticResource Success}" ToolTip="Open shared Albums (B)" Click="OpenAlbums_Click" AutomationProperties.Name="Open shared Albums" WindowChrome.IsHitTestVisibleInChrome="True">
            <Path Data="M12,5 v14 M5,12 h14" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="2" Stretch="Uniform" Width="17" Height="17"/>
          </Button>
          <Button x:Name="OpenEnhancementJobsButton" Style="{StaticResource GhostButton}" Height="32" MinWidth="70" Padding="9,0" Margin="4,0,4,0"
                  Click="OpenEnhancementJobs_Click" ToolTip="Open AI enhancement jobs" AutomationProperties.Name="Open AI enhancement jobs"
                  WindowChrome.IsHitTestVisibleInChrome="True">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="{DynamicResource UiJobs}"/>
              <TextBlock x:Name="OpenEnhancementJobsShortcutHintText" Text="[J]" Margin="5,0,0,0" Foreground="{StaticResource TextTertiary}"/>
            </StackPanel>
          </Button>
          <Button x:Name="ViewerShortcutsButton" Style="{StaticResource GhostButton}" Height="32" MinWidth="72" Padding="9,0" Margin="0,0,4,0"
                  Content="{DynamicResource UiShortcuts}" Click="OpenShortcuts_Click" ToolTip="{DynamicResource UiShortcutsToolTip}" AutomationProperties.Name="Open keyboard shortcuts"
                  WindowChrome.IsHitTestVisibleInChrome="True"/>
          <Button x:Name="OpenAppSettingsButton" Style="{StaticResource IconButton}" Click="OpenAppSettings_Click" ToolTip="{DynamicResource UiSettingsToolTip}" AutomationProperties.Name="App settings" WindowChrome.IsHitTestVisibleInChrome="True">
            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE713;" Foreground="{StaticResource TextSecondary}" FontSize="14"/>
          </Button>
          <Button x:Name="ToggleRight" Style="{StaticResource IconButtonActive}" Click="ToggleRight_Click" ToolTip="Hide right panel" AutomationProperties.Name="Toggle right panel" WindowChrome.IsHitTestVisibleInChrome="True">
            <Path Data="M3,4 h18 v16 h-18 z M15,4 v16" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.8" Stretch="Uniform" Width="18" Height="18"/>
          </Button>
          <Rectangle Width="1" Height="22" Fill="{StaticResource GlassBorder}" Margin="8,0"/>

          <!-- window caption buttons -->
          <Button Style="{StaticResource CaptionButton}" Click="Minimize_Click" ToolTip="Minimize to notification area while AI processing continues" AutomationProperties.Name="Minimize while AI processing continues" WindowChrome.IsHitTestVisibleInChrome="True">
            <Rectangle Width="11" Height="1.4" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
          </Button>
          <Button x:Name="MaxButton" Style="{StaticResource CaptionButton}" Click="Maximize_Click" ToolTip="Maximize" AutomationProperties.Name="Maximize window" WindowChrome.IsHitTestVisibleInChrome="True">
            <Path x:Name="MaximizeIcon" Data="M4,4 H20 V20 H4 Z"
                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                  StrokeThickness="1.5" Fill="Transparent" Stretch="Uniform" Width="12" Height="12"/>
          </Button>
          <Button Style="{StaticResource CloseButton}" Click="Close_Click" ToolTip="Close" AutomationProperties.Name="Close window" WindowChrome.IsHitTestVisibleInChrome="True">
            <Path Data="M2,2 L12,12 M12,2 L2,12" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.4" Width="12" Height="12" Stretch="Uniform"/>
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <!-- ═══════════════ Body ═══════════════ -->
    <Grid x:Name="WorkbenchLayout" Grid.Row="1">
      <Grid.RowDefinitions>
        <RowDefinition x:Name="WorkbenchMainRow" Height="*"/>
        <RowDefinition x:Name="WorkbenchPreviewSplitterRow" Height="0"/>
        <RowDefinition x:Name="WorkbenchPreviewRow" Height="0"/>
      </Grid.RowDefinitions>
      <Grid.ColumnDefinitions>
        <ColumnDefinition x:Name="SidebarCol" Width="300" MinWidth="272" MaxWidth="480"/>
        <ColumnDefinition Width="*" MinWidth="320"/>
        <ColumnDefinition x:Name="RightSplitterCol" Width="6"/>
        <ColumnDefinition x:Name="RightCol" Width="340" MinWidth="320" MaxWidth="420"/>
      </Grid.ColumnDefinitions>

      <!-- ─────── Sidebar ─────── -->
      <Border Grid.Row="0" Grid.Column="0" Grid.RowSpan="3" x:Name="Sidebar" Background="{StaticResource BgSecondary}" BorderBrush="{StaticResource GlassBorder}" BorderThickness="0,0,1,0">
        <Grid>
        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <ScrollViewer x:Name="SidebarScrollViewer" Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel>

            <!-- Folder -->
            <Border Padding="16,14,16,12" BorderBrush="{DynamicResource DividerSubtleBrush}" BorderThickness="0,0,0,1">
              <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                  <Path Data="M22,19 a2,2 0 0 1 -2,2 H4 a2,2 0 0 1 -2,-2 V5 a2,2 0 0 1 2,-2 h5 l2,3 h9 a2,2 0 0 1 2,2 z" Stroke="{StaticResource TextTertiary}" StrokeThickness="1.8" Stretch="Uniform" Width="14" Height="14" Margin="0,0,6,0"/>
                  <TextBlock Text="FOLDER" Style="{StaticResource SectionHeader}"/>
                </StackPanel>
                <TextBlock x:Name="FolderPathText" Text="D:\SD\outputs  (+3)" Foreground="{StaticResource TextPrimary}" FontSize="13" FontWeight="Medium" TextTrimming="CharacterEllipsis" Margin="0,0,0,3"/>
                <TextBlock x:Name="FolderCountText" Text="12,480 images indexed" Foreground="{StaticResource TextTertiary}" FontSize="11.5" Margin="0,0,0,3"/>
                <TextBlock x:Name="MetadataIndexStatusText" Text="" Foreground="{StaticResource TextTertiary}" FontSize="10.5" Margin="0,0,0,3" TextWrapping="Wrap" Visibility="Collapsed"
                           AutomationProperties.Name="Prompt metadata index status"/>
                <ProgressBar x:Name="MetadataIndexProgressBar" Height="3" Minimum="0" Maximum="100" Value="0" Margin="0,0,0,7" Visibility="Collapsed"
                             AutomationProperties.Name="Prompt metadata index progress"/>
                <WrapPanel>
                  <Button x:Name="SidebarAddFolderButton" Style="{StaticResource SidebarLink}" Content="{DynamicResource UiAddFolder}" Margin="0,0,14,4" Click="AddFolderToViewer_Click"/>
                  <Button x:Name="SidebarChangeFolderButton" Style="{StaticResource SidebarLink}" Content="{DynamicResource UiChangeFolder}" Margin="0,0,0,4" Click="ChangeFolderSet_Click"/>
                </WrapPanel>
              </StackPanel>
            </Border>

            <!-- Filters -->
            <Border Padding="16,14,16,12" BorderBrush="{DynamicResource DividerSubtleBrush}" BorderThickness="0,0,0,1">
              <StackPanel>
                <TextBlock Text="FILTERS" Style="{StaticResource SectionHeader}" Margin="0,0,0,8"/>
                <TextBlock x:Name="FavoriteFilterGroupTitle" Text="{DynamicResource UiFavoriteFilterGroupTitle}" Foreground="{StaticResource TextSecondary}" FontSize="11.5" FontWeight="SemiBold" Margin="0,0,0,7"/>
                <CheckBox x:Name="FavoriteOnlyFilter" Content="{DynamicResource UiFavoritesOnly}" Foreground="{StaticResource TextSecondary}" FontSize="12.5" Margin="0,0,0,9" Checked="FavoriteFilter_Changed" Unchecked="FavoriteFilter_Changed"/>
                <CheckBox x:Name="UnfavoriteOnlyFilter" Content="{DynamicResource UiUnratedOnly}" Foreground="{StaticResource TextSecondary}" FontSize="12.5" Margin="0,0,0,9" Checked="FavoriteFilter_Changed" Unchecked="FavoriteFilter_Changed"/>
                <Grid x:Name="OriginalFavoriteFilterRow" Margin="0,0,0,5">
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                  </Grid.RowDefinitions>
                  <TextBlock x:Name="OriginalFavoriteFilterTitle" Grid.Row="0" Text="{DynamicResource UiOriginalFavoriteFilterTitle}" Foreground="{StaticResource TextTertiary}" FontSize="10.5" FontWeight="SemiBold" Margin="0,0,0,4"/>
                  <UniformGrid x:Name="FavoriteLevelFilterPanel" Grid.Row="1" Columns="3">
                    <CheckBox x:Name="FavoriteLevel0Filter" Style="{StaticResource FavoriteLevelPill}" Content="Lv 0" Tag="0" Checked="FavoriteLevelFilter_Changed" Unchecked="FavoriteLevelFilter_Changed"/>
                    <CheckBox x:Name="FavoriteLevel1Filter" Style="{StaticResource FavoriteLevelPill}" Content="Lv 1" Tag="1" Checked="FavoriteLevelFilter_Changed" Unchecked="FavoriteLevelFilter_Changed"/>
                    <CheckBox x:Name="FavoriteLevel2Filter" Style="{StaticResource FavoriteLevelPill}" Content="Lv 2" Tag="2" Checked="FavoriteLevelFilter_Changed" Unchecked="FavoriteLevelFilter_Changed"/>
                    <CheckBox x:Name="FavoriteLevel3Filter" Style="{StaticResource FavoriteLevelPill}" Content="Lv 3" Tag="3" Checked="FavoriteLevelFilter_Changed" Unchecked="FavoriteLevelFilter_Changed"/>
                    <CheckBox x:Name="FavoriteLevel4Filter" Style="{StaticResource FavoriteLevelPill}" Content="Lv 4" Tag="4" Checked="FavoriteLevelFilter_Changed" Unchecked="FavoriteLevelFilter_Changed"/>
                    <CheckBox x:Name="FavoriteLevel5Filter" Style="{StaticResource FavoriteLevelPill}" Content="Lv 5" Tag="5" Checked="FavoriteLevelFilter_Changed" Unchecked="FavoriteLevelFilter_Changed"/>
                  </UniformGrid>
                </Grid>
                <TextBlock x:Name="FavoriteFilterSummary" Visibility="Collapsed"/>
                <Grid x:Name="PhotorealFavoriteFilterRow" Margin="0,0,0,5">
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                  </Grid.RowDefinitions>
                  <TextBlock x:Name="PhotorealFavoriteFilterTitle" Grid.Row="0" Text="{DynamicResource UiPhotorealFavoriteFilterTitle}" Foreground="{StaticResource TextTertiary}" FontSize="10.5" FontWeight="SemiBold" Margin="0,0,0,4"/>
                  <UniformGrid x:Name="PhotorealFavoriteLevelFilterPanel" Grid.Row="1" Columns="3">
                    <CheckBox x:Name="PhotorealFavoriteLevel0Filter" Style="{StaticResource FavoriteLevelPill}" Content="Lv 0" Tag="0" Checked="PhotorealFavoriteLevelFilter_Changed" Unchecked="PhotorealFavoriteLevelFilter_Changed" AutomationProperties.HelpText="{DynamicResource UiPhotorealFavoriteLevelZeroHelp}"/>
                    <CheckBox x:Name="PhotorealFavoriteLevel1Filter" Style="{StaticResource FavoriteLevelPill}" Content="Lv 1" Tag="1" Checked="PhotorealFavoriteLevelFilter_Changed" Unchecked="PhotorealFavoriteLevelFilter_Changed" AutomationProperties.HelpText="{DynamicResource UiPhotorealFavoriteFilterHelp}"/>
                    <CheckBox x:Name="PhotorealFavoriteLevel2Filter" Style="{StaticResource FavoriteLevelPill}" Content="Lv 2" Tag="2" Checked="PhotorealFavoriteLevelFilter_Changed" Unchecked="PhotorealFavoriteLevelFilter_Changed" AutomationProperties.HelpText="{DynamicResource UiPhotorealFavoriteFilterHelp}"/>
                    <CheckBox x:Name="PhotorealFavoriteLevel3Filter" Style="{StaticResource FavoriteLevelPill}" Content="Lv 3" Tag="3" Checked="PhotorealFavoriteLevelFilter_Changed" Unchecked="PhotorealFavoriteLevelFilter_Changed" AutomationProperties.HelpText="{DynamicResource UiPhotorealFavoriteFilterHelp}"/>
                    <CheckBox x:Name="PhotorealFavoriteLevel4Filter" Style="{StaticResource FavoriteLevelPill}" Content="Lv 4" Tag="4" Checked="PhotorealFavoriteLevelFilter_Changed" Unchecked="PhotorealFavoriteLevelFilter_Changed" AutomationProperties.HelpText="{DynamicResource UiPhotorealFavoriteFilterHelp}"/>
                    <CheckBox x:Name="PhotorealFavoriteLevel5Filter" Style="{StaticResource FavoriteLevelPill}" Content="Lv 5" Tag="5" Checked="PhotorealFavoriteLevelFilter_Changed" Unchecked="PhotorealFavoriteLevelFilter_Changed" AutomationProperties.HelpText="{DynamicResource UiPhotorealFavoriteFilterHelp}"/>
                  </UniformGrid>
                </Grid>
                <TextBlock x:Name="PhotorealFavoriteFilterSummary" Visibility="Collapsed"/>
                <Grid x:Name="VideoFavoriteFilterRow" Margin="0,0,0,6">
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                  </Grid.RowDefinitions>
                  <TextBlock x:Name="VideoFavoriteFilterTitle" Grid.Row="0" Text="{DynamicResource UiVideoFavoriteFilterTitle}" Foreground="{StaticResource TextTertiary}" FontSize="10.5" FontWeight="SemiBold" Margin="0,0,0,4" ToolTip="{DynamicResource UiVideoFavoriteFilterHelp}" AutomationProperties.HelpText="{DynamicResource UiVideoFavoriteFilterHelp}"/>
                  <UniformGrid x:Name="VideoFavoriteLevelFilterPanel" Grid.Row="1" Columns="3">
                    <CheckBox x:Name="VideoFavoriteLevel0Filter" Style="{StaticResource FavoriteLevelPill}" Content="Lv 0" Tag="0" Checked="VideoFavoriteLevelFilter_Changed" Unchecked="VideoFavoriteLevelFilter_Changed" AutomationProperties.HelpText="{DynamicResource UiVideoFavoriteLevelZeroHelp}"/>
                    <CheckBox x:Name="VideoFavoriteLevel1Filter" Style="{StaticResource FavoriteLevelPill}" Content="Lv 1" Tag="1" Checked="VideoFavoriteLevelFilter_Changed" Unchecked="VideoFavoriteLevelFilter_Changed" AutomationProperties.HelpText="{DynamicResource UiVideoFavoriteFilterHelp}"/>
                    <CheckBox x:Name="VideoFavoriteLevel2Filter" Style="{StaticResource FavoriteLevelPill}" Content="Lv 2" Tag="2" Checked="VideoFavoriteLevelFilter_Changed" Unchecked="VideoFavoriteLevelFilter_Changed" AutomationProperties.HelpText="{DynamicResource UiVideoFavoriteFilterHelp}"/>
                    <CheckBox x:Name="VideoFavoriteLevel3Filter" Style="{StaticResource FavoriteLevelPill}" Content="Lv 3" Tag="3" Checked="VideoFavoriteLevelFilter_Changed" Unchecked="VideoFavoriteLevelFilter_Changed" AutomationProperties.HelpText="{DynamicResource UiVideoFavoriteFilterHelp}"/>
                    <CheckBox x:Name="VideoFavoriteLevel4Filter" Style="{StaticResource FavoriteLevelPill}" Content="Lv 4" Tag="4" Checked="VideoFavoriteLevelFilter_Changed" Unchecked="VideoFavoriteLevelFilter_Changed" AutomationProperties.HelpText="{DynamicResource UiVideoFavoriteFilterHelp}"/>
                    <CheckBox x:Name="VideoFavoriteLevel5Filter" Style="{StaticResource FavoriteLevelPill}" Content="Lv 5" Tag="5" Checked="VideoFavoriteLevelFilter_Changed" Unchecked="VideoFavoriteLevelFilter_Changed" AutomationProperties.HelpText="{DynamicResource UiVideoFavoriteFilterHelp}"/>
                  </UniformGrid>
                </Grid>
                <TextBlock x:Name="VideoFavoriteFilterSummary" Visibility="Collapsed"/>
                <CheckBox x:Name="EnhancedOnlyFilter" Content="AI高画質化済みのみ" Foreground="{StaticResource TextSecondary}" FontSize="12.5" Margin="0,0,0,6" Checked="Filter_Changed" Unchecked="Filter_Changed" ToolTip="AI高画質化の完了画像だけを表示"/>
                <CheckBox x:Name="UnenhancedOnlyFilter" Content="未高画質化のみ" Foreground="{StaticResource TextSecondary}" FontSize="12.5" Margin="0,0,0,6" Checked="Filter_Changed" Unchecked="Filter_Changed" ToolTip="まだAI高画質化されていない画像だけを表示"/>
                <CheckBox x:Name="PhotorealOnlyFilter" Content="AI実写化済みのみ" Foreground="{StaticResource TextSecondary}" FontSize="12.5" Margin="0,0,0,6" Checked="Filter_Changed" Unchecked="Filter_Changed" ToolTip="AI実写化の完了画像だけを表示"/>
                <CheckBox x:Name="UnphotorealOnlyFilter" Content="未実写化のみ" Foreground="{StaticResource TextSecondary}" FontSize="12.5" Margin="0,0,0,6" Checked="Filter_Changed" Unchecked="Filter_Changed" ToolTip="まだAI実写化されていない画像だけを表示"/>
                <CheckBox x:Name="VideoOnlyFilter" Content="動画化済みのみ" Foreground="{StaticResource TextSecondary}" FontSize="12.5" Margin="0,0,0,6" Checked="Filter_Changed" Unchecked="Filter_Changed" ToolTip="動画が完成している元画像だけを表示。この表示中に画像を開くと動画を自動再生します。"/>
                <CheckBox x:Name="UnseenOnlyFilter" Content="Unseen only" Foreground="{StaticResource TextSecondary}" FontSize="12.5" Margin="0,0,0,8" Checked="Filter_Changed" Unchecked="Filter_Changed"/>
                <CheckBox x:Name="ShowUnseenDots" Content="Unseen dots" Foreground="{StaticResource TextSecondary}" FontSize="12.5" Margin="0,0,0,8" Checked="ShowUnseenDots_Changed" Unchecked="ShowUnseenDots_Changed" AutomationProperties.Name="Show unseen dots in gallery" AutomationProperties.HelpText="Changes dot visibility only. Seen history is not changed."/>
                <TextBlock Text="DATE" Foreground="{StaticResource TextTertiary}" FontSize="9.5" FontWeight="Bold" Margin="0,0,0,4"/>
                <Grid Margin="0,2,0,4">
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                  </Grid.RowDefinitions>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="44"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock Grid.Row="0" Grid.Column="0" Text="From" Foreground="{StaticResource TextTertiary}" FontSize="11.5" VerticalAlignment="Center" Margin="0,0,6,4"/>
                  <DatePicker x:Name="DateFromInput" Style="{StaticResource DarkDatePicker}" Grid.Row="0" Grid.Column="1" Height="26" Margin="0,0,0,4" SelectedDateFormat="Short" SelectedDateChanged="ManualDateRange_Changed" AutomationProperties.Name="From date"/>
                  <TextBlock Grid.Row="1" Grid.Column="0" Text="To" Foreground="{StaticResource TextTertiary}" FontSize="11.5" VerticalAlignment="Center" Margin="0,0,6,0"/>
                  <DatePicker x:Name="DateToInput" Style="{StaticResource DarkDatePicker}" Grid.Row="1" Grid.Column="1" Height="26" SelectedDateFormat="Short" SelectedDateChanged="ManualDateRange_Changed" AutomationProperties.Name="To date"/>
                </Grid>
                <TextBlock x:Name="DateFilterSummary" Text="No date filter" Foreground="{StaticResource TextTertiary}" FontSize="11.5" TextWrapping="Wrap"/>
              </StackPanel>
            </Border>

            <!-- Folders -->
            <Border Padding="16,14,16,12" BorderBrush="{DynamicResource DividerSubtleBrush}" BorderThickness="0,0,0,1">
              <StackPanel>
                <local:ExpandCollapseButton x:Name="FoldersSectionToggle" Style="{StaticResource SidebarLink}" Click="ToggleFoldersSection_Click" HorizontalAlignment="Left" Margin="0,0,0,8" AutomationProperties.Name="Toggle folders section"><StackPanel Orientation="Horizontal"><TextBlock Text="FOLDERS" Style="{StaticResource SectionHeader}"/><TextBlock x:Name="FoldersSectionToggleText" Text="−" Margin="8,0,0,0"/></StackPanel></local:ExpandCollapseButton>
                <StackPanel x:Name="FoldersSectionContent">
                <WrapPanel Margin="0,0,0,8">
                  <Button Style="{StaticResource SidebarLink}" Content="{DynamicResource UiShowAll}" Margin="0,0,12,0" Click="ShowAllFolderBuckets_Click" AutomationProperties.Name="Show all folder buckets"/>
                  <Button Style="{StaticResource SidebarLink}" Content="{DynamicResource UiHideAll}" Margin="0,0,12,0" Click="HideAllFolderBuckets_Click" AutomationProperties.Name="Hide all folder buckets"/>
                  <Button Style="{StaticResource SidebarLink}" Content="{DynamicResource UiInvert}" Margin="0,0,12,0" Click="InvertFolderBuckets_Click" AutomationProperties.Name="Invert folder bucket visibility"/>
                  <Button x:Name="ShowSelectedFolderBucketsButton" Style="{StaticResource SidebarLink}" Content="{DynamicResource UiShowSelected}" Margin="0,0,12,0" Click="ShowSelectedFolderBuckets_Click" AutomationProperties.Name="Show selected folder buckets"/>
                  <Button x:Name="HideSelectedFolderBucketsButton" Style="{StaticResource SidebarLink}" Content="{DynamicResource UiHideSelected}" Click="HideSelectedFolderBuckets_Click" AutomationProperties.Name="Hide selected folder buckets"/>
                </WrapPanel>
                <TextBlock x:Name="FolderBucketStatusText" Text="No folder buckets loaded" Foreground="{StaticResource TextTertiary}" FontSize="11.5" Margin="0,0,0,6" TextWrapping="Wrap"/>
                <ListBox x:Name="SidebarFolderSetList" MaxHeight="180" SelectionMode="Extended" SelectionChanged="FolderBucketSelectionChanged" Background="Transparent" BorderThickness="0" Padding="0" AutomationProperties.Name="Folder buckets" AutomationProperties.HelpText="Use Ctrl to toggle buckets and Shift to select a range.">
                  <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                      <Setter Property="Padding" Value="0"/>
                      <Setter Property="Margin" Value="0"/>
                      <Setter Property="Background" Value="Transparent"/>
                      <Setter Property="BorderThickness" Value="0"/>
                      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    </Style>
                  </ListBox.ItemContainerStyle>
                  <ListBox.ItemTemplate>
                    <DataTemplate>
                      <Border CornerRadius="8" Background="{StaticResource SoftFill}" BorderThickness="1" Padding="7,5" Margin="0,0,0,4" Opacity="{Binding Opacity}">
                        <Border.Style>
                          <Style TargetType="Border">
                            <Setter Property="BorderBrush" Value="{StaticResource GlassBorder}"/>
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter Property="BorderBrush" Value="{StaticResource GlassBorderHover}"/>
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </Border.Style>
                        <Grid>
                          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                          <StackPanel Grid.Column="0">
                            <DockPanel>
                              <TextBlock DockPanel.Dock="Right" Text="{Binding CountText}" Foreground="{StaticResource TextTertiary}" FontSize="10.5" Margin="8,0,0,0"/>
                              <TextBlock Text="{Binding Label}" Foreground="{StaticResource TextSecondary}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                            </DockPanel>
                            <TextBlock Text="{Binding Path}" Foreground="{StaticResource TextTertiary}" FontSize="10.5" TextTrimming="CharacterEllipsis"/>
                          </StackPanel>
                          <Button Grid.Column="1" Style="{StaticResource SidebarLink}" Content="{Binding VisibilityText}" Tag="{Binding}" Click="ToggleFolderBucket_Click" Margin="8,0,0,0" AutomationProperties.Name="Toggle folder bucket visibility"/>
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
                </StackPanel>
              </StackPanel>
            </Border>

            <!-- Sort -->
            <Border Padding="16,14,16,12" BorderBrush="{DynamicResource DividerSubtleBrush}" BorderThickness="0,0,0,1">
              <StackPanel>
                <TextBlock Text="SORT" Style="{StaticResource SectionHeader}" Margin="0,0,0,8"/>
                <Border CornerRadius="8" Background="{StaticResource BgTertiary}" BorderBrush="{StaticResource GlassBorder}" BorderThickness="1" Padding="3">
                  <UniformGrid Columns="2">
                    <RadioButton x:Name="SortModifiedNewest" Style="{StaticResource Seg}" GroupName="sort" Content="Modified new" IsChecked="True" Checked="SortModifiedNewest_Checked"/>
                    <RadioButton x:Name="SortModifiedOldest" Style="{StaticResource Seg}" GroupName="sort" Content="Modified old" Checked="SortModifiedOldest_Checked"/>
                    <RadioButton x:Name="SortCreatedNewest" Style="{StaticResource Seg}" GroupName="sort" Content="Created new" Checked="SortCreatedNewest_Checked"/>
                    <RadioButton x:Name="SortCreatedOldest" Style="{StaticResource Seg}" GroupName="sort" Content="Created old" Checked="SortCreatedOldest_Checked"/>
                    <RadioButton x:Name="SortUpscaleNewest" Style="{StaticResource Seg}" GroupName="sort" Content="HQ済み" Checked="SortUpscaleNewest_Checked" ToolTip="高画質化が最近完了した順"/>
                    <RadioButton x:Name="SortUpscaleQueuedNewest" Style="{StaticResource Seg}" GroupName="sort" Content="HQ追加済み" Checked="SortUpscaleQueuedNewest_Checked" ToolTip="高画質化を最近キューへ追加した順"/>
                    <RadioButton x:Name="SortPhotorealNewest" Style="{StaticResource Seg}" GroupName="sort" Content="実写化済み" Checked="SortPhotorealNewest_Checked" ToolTip="実写化が最近完了した順"/>
                    <RadioButton x:Name="SortPhotorealQueuedNewest" Style="{StaticResource Seg}" GroupName="sort" Content="実写追加済み" Checked="SortPhotorealQueuedNewest_Checked" ToolTip="実写化を最近キューへ追加した順"/>
                    <RadioButton x:Name="SortVideoNewest" Style="{StaticResource Seg}" GroupName="sort" Content="動画化済み" Checked="SortVideoNewest_Checked" ToolTip="動画化が最近完了した順"/>
                    <RadioButton x:Name="SortVideoQueuedNewest" Style="{StaticResource Seg}" GroupName="sort" Content="動画追加済み" Checked="SortVideoQueuedNewest_Checked" ToolTip="動画化を最近キューへ追加した順"/>
                    <RadioButton x:Name="SortFavoriteChangedNewest" Style="{StaticResource Seg}" GroupName="sort" Content="Fav touched" Checked="SortFavoriteChangedNewest_Checked" ToolTip="Most recently changed favorite first, including clearing a favorite"/>
                    <RadioButton x:Name="SortName" Style="{StaticResource Seg}" GroupName="sort" Content="Name" Checked="SortName_Checked"/>
                    <RadioButton x:Name="SortRandom" Style="{StaticResource Seg}" GroupName="sort" Content="Random" Checked="SortRandom_Checked"/>
                  </UniformGrid>
                </Border>
                <Button x:Name="ReshuffleSortButton" Style="{StaticResource SidebarLink}" Content="{DynamicResource UiReshuffle}" Click="ReshuffleSort_Click" Margin="2,8,0,0" HorizontalAlignment="Left"/>
              </StackPanel>
            </Border>

            <!-- Display -->
            <Border Padding="16,14,16,16">
              <StackPanel>
                <TextBlock Text="DISPLAY" Style="{StaticResource SectionHeader}" Margin="0,0,0,10"/>
                <Grid Margin="0,0,0,10">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="46"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                  <TextBlock Grid.Column="0" Text="Mode" Foreground="{StaticResource TextTertiary}" FontSize="11.5" VerticalAlignment="Center"/>
                  <Border Grid.Column="1" CornerRadius="8" Background="{StaticResource BgTertiary}" BorderBrush="{StaticResource GlassBorder}" BorderThickness="1" Padding="3">
                    <UniformGrid Rows="1">
                      <RadioButton x:Name="ModeGrid" Style="{StaticResource Seg}" GroupName="mode" Content="Grid" IsChecked="True" Checked="ModeGrid_Checked"/>
                      <RadioButton x:Name="ModeList" Style="{StaticResource Seg}" GroupName="mode" Content="List" Checked="ModeList_Checked"/>
                    </UniformGrid>
                  </Border>
                </Grid>
                <Grid Margin="0,0,0,10">
                  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                  <TextBlock Grid.Row="0" Text="Style" Foreground="{StaticResource TextTertiary}" FontSize="11.5" Margin="0,0,0,4"/>
                  <Border Grid.Row="1" CornerRadius="8" Background="{StaticResource BgTertiary}" BorderBrush="{StaticResource GlassBorder}" BorderThickness="1" Padding="3">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.1*"/>
                        <ColumnDefinition Width="1.1*"/>
                        <ColumnDefinition Width="0.8*"/>
                      </Grid.ColumnDefinitions>
                      <RadioButton x:Name="StyleStandard" Grid.Column="0" Style="{StaticResource Seg}" GroupName="style" Content="Standard" IsChecked="True" Checked="StyleStandard_Checked"/>
                      <RadioButton x:Name="StyleCompact" Grid.Column="1" Style="{StaticResource Seg}" GroupName="style" Content="Compact" Checked="StyleCompact_Checked"/>
                      <RadioButton x:Name="StylePoster" Grid.Column="2" Style="{StaticResource Seg}" GroupName="style" Content="Poster" Checked="StylePoster_Checked"/>
                    </Grid>
                  </Border>
                </Grid>
                <Grid Margin="0,0,0,10">
                  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                  <TextBlock Grid.Row="0" Text="Aspect" Foreground="{StaticResource TextTertiary}" FontSize="11.5" Margin="0,0,0,4"/>
                  <Border Grid.Row="1" CornerRadius="8" Background="{StaticResource BgTertiary}" BorderBrush="{StaticResource GlassBorder}" BorderThickness="1" Padding="3">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.3*"/>
                        <ColumnDefinition Width="0.85*"/>
                        <ColumnDefinition Width="0.85*"/>
                      </Grid.ColumnDefinitions>
                      <RadioButton x:Name="AspectOriginalButton" Grid.Column="0" Style="{StaticResource Seg}" GroupName="aspect" Content="Original" IsChecked="True" Checked="AspectOriginal_Checked"/>
