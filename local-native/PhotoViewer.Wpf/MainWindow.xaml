                      </Rectangle.Fill>
                    </Rectangle>
                  </DockPanel>
                </DataTemplate>
              </GroupStyle.HeaderTemplate>
            </GroupStyle>
          </ListBox.GroupStyle>
        </local:VirtualizedGalleryListBox>
        <Border x:Name="ViewerFolderDropOverlay" Visibility="Collapsed" IsHitTestVisible="True"
