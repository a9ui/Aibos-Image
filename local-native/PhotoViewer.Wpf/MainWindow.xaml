            <Button x:Name="ModalZoomResetButton" Style="{StaticResource GhostButton}" Content="Fit" ToolTip="Reset to fit (0)" AutomationProperties.Name="Fit image to preview" Height="32" MinWidth="48" Padding="7,0" Margin="4,0" Click="ModalFit_Click" Visibility="Collapsed"/>
            <Button x:Name="ModalZoomInButton" Style="{StaticResource GhostButton}" Content="+" ToolTip="Zoom in (+)" AutomationProperties.Name="Zoom image in" Height="32" MinWidth="32" Padding="6,0" Margin="4,0,0,0" Click="ModalZoomIn_Click" Visibility="Collapsed"/>
