            PreviewMouseMove="ModalImage_MouseMove"
            PreviewMouseLeftButtonUp="ModalImage_MouseLeftButtonUp"
            LostMouseCapture="ModalImage_LostMouseCapture"
            PreviewMouseRightButtonUp="ModalVideoEditV2_RightClick"
            ContextMenuOpening="Modal_ContextMenuOpening" Panel.ZIndex="0">
        <Grid.ContextMenu>
          <ContextMenu x:Name="ModalContextMenu" AutomationProperties.Name="Image actions">
            <MenuItem Header="Favorite +1" Click="ModalFavoriteIncrease_Click" AutomationProperties.Name="Increase favorite level"/>
