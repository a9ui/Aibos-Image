                        AutomationProperties.Name="Copy displayed generation metadata" AutomationProperties.HelpText="Copy the stored generation settings for the currently displayed version."/>
              </DockPanel>
              <TextBlock x:Name="ModalMetadataStatusText" Text="{DynamicResource UiNoPngMetadata}" Foreground="{StaticResource TextTertiary}" FontSize="12" TextWrapping="Wrap"/>
            </StackPanel>
          </ScrollViewer>
