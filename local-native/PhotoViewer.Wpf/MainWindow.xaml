                    Content="最後に表示した画像バージョンを一覧サムネイルに使う"
                    Foreground="{StaticResource TextSecondary}" Margin="0,4,0,4"
                    Checked="ThumbnailVersionPreference_Changed"
                    Unchecked="ThumbnailVersionPreference_Changed"
                    AutomationProperties.Name="Use the last displayed image version for gallery thumbnails"
                    AutomationProperties.HelpText="OFFでは一覧サムネイルをOriginalに固定します。画像ごとの最後の表示版はWPFの現在のセッション内だけで保持します。"/>
          <TextBlock Text="OFFではOriginalを表示。動画を見た場合も、直前に表示した画像版を維持します。"
                     Foreground="{StaticResource TextTertiary}" FontSize="11.5" TextWrapping="Wrap" Margin="24,0,0,12"/>
          <TextBlock Text="STATUS BORDERS" Foreground="{StaticResource TextTertiary}" FontSize="10.5" FontWeight="SemiBold" Margin="0,0,0,6"/>
          <Grid Margin="0,0,0,6">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="142"/><ColumnDefinition Width="28"/></Grid.ColumnDefinitions>
            <CheckBox x:Name="FavoriteThumbnailBorderCheckBox" Grid.Row="0" Grid.Column="0" Content="{DynamicResource UiFavoriteBorder}" Foreground="{StaticResource TextSecondary}" Margin="0,4,8,5" Checked="ThumbnailBorderEnabled_Changed" Unchecked="ThumbnailBorderEnabled_Changed" AutomationProperties.Name="Show favorite thumbnail border"/>
            <TextBox x:Name="FavoriteThumbnailBorderColorTextBox" Grid.Row="0" Grid.Column="1" Text="#facc15" MaxLength="7" Margin="0,0,6,5" TextChanged="ThumbnailBorderColor_TextChanged" AutomationProperties.Name="Favorite thumbnail border color" AutomationProperties.HelpText="Six-digit hex color, for example #facc15"/>
            <Border x:Name="FavoriteThumbnailBorderColorPreview" Grid.Row="0" Grid.Column="2" Width="22" Height="22" CornerRadius="4" BorderBrush="{StaticResource GlassBorderHover}" BorderThickness="1" Background="#FACC15" VerticalAlignment="Center" Margin="0,0,0,5" IsHitTestVisible="False"/>
            <CheckBox x:Name="EnhancedThumbnailBorderCheckBox" Grid.Row="1" Grid.Column="0" Content="{DynamicResource UiAiEnhancedBorder}" Foreground="{StaticResource TextSecondary}" Margin="0,4,8,0" Checked="ThumbnailBorderEnabled_Changed" Unchecked="ThumbnailBorderEnabled_Changed" AutomationProperties.Name="Show AI-enhanced thumbnail border"/>
            <TextBlock Grid.Row="2" Grid.Column="0" Text="{DynamicResource UiAiBorderColor}" Foreground="{StaticResource TextTertiary}" FontSize="11.5" Margin="24,5,8,0"/>
            <TextBox x:Name="EnhancedThumbnailBorderColorTextBox" Grid.Row="2" Grid.Column="1" Text="#38bdf8" MaxLength="7" Margin="0,5,6,0" TextChanged="ThumbnailBorderColor_TextChanged" AutomationProperties.Name="AI-enhanced thumbnail border color" AutomationProperties.HelpText="Six-digit hex color, for example #38bdf8"/>
            <Border x:Name="EnhancedThumbnailBorderColorPreview" Grid.Row="2" Grid.Column="2" Width="22" Height="22" CornerRadius="4" BorderBrush="{StaticResource GlassBorderHover}" BorderThickness="1" VerticalAlignment="Center" Margin="0,5,0,0" IsHitTestVisible="False"/>
          </Grid>
          <TextBlock Text="{DynamicResource UiThumbnailBorderHelp}" Foreground="{StaticResource TextTertiary}" FontSize="11.5" TextWrapping="Wrap" Margin="24,0,0,8"/>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,4">
            <Button x:Name="ResetThumbnailBordersButton" Style="{StaticResource GhostButton}" Content="{DynamicResource UiResetBorders}" Click="ResetThumbnailBorders_Click" MinWidth="112" Margin="0,0,8,0" AutomationProperties.Name="Reset thumbnail borders to defaults"/>
            <Button x:Name="SaveThumbnailBordersButton" Style="{StaticResource GhostButton}" Content="{DynamicResource UiSaveBorders}" Click="SaveThumbnailBorders_Click" MinWidth="112" AutomationProperties.Name="Save thumbnail border settings"/>
          </StackPanel>
          <TextBlock x:Name="ThumbnailBordersStatusText" Foreground="{StaticResource TextTertiary}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,18" AutomationProperties.LiveSetting="Polite" AutomationProperties.Name="Thumbnail border settings status"/>
          <TextBlock x:Name="SharedDataSettingsHeading" Text="SHARED DATA" Foreground="{StaticResource TextTertiary}" FontSize="10.5" FontWeight="SemiBold" Margin="0,0,0,6" AutomationProperties.Name="Shared data storage section"/>
          <Border Background="{StaticResource BgTertiary}" BorderBrush="{StaticResource GlassBorder}" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,0,18">
            <StackPanel>
              <TextBlock x:Name="SharedDataModeText" Foreground="{StaticResource TextPrimary}" FontSize="12.5" FontWeight="SemiBold" TextWrapping="Wrap" AutomationProperties.Name="Shared data mode"/>
              <TextBlock x:Name="SharedDataDescriptionText" Foreground="{StaticResource TextTertiary}" FontSize="11.5" TextWrapping="Wrap" Margin="0,4,0,9" AutomationProperties.Name="Shared data description"/>
              <TextBlock Text="{DynamicResource UiDataLocation}" Foreground="{StaticResource TextTertiary}" FontSize="10.5" Margin="0,0,0,4"/>
              <TextBox x:Name="SharedDataRootTextBox" IsReadOnly="True" IsReadOnlyCaretVisible="True" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" TextWrapping="NoWrap" Padding="7,5" Background="{StaticResource BgPrimary}" BorderBrush="{StaticResource GlassBorder}" Foreground="{StaticResource TextSecondary}" AutomationProperties.Name="Current shared data location" AutomationProperties.HelpText="Read-only path used for shared durable data in this Aibos process."/>
              <Button x:Name="OpenSharedDataFolderButton" Style="{StaticResource GhostButton}" Content="{DynamicResource UiOpenDataFolder}" Click="OpenSharedDataFolder_Click" HorizontalAlignment="Left" MinWidth="132" Margin="0,8,0,0" AutomationProperties.Name="Open current shared data folder" AutomationProperties.HelpText="Opens the existing data folder without creating or changing files."/>
              <TextBlock x:Name="SharedDataStatusText" Foreground="{StaticResource TextTertiary}" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0" AutomationProperties.LiveSetting="Polite" AutomationProperties.Name="Shared data location status"/>
            </StackPanel>
          </Border>
          <TextBlock x:Name="KeyBindingsHeading" Text="KEYBOARD SHORTCUTS" Foreground="{StaticResource TextTertiary}" FontSize="10.5" FontWeight="SemiBold" Margin="0,0,0,6" AutomationProperties.Name="Keyboard shortcuts"/>
          <TextBlock Text="{DynamicResource UiKeyBindingsHelp}" Foreground="{StaticResource TextTertiary}" FontSize="11.5" TextWrapping="Wrap" Margin="0,0,0,10"/>
          <StackPanel x:Name="KeyBindingsPanel" AutomationProperties.Name="Editable key bindings"/>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,4">
            <Button x:Name="ResetKeyBindingsButton" Style="{StaticResource GhostButton}" Content="{DynamicResource UiResetToDefaults}" Click="ResetKeyBindings_Click" MinWidth="126" Margin="0,0,8,0" AutomationProperties.Name="Reset key bindings to defaults"/>
            <Button x:Name="SaveKeyBindingsButton" Style="{StaticResource GhostButton}" Content="{DynamicResource UiSaveKeyBindings}" Click="SaveKeyBindings_Click" MinWidth="126" AutomationProperties.Name="Save key bindings"/>
          </StackPanel>
          <TextBlock x:Name="KeyBindingsStatusText" Foreground="{StaticResource TextTertiary}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,18" AutomationProperties.LiveSetting="Polite" AutomationProperties.Name="Key binding status"/>
          <TextBlock x:Name="AboutSettingsHeading" Text="ABOUT / DIAGNOSTICS" Foreground="{StaticResource TextTertiary}" FontSize="10.5" FontWeight="SemiBold" Margin="0,0,0,6" AutomationProperties.Name="About and diagnostics section"/>
          <Border Background="{StaticResource BgTertiary}" BorderBrush="{StaticResource GlassBorder}" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,0,8">
            <StackPanel>
              <TextBlock x:Name="DiagnosticsText" Foreground="{StaticResource TextSecondary}" FontSize="11" TextWrapping="Wrap" AutomationProperties.Name="Read-only application diagnostics"/>
              <Button x:Name="CopyDiagnosticsButton" Style="{StaticResource GhostButton}" Content="{DynamicResource UiCopyDiagnostics}" Click="CopyDiagnostics_Click" HorizontalAlignment="Left" Margin="0,8,0,0" MinWidth="132" AutomationProperties.Name="Copy safe diagnostics" AutomationProperties.HelpText="Copies product, build, runtime, counts, and safety flags only. No paths or image metadata."/>
              <TextBlock x:Name="DiagnosticsStatusText" Foreground="{StaticResource TextTertiary}" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0" AutomationProperties.LiveSetting="Polite" AutomationProperties.Name="Diagnostics copy status"/>
            </StackPanel>
          </Border>
          </StackPanel>
          </ScrollViewer>
          <Button x:Name="AppSettingsDoneButton" Grid.Row="2" Grid.Column="1" Style="{StaticResource PrimaryButton}" Click="CloseAppSettings_Click" HorizontalAlignment="Right" MinWidth="82" Margin="0,10,16,12" AutomationProperties.Name="Done with app settings"><TextBlock Text="{DynamicResource UiDone}" Foreground="{StaticResource SelectionText}"/></Button>
        </Grid>
      </Border>
    </Grid>

    <!-- Delete confirmation: Cancel is deliberately the initial focus. -->
    <Grid x:Name="DeleteConfirmationDialog" Grid.RowSpan="3" Panel.ZIndex="600" Visibility="Collapsed" Background="{StaticResource BgPrimary}" AutomationProperties.Name="Move to Recycle Bin confirmation" AutomationProperties.HelpText="Confirm or cancel moving the selected source image to the Windows Recycle Bin.">
      <Border x:Name="DeleteConfirmationDialogSurface" Width="440" Padding="22" CornerRadius="12" Background="{StaticResource BgSecondary}" BorderBrush="{StaticResource GlassBorder}" BorderThickness="1" HorizontalAlignment="Center" VerticalAlignment="Center" KeyboardNavigation.TabNavigation="Cycle" KeyboardNavigation.ControlTabNavigation="Cycle">
        <StackPanel>
          <TextBlock Text="Move source to Recycle Bin?" Foreground="{StaticResource TextPrimary}" FontSize="17" FontWeight="SemiBold"/>
          <TextBlock x:Name="DeleteConfirmationText" Text="" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" Margin="0,10,0,12"/>
          <CheckBox x:Name="DoNotAskAgainCheckBox" Content="Do not ask again" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,16" AutomationProperties.Name="Do not ask again before deleting"/>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="DeleteCancelButton" Style="{StaticResource GhostButton}" Content="Cancel" Click="DeleteCancel_Click" MinWidth="82" Margin="0,0,8,0" IsDefault="True" AutomationProperties.Name="Cancel move to Recycle Bin"/>
            <Button x:Name="DeleteConfirmButton" Style="{StaticResource DangerButton}" Content="Move to Recycle Bin" Click="DeleteConfirm_Click" MinWidth="142" IsCancel="False" AutomationProperties.Name="Move selected image to Recycle Bin"/>
          </StackPanel>
        </StackPanel>
      </Border>
    </Grid>

    <Grid x:Name="DeleteStatusToast" Grid.RowSpan="3" Panel.ZIndex="400" Visibility="Hidden" IsHitTestVisible="True" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,66,0,0" AutomationProperties.Name="Aibos status notification">
      <Border Width="560" Padding="12,9" CornerRadius="4" Background="{StaticResource BgElevated}" BorderBrush="{StaticResource GlassBorder}" BorderThickness="1">
        <DockPanel LastChildFill="True">
          <Button x:Name="DeleteStatusDismissButton" DockPanel.Dock="Right" Style="{StaticResource IconButton}" Click="DismissDeleteStatus_Click" ToolTip="Dismiss" AutomationProperties.Name="Dismiss status notification" Width="28" Height="28"><Path Data="M18,6 L6,18 M6,6 L18,18" Stroke="{StaticResource TextSecondary}" StrokeThickness="1.7" Stretch="Uniform" Width="13" Height="13"/></Button>
          <Button x:Name="DeleteStatusRetryButton" DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="Retry" Click="RetryDelete_Click" Visibility="Collapsed" MinWidth="58" Height="28" Margin="0,0,8,0" AutomationProperties.Name="Retry the last recoverable action"/>
          <TextBox x:Name="DeleteStatusText" AutomationProperties.LiveSetting="Assertive"
                   AutomationProperties.Name="Selectable status notification text"
                   IsReadOnly="True" IsReadOnlyCaretVisible="True" Focusable="True"
                   Background="Transparent" BorderThickness="0" Padding="0"
                   Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap"
                   VerticalAlignment="Center" Margin="0,0,8,0"
                   />
        </DockPanel>
      </Border>
     </Grid>

    <Grid x:Name="EnhancementResultToast" Grid.RowSpan="3" Panel.ZIndex="410" Visibility="Collapsed" IsHitTestVisible="True" VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="0,0,20,20" AutomationProperties.Name="AI processing result notification" AutomationProperties.LiveSetting="Polite">
      <Border x:Name="EnhancementResultToastBorder" Width="370" Padding="13,11" CornerRadius="7" Background="{StaticResource BgElevated}" BorderBrush="{StaticResource Success}" BorderThickness="1">
        <DockPanel LastChildFill="True">
          <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Click="DismissEnhancementNotification_Click" ToolTip="閉じる" AutomationProperties.Name="Dismiss AI processing result notification" Width="28" Height="28" Margin="8,0,0,0"><Path Data="M18,6 L6,18 M6,6 L18,18" Stroke="{StaticResource TextSecondary}" StrokeThickness="1.7" Stretch="Uniform" Width="13" Height="13"/></Button>
          <StackPanel>
            <TextBlock x:Name="EnhancementNotificationTitleText" Foreground="{StaticResource TextPrimary}" FontWeight="SemiBold" FontSize="13" TextWrapping="Wrap"/>
            <TextBlock x:Name="EnhancementNotificationMessageText" Foreground="{StaticResource TextSecondary}" FontSize="11.5" TextWrapping="Wrap" Margin="0,4,0,0"/>
          </StackPanel>
        </DockPanel>
      </Border>
    </Grid>

    <Grid x:Name="Modal" Grid.RowSpan="3" Panel.ZIndex="300" Visibility="Collapsed" Background="{StaticResource BgPrimary}"
          Focusable="True" KeyboardNavigation.TabNavigation="Cycle" KeyboardNavigation.ControlTabNavigation="Cycle"
          MouseLeftButtonDown="ModalBackdrop_MouseLeftButtonDown"
          PreviewMouseDown="Modal_PreviewMouseDown" PreviewMouseUp="Modal_PreviewMouseUp"
          PreviewMouseMove="Modal_PreviewMouseMove" MouseLeave="Modal_MouseLeave"
          AutomationProperties.Name="Image preview dialog"
          AutomationProperties.HelpText="Preview the selected image or managed video. Click a video to play or pause, swipe up for full screen, use Left and Right to navigate, Escape to exit full screen or close, and Tab to move through preview controls.">
      <Grid.Resources>
        <DataTemplate x:Key="ModalFilmstripItemTemplate">
          <Grid Width="92" Height="64" ToolTip="{Binding FileName}" AutomationProperties.Name="{Binding FileName}">
            <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="LowQuality"/>
          </Grid>
        </DataTemplate>
        <Style x:Key="ModalFilmstripItemStyle" TargetType="ListBoxItem">
          <Setter Property="Margin" Value="0,0,8,0"/>
          <Setter Property="Padding" Value="0"/>
          <Setter Property="Background" Value="{StaticResource BgSecondary}"/>
          <Setter Property="BorderBrush" Value="Transparent"/>
          <Setter Property="BorderThickness" Value="2"/>
          <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
          <Setter Property="VerticalContentAlignment" Value="Stretch"/>
          <Setter Property="Template">
            <Setter.Value>
              <ControlTemplate TargetType="ListBoxItem">
                <Border x:Name="ItemBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" ClipToBounds="True"><ContentPresenter/></Border>
                <ControlTemplate.Triggers>
                  <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ItemBorder" Property="BorderBrush" Value="{StaticResource GlassBorderHover}"/></Trigger>
                  <Trigger Property="IsSelected" Value="True"><Setter TargetName="ItemBorder" Property="BorderBrush" Value="{StaticResource AccentLight}"/><Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource AccentSoft}"/></Trigger>
                </ControlTemplate.Triggers>
              </ControlTemplate>
            </Setter.Value>
          </Setter>
        </Style>
      </Grid.Resources>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="0"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <Border x:Name="ModalZoomIndicator" Grid.RowSpan="3" Grid.ColumnSpan="2" VerticalAlignment="Top" HorizontalAlignment="Center" CornerRadius="4" Background="{StaticResource GlassChrome}" BorderBrush="{StaticResource GlassBorder}" BorderThickness="1" Padding="7,1" Margin="0,2,0,0" IsHitTestVisible="False" Panel.ZIndex="36">
        <TextBlock x:Name="ModalZoomLabel" Text="100%" Foreground="{StaticResource TextTertiary}" FontSize="9.5" MinWidth="36" TextAlignment="Center" VerticalAlignment="Center"/>
      </Border>

      <!-- Keep native window controls available even when preview chrome is hidden. -->
      <Border x:Name="ModalWindowCaptionControls" Grid.RowSpan="3" Grid.ColumnSpan="2"
              HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,6,6,0" Padding="0"
              CornerRadius="4" Background="{StaticResource GlassChrome}" BorderBrush="{StaticResource GlassBorderHover}" BorderThickness="1"
              Panel.ZIndex="120" WindowChrome.IsHitTestVisibleInChrome="True">
        <StackPanel Orientation="Horizontal">
          <Button x:Name="ModalMinimizeButton" Style="{StaticResource CaptionButton}" Click="Minimize_Click"
                  ToolTip="Minimize to notification area while AI processing continues" AutomationProperties.Name="Minimize while AI processing continues"
                  WindowChrome.IsHitTestVisibleInChrome="True">
            <Rectangle Width="11" Height="1.4" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
          </Button>
          <Button x:Name="ModalMaximizeButton" Style="{StaticResource CaptionButton}" Click="Maximize_Click"
                  ToolTip="Maximize" AutomationProperties.Name="Maximize window"
                  WindowChrome.IsHitTestVisibleInChrome="True">
            <Path x:Name="ModalMaximizeIcon" Data="M4,4 H20 V20 H4 Z"
                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                  StrokeThickness="1.5" Fill="Transparent" Stretch="Uniform" Width="12" Height="12"/>
          </Button>
          <Button x:Name="ModalWindowCloseButton" Style="{StaticResource CloseButton}" Click="Close_Click"
                  ToolTip="Close Aibos Image" AutomationProperties.Name="Close Aibos Image window"
                  WindowChrome.IsHitTestVisibleInChrome="True">
            <Path Data="M2,2 L12,12 M12,2 L2,12" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.4" Width="12" Height="12" Stretch="Uniform"/>
          </Button>
        </StackPanel>
      </Border>

      <!-- topbar -->
      <Border x:Name="ModalTopBarSurface" Grid.Row="0" Grid.ColumnSpan="2" Background="{StaticResource GlassChrome}" BorderBrush="{StaticResource GlassBorderHover}" BorderThickness="0,0,0,1" Panel.ZIndex="30"/>
      <Grid x:Name="ModalTopBar" Grid.Row="0" Grid.ColumnSpan="2" Margin="12,7" Panel.ZIndex="35" WindowChrome.IsHitTestVisibleInChrome="True">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition x:Name="ModalToolbarActionsRow" Height="0"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="138"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal">
          <Button x:Name="ModalCloseBtn" Style="{StaticResource IconButton}" Click="CloseModal_Click" ToolTip="Back to gallery (Esc)" AutomationProperties.Name="Back to gallery" Width="36" Height="32" Margin="0,0,6,0">
            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE72B;" Foreground="{StaticResource TextSecondary}" FontSize="15"/>
          </Button>
          <TextBlock x:Name="ModalPositionText" Text="画像 0 / 0"
                     MinWidth="88" Margin="0,0,10,0" VerticalAlignment="Center"
                     Foreground="{StaticResource TextSecondary}"
                     FontSize="12.5" FontWeight="SemiBold" TextAlignment="Center"
                     AutomationProperties.Name="Image 0 of 0"/>
        </StackPanel>

        <Grid x:Name="ModalTitleInfoPanel" Grid.Row="0" Grid.Column="1" MinWidth="96" Margin="0,0,8,0" VerticalAlignment="Stretch" ClipToBounds="True"
              Background="Transparent" Cursor="SizeAll" WindowChrome.IsHitTestVisibleInChrome="True"
              PreviewMouseLeftButtonDown="WindowDragRegion_PreviewMouseLeftButtonDown"
              ToolTip="Drag to move · double-click to maximize or restore"
              AutomationProperties.Name="Preview window drag region"
              AutomationProperties.HelpText="Drag this title area to move or snap the window. Double-click to maximize or restore.">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <TextBlock x:Name="ModalTitle" Grid.Column="0" Text="-- × --" Foreground="{StaticResource TextSecondary}" FontSize="13" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
          <TextBlock x:Name="ModalSourceLabel" Grid.Column="1" Text="Original" Foreground="{StaticResource TextTertiary}" FontSize="11.5" Margin="10,0,0,0" VerticalAlignment="Center"/>
          <TextBlock x:Name="ModalFileSizeText" Grid.Column="2" Text="--" AutomationProperties.Name="Displayed file size" Foreground="{StaticResource TextSecondary}" FontSize="11.5" Margin="10,0,0,0" VerticalAlignment="Center"/>
          <TextBlock x:Name="ModalEnhancementStatusText" Grid.Column="3" Foreground="{StaticResource TextTertiary}" FontSize="11.5" Margin="10,0,0,0" VerticalAlignment="Center" Visibility="Collapsed" TextTrimming="CharacterEllipsis" MaxWidth="240"/>
        </Grid>

        <WrapPanel x:Name="ModalToolbarActionsPanel" Grid.Row="0" Grid.Column="2"
                   Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
          <Button x:Name="ModalOneToOneButton" Style="{StaticResource IconButton}" ToolTip="Actual pixels (100%): one image pixel per screen pixel" AutomationProperties.Name="Show actual pixels at 100 percent" Width="42" Height="32" Click="ModalOneToOne_Click" Visibility="Collapsed">
            <TextBlock x:Name="ModalOneToOneLabel" Text="100%" Foreground="{StaticResource TextSecondary}" FontSize="10.5" FontWeight="SemiBold"/>
          </Button>
          <Border x:Name="ModalFavoriteControlBorder" Height="32" Margin="0,0,2,0" CornerRadius="4" Visibility="Visible"
                  Background="{StaticResource FavoriteSoft}" BorderBrush="{StaticResource Favorite}" BorderThickness="1"
                  AutomationProperties.Name="Favorite level controls">
            <StackPanel Orientation="Horizontal">
              <Button x:Name="ModalFavoriteDecreaseButton" Style="{StaticResource IconButton}" ToolTip="Favorite -1 (U)" AutomationProperties.Name="Decrease favorite level" Width="28" Height="30" Click="ModalFavoriteDecrease_Click">
                <TextBlock x:Name="ModalFavoriteDecreaseGlyph" FontFamily="Segoe MDL2 Assets" Text="&#xEB51;" Foreground="{StaticResource FavoriteText}" FontSize="15"/>
              </Button>
