                <TextBlock x:Name="PreviewSamplerText" Grid.Row="2" Grid.Column="1" Text="Euler a" Foreground="{StaticResource TextSecondary}" Margin="12,2,0,2"/>
                <TextBlock x:Name="PreviewStepsLabel" Grid.Row="3" Grid.Column="0" Text="STEPS" Foreground="{StaticResource TextTertiary}" FontSize="11"/>
                <TextBlock x:Name="PreviewStepsText" Grid.Row="3" Grid.Column="1" Text="28" Foreground="{StaticResource TextSecondary}" Margin="12,2,0,2"/>
                <TextBlock x:Name="PreviewCfgLabel" Grid.Row="4" Grid.Column="0" Text="CFG" Foreground="{StaticResource TextTertiary}" FontSize="11"/>
                <TextBlock x:Name="PreviewCfgText" Grid.Row="4" Grid.Column="1" Text="6.5" Foreground="{StaticResource TextSecondary}" Margin="12,2,0,2"/>
                <TextBlock x:Name="PreviewSeedLabel" Grid.Row="5" Grid.Column="0" Text="SEED" Foreground="{StaticResource TextTertiary}" FontSize="11"/>
                <TextBlock x:Name="PreviewSeedText" Grid.Row="5" Grid.Column="1" Text="3874219055" Foreground="{StaticResource TextSecondary}" FontFamily="{StaticResource MonoFont}" FontSize="12" Margin="12,2,0,2"/>
                <TextBlock Grid.Row="6" Grid.Column="0" Text="DATE" Foreground="{StaticResource TextTertiary}" FontSize="11"/>
                <TextBlock x:Name="PreviewDateText" Grid.Row="6" Grid.Column="1" Text="2026-07-08 14:22" Foreground="{StaticResource TextSecondary}" Margin="12,2,0,2"/>
              </Grid>

              <DockPanel Margin="0,12,0,4" LastChildFill="True">
                <Button x:Name="CopyPreviewPromptButton" DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Height="24" MinWidth="52" Padding="8,2" Margin="6,0,0,0" Content="Copy" IsEnabled="False" ToolTip="No prompt metadata loaded" Click="CopyPreviewPrompt_Click"/>
                <Button x:Name="CopyPreviewMetadataButton" DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Height="24" MinWidth="52" Padding="8,2" Content="Copy" IsEnabled="False" ToolTip="No PNG metadata loaded" Click="CopyPreviewMetadata_Click"/>
                <TextBlock x:Name="PreviewPromptLabel" Text="PROMPT" Foreground="{StaticResource TextTertiary}" FontSize="10.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
              </DockPanel>
              <Border CornerRadius="8" Background="{StaticResource BgTertiary}" BorderBrush="{StaticResource GlassBorder}" BorderThickness="1" Padding="10,8">
                <TextBlock x:Name="PreviewPromptText" Text="masterpiece, best quality, 1girl, portrait, silver hair, intricate detail, soft rim lighting, cinematic, depth of field, looking at viewer, ornate jacket, snowy background" Foreground="{StaticResource TextSecondary}" FontSize="12" TextWrapping="Wrap" LineHeight="18"/>
              </Border>

              <DockPanel Margin="0,10,0,4" LastChildFill="True">
                <Button x:Name="CopyPreviewNegativeButton" DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Height="24" MinWidth="52" Padding="8,2" Content="Copy" IsEnabled="False" ToolTip="No negative prompt metadata loaded" Click="CopyPreviewNegative_Click"/>
                <TextBlock x:Name="PreviewNegativeLabel" Text="NEGATIVE" Foreground="{StaticResource TextTertiary}" FontSize="10.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
              </DockPanel>
              <Border x:Name="PreviewNegativeCard" CornerRadius="8" Background="{StaticResource BgTertiary}" BorderBrush="{StaticResource GlassBorder}" BorderThickness="1" Padding="10,8">
                <TextBlock x:Name="PreviewNegativeText" Text="lowres, bad anatomy, bad hands, text, error, missing fingers, extra digit, worst quality, jpeg artifacts, watermark, signature" Foreground="#F5A5A5" FontSize="12" TextWrapping="Wrap" LineHeight="18"/>
              </Border>
            </StackPanel>
          </ScrollViewer>
          <Grid x:Name="RightPreviewEmptyState" Grid.Row="1" Visibility="Collapsed" Background="{StaticResource BgSecondary}" Panel.ZIndex="2"
                AutomationProperties.Name="No image selected">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20">
              <TextBlock Text="Click an image to open preview." Foreground="{StaticResource TextSecondary}" FontSize="12.5" HorizontalAlignment="Center"/>
              <TextBlock Text="Use Ctrl/Shift for multi-select." Foreground="{StaticResource TextTertiary}" FontSize="12" Margin="0,6,0,0" HorizontalAlignment="Center"/>
            </StackPanel>
          </Grid>
        </Grid>
      </Border>
    </Grid>

    <!-- ═══════════════ Bottom preview tabs ═══════════════ -->
    <Border Grid.Row="2" Background="{StaticResource BgSecondary}" BorderBrush="{StaticResource GlassBorder}" BorderThickness="0,1,0,0">
      <DockPanel LastChildFill="True">
        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0">
          <Button x:Name="RestorePreviewTabButton" Style="{StaticResource GhostButton}" Height="26" FontSize="11" Content="Reopen" Margin="0,0,6,0" ToolTip="Reopen last closed (Ctrl+Shift+T)" Click="RestorePreviewTab_Click" AutomationProperties.Name="Reopen last closed preview tab"/>
          <Button x:Name="CloseAllPreviewTabsButton" Style="{StaticResource GhostButton}" Height="26" FontSize="11" Content="Close all" Click="CloseAllPreviewTabs_Click" AutomationProperties.Name="Close all preview tabs"/>
        </StackPanel>
        <TextBlock x:Name="HeaderStats" DockPanel.Dock="Right"
                   Text="3 selected · 12,480 images · 4 folders"
                   Foreground="{StaticResource TextTertiary}" FontSize="11.5"
                   Margin="10,0,12,0" VerticalAlignment="Center"
                   TextTrimming="CharacterEllipsis"/>
        <TextBlock x:Name="LoadTimingStatusText" DockPanel.Dock="Right"
                   Visibility="Collapsed" Foreground="{StaticResource TextTertiary}"
                   FontSize="10.5" Margin="8,0,2,0" VerticalAlignment="Center"
                   TextTrimming="CharacterEllipsis" IsHitTestVisible="False"
                   AutomationProperties.Name="Folder load timing"/>
        <Border x:Name="MetadataIndexFooterPanel" DockPanel.Dock="Right" Visibility="Collapsed" MinWidth="190" MaxWidth="340" Margin="8,5,10,5" Padding="10,3" CornerRadius="7"
                Background="{StaticResource AccentGlass}" BorderBrush="{StaticResource GlassBorder}" BorderThickness="1" IsHitTestVisible="False">
          <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <TextBlock x:Name="MetadataIndexFooterStatusText" Grid.Row="0" Foreground="{StaticResource TextSecondary}" FontSize="10.5" TextTrimming="CharacterEllipsis"
                       AutomationProperties.Name="Prompt metadata footer status" AutomationProperties.LiveSetting="Polite"/>
            <ProgressBar x:Name="MetadataIndexFooterProgressBar" Grid.Row="1" Height="2" Minimum="0" Maximum="100" Value="0" Margin="0,2,0,0"/>
          </Grid>
        </Border>
        <Grid>
          <TextBlock x:Name="PreviewTabsEmptyText" Text="No preview tabs" Foreground="{StaticResource TextTertiary}" FontSize="12" VerticalAlignment="Center" Margin="8,0"/>
          <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
            <ItemsControl x:Name="PreviewTabList" AutomationProperties.Name="Preview tabs" AutomationProperties.HelpText="Drag a tab to reorder it. Alt+Shift+Left or Right moves the focused tab.">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Orientation="Horizontal"/>
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Padding="6,0" BorderBrush="{DynamicResource DividerSubtleBrush}" BorderThickness="0,0,1,0" Tag="{Binding}" AllowDrop="True" DragEnter="PreviewTab_DragEnter" DragOver="PreviewTab_DragOver" DragLeave="PreviewTab_DragLeave" Drop="PreviewTab_Drop">
                    <Border.Style>
                      <Style TargetType="Border">
                        <Setter Property="Background" Value="Transparent"/>
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding IsDragOver}" Value="True">
                            <Setter Property="Background" Value="{StaticResource AccentGlass}"/>
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </Border.Style>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                       <Button Style="{StaticResource GhostButton}" Height="26" FontSize="11" Padding="8,0" Tag="{Binding}" Click="ActivatePreviewTab_Click" MouseEnter="PreviewTab_MouseEnter" MouseMove="PreviewTab_MouseMove" MouseLeave="PreviewTab_MouseLeave" PreviewMouseLeftButtonDown="PreviewTab_PreviewMouseLeftButtonDown" PreviewMouseLeftButtonUp="PreviewTab_PreviewMouseLeftButtonUp" PreviewMouseDown="PreviewTab_PreviewMouseDown" ToolTip="{Binding Path}" AutomationProperties.Name="{Binding AutomationName}" AutomationProperties.HelpText="Drag to reorder. Alt+Shift+Left or Right moves this tab.">
                        <StackPanel Orientation="Horizontal">
                          <TextBlock Text="{Binding ActiveMarker}" Foreground="{StaticResource FavoriteText}" FontSize="11" VerticalAlignment="Center" Margin="0,0,5,0"/>
                          <TextBlock Text="{Binding FileName}" Foreground="{Binding Foreground}" FontSize="12" TextTrimming="CharacterEllipsis" MaxWidth="160" VerticalAlignment="Center"/>
                        </StackPanel>
                       </Button>
                       <Button Style="{StaticResource GhostButton}" Width="26" Height="26" FontSize="11" Content="{Binding PinMarker}" Tag="{Binding}" Click="TogglePreviewTabPin_Click" ToolTip="{Binding PinToolTip}" AutomationProperties.Name="{Binding PinAutomationName}"/>
                       <Button Style="{StaticResource GhostButton}" Width="26" Height="26" FontSize="12" Content="x" Tag="{Binding}" Click="ClosePreviewTab_Click" ToolTip="Close tab" AutomationProperties.Name="{Binding CloseAutomationName}"/>
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
          <Popup x:Name="PreviewTabHoverPopup" AllowsTransparency="True" Placement="Top" StaysOpen="True" VerticalOffset="-10">
            <Border Width="220" Background="{StaticResource BgSecondary}" BorderBrush="{StaticResource GlassBorderHover}" BorderThickness="1" CornerRadius="10" Padding="10" IsHitTestVisible="False">
              <StackPanel>
                <Border Height="148" Background="{StaticResource BgTertiary}" CornerRadius="8" ClipToBounds="True" Margin="0,0,0,8">
                  <Image x:Name="PreviewTabHoverBitmap" Stretch="UniformToFill"/>
                </Border>
                <TextBlock x:Name="PreviewTabHoverName" Foreground="{StaticResource TextPrimary}" FontSize="12.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="PreviewTabHoverPath" Foreground="{StaticResource TextTertiary}" FontSize="10.5" TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/>
              </StackPanel>
            </Border>
          </Popup>
        </Grid>
      </DockPanel>
    </Border>

    <!-- ═══════════════ Landing / scanning ═══════════════ -->
    <Grid x:Name="Landing" Grid.RowSpan="3" Visibility="Collapsed" Background="{StaticResource BgPrimary}" AllowDrop="True"
          DragEnter="FolderDropTarget_DragEnter" DragOver="FolderDropTarget_DragOver" DragLeave="FolderDropTarget_DragLeave" Drop="FolderDropTarget_Drop"
          AutomationProperties.Name="Folder selection landing drop target" AutomationProperties.HelpText="Drop existing folders from Explorer to add them to the folder set. Files are never copied or moved.">
      <Grid.RowDefinitions>
        <RowDefinition Height="52"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>
      <Border x:Name="LandingHeaderSurface" Grid.Row="0" Background="{StaticResource HeaderBg}"
              BorderBrush="{StaticResource GlassBorderHover}" BorderThickness="0,0,0,1" Panel.ZIndex="1"/>
      <Border x:Name="LandingDragRegion" Grid.Row="0" Width="160" HorizontalAlignment="Center"
              Background="Transparent" Cursor="SizeAll" Panel.ZIndex="10"
              WindowChrome.IsHitTestVisibleInChrome="True"
              PreviewMouseLeftButtonDown="WindowDragRegion_PreviewMouseLeftButtonDown"
              ToolTip="Drag to move · double-click to maximize or restore"
              AutomationProperties.Name="Landing window drag region"
              AutomationProperties.HelpText="Drag this grip to move or snap the window. Double-click to maximize or restore.">
        <StackPanel Width="24" VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False" Opacity="0.7">
          <Rectangle Height="1" Fill="{StaticResource TextTertiary}" Margin="0,0,0,3"/>
          <Rectangle Height="1" Fill="{StaticResource TextTertiary}" Margin="0,0,0,3"/>
          <Rectangle Height="1" Fill="{StaticResource TextTertiary}"/>
        </StackPanel>
      </Border>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10,10,0,0"
                  Height="32" Panel.ZIndex="20" IsHitTestVisible="False">
        <Image Source="Brand/Generated/Aibos.Mark.24.png" Width="24" Height="24" Margin="2"
               Stretch="Uniform" SnapsToDevicePixels="True" RenderOptions.BitmapScalingMode="HighQuality"
               AutomationProperties.Name="Aibos Gallery Fold mark"/>
        <TextBlock Text="Aibos" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"
                   VerticalAlignment="Center" Margin="8,0,0,0"/>
      </StackPanel>
      <Button x:Name="LandingShortcutsButton" Style="{StaticResource GhostButton}" Panel.ZIndex="20"
              HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,10,248,0" Height="32" MinWidth="76" Padding="9,0"
              Content="{DynamicResource UiShortcuts}" Click="OpenShortcuts_Click" ToolTip="{DynamicResource UiShortcutsToolTip}" AutomationProperties.Name="Open keyboard shortcuts"
              WindowChrome.IsHitTestVisibleInChrome="True"/>
      <Button x:Name="LandingAppSettingsButton" Style="{StaticResource GhostButton}" Panel.ZIndex="20"
              HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,10,144,0" Height="32" Padding="9,0"
              Click="OpenAppSettings_Click" ToolTip="{DynamicResource UiSettingsToolTip}" AutomationProperties.Name="App settings" WindowChrome.IsHitTestVisibleInChrome="True">
        <StackPanel Orientation="Horizontal">
          <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE713;"
                     Foreground="{StaticResource TextSecondary}" FontSize="14" Margin="0,0,7,0"/>
          <TextBlock Text="{DynamicResource UiSettings}" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
        </StackPanel>
      </Button>
      <StackPanel x:Name="LandingCaptionControls" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,9,8,0" Panel.ZIndex="20">
        <Button x:Name="LandingMinimizeButton" Style="{StaticResource CaptionButton}" Click="Minimize_Click" ToolTip="Minimize to notification area while AI processing continues" AutomationProperties.Name="Minimize while AI processing continues" WindowChrome.IsHitTestVisibleInChrome="True">
          <Rectangle Width="11" Height="1.4" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
        </Button>
        <Button x:Name="LandingMaximizeButton" Style="{StaticResource CaptionButton}" Click="Maximize_Click" ToolTip="Maximize" AutomationProperties.Name="Maximize window" WindowChrome.IsHitTestVisibleInChrome="True">
          <Path x:Name="LandingMaximizeIcon" Data="M4,4 H20 V20 H4 Z"
                Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                StrokeThickness="1.5" Fill="Transparent" Stretch="Uniform" Width="12" Height="12"/>
        </Button>
        <Button x:Name="LandingCloseButton" Style="{StaticResource CloseButton}" Click="Close_Click" ToolTip="Close" AutomationProperties.Name="Close window" WindowChrome.IsHitTestVisibleInChrome="True">
          <Path Data="M2,2 L12,12 M12,2 L2,12" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.4" Width="12" Height="12" Stretch="Uniform"/>
        </Button>
      </StackPanel>

      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                    VerticalContentAlignment="Center" HorizontalContentAlignment="Center">
      <StackPanel Width="560" Margin="0,10,0,16">
        <Image Source="Brand/Generated/Aibos.Mark.64.png" Width="64" Height="64" Margin="0,0,0,10"
               Stretch="Uniform" SnapsToDevicePixels="True" RenderOptions.BitmapScalingMode="HighQuality"
               AutomationProperties.Name="Aibos Gallery Fold mark"/>
        <TextBlock Text="Aibos" FontSize="32" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="{StaticResource LogoBrush}"/>
        <TextBlock Text="{DynamicResource UiLandingTagline}" HorizontalAlignment="Center"
                   Foreground="{StaticResource TextTertiary}" FontSize="12" Margin="0,5,0,24"/>

        <!-- folder set panel -->
        <StackPanel x:Name="LandingPanel">
          <Grid Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Style="{StaticResource BrowseButton}" Margin="0,0,12,0" Click="OpenFolder_Click">
              <StackPanel Orientation="Horizontal">
                <Path Data="M22,19 a2,2 0 0 1 -2,2 H4 a2,2 0 0 1 -2,-2 V5 a2,2 0 0 1 2,-2 h5 l2,3 h9 a2,2 0 0 1 2,2 z" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.8" Stretch="Uniform" Width="17" Height="17" Margin="0,0,8,0"/>
                <TextBlock Text="{DynamicResource UiAddFolder}" VerticalAlignment="Center"/>
              </StackPanel>
            </Button>
            <Button Grid.Column="1" x:Name="ChangeLandingFolderSetButton" Style="{StaticResource BrowseButton}" Margin="0,0,12,0" Click="ChangeLandingFolderSet_Click"
                    ToolTip="{DynamicResource UiChangeFolderSetHelp}">
              <TextBlock Text="{DynamicResource UiChangeFolder}" VerticalAlignment="Center"/>
            </Button>
            <Button Grid.Column="2" x:Name="OpenFolderSetButton" Style="{StaticResource PrimaryButton}" Click="StartScan_Click">
              <TextBlock x:Name="OpenFolderSetButtonText" Text="{DynamicResource UiOpenFolderSet}" Foreground="{StaticResource SelectionText}"/>
            </Button>
          </Grid>

          <Border CornerRadius="4" Background="{StaticResource BgSecondary}" BorderBrush="{StaticResource GlassBorder}" BorderThickness="1" Padding="12,9" Margin="0,0,0,6" Visibility="Collapsed">
            <DockPanel>
              <TextBlock DockPanel.Dock="Left" Text="・" Foreground="{StaticResource TextTertiary}" VerticalAlignment="Center" Margin="0,0,8,0"/>
              <TextBlock DockPanel.Dock="Right" Text="✕" Foreground="{StaticResource TextTertiary}" VerticalAlignment="Center" Margin="8,0,0,0"/>
              <TextBlock Text="D:\SD\outputs\txt2img" Foreground="{StaticResource TextPrimary}" FontSize="13.5" TextTrimming="CharacterEllipsis"/>
            </DockPanel>
          </Border>
          <Border CornerRadius="4" Background="{StaticResource BgSecondary}" BorderBrush="{StaticResource GlassBorder}" BorderThickness="1" Padding="12,9" Margin="0,0,0,12" Visibility="Collapsed">
            <DockPanel>
              <TextBlock DockPanel.Dock="Left" Text="・" Foreground="{StaticResource TextTertiary}" VerticalAlignment="Center" Margin="0,0,8,0"/>
              <TextBlock DockPanel.Dock="Right" Text="✕" Foreground="{StaticResource TextTertiary}" VerticalAlignment="Center" Margin="8,0,0,0"/>
              <TextBlock Text="D:\SD\outputs\img2img" Foreground="{StaticResource TextPrimary}" FontSize="13.5" TextTrimming="CharacterEllipsis"/>
            </DockPanel>
          </Border>

          <Border CornerRadius="4" Background="{StaticResource BgSecondary}" BorderBrush="{StaticResource GlassBorder}" BorderThickness="1" Padding="8,7" Margin="0,0,0,12" MinHeight="72">
            <Grid>
              <StackPanel x:Name="LandingFolderSetEmptyHint" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                <TextBlock Text="{DynamicResource UiDropFoldersTitle}" Foreground="{StaticResource TextSecondary}" FontSize="12.5" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                <TextBlock Text="{DynamicResource UiDropFoldersHelp}" Foreground="{StaticResource TextTertiary}" FontSize="10.5" Margin="0,4,0,0" HorizontalAlignment="Center"/>
              </StackPanel>
              <ScrollViewer x:Name="LandingFolderSetScrollViewer" MaxHeight="118"
                            VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                            CanContentScroll="False" PanningMode="VerticalOnly"
                            AutomationProperties.Name="Selected folder set"
                            AutomationProperties.HelpText="Scroll to review every selected folder.">
                <ItemsControl x:Name="LandingFolderSetList" Margin="0,0,4,0">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <DockPanel Margin="0,0,0,5">
                        <Button DockPanel.Dock="Right" Style="{StaticResource StepButton}" Content="x" ToolTip="{DynamicResource UiRemoveFolder}" Tag="{Binding}" Click="RemoveLandingFolder_Click" Margin="8,0,0,0"/>
                        <TextBlock Text="{Binding}" Foreground="{StaticResource TextPrimary}" FontSize="13" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                      </DockPanel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
            </Grid>
          </Border>

          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <Border Grid.Column="0" Height="72" CornerRadius="4" Background="{StaticResource BgSecondary}" BorderBrush="{StaticResource GlassBorder}" BorderThickness="1" Padding="10,7" Margin="0,0,12,0">
              <TextBlock Text="{DynamicResource UiPasteFolderHint}" Foreground="{StaticResource TextTertiary}" FontSize="13"/>
            </Border>
            <TextBox Grid.Column="0" x:Name="PastedFoldersInput" Margin="10,7,22,7" AcceptsReturn="True" TextWrapping="NoWrap" BorderThickness="0" Background="{StaticResource BgSecondary}"
                     Foreground="{StaticResource TextPrimary}" FontSize="13" VerticalScrollBarVisibility="Auto"/>
            <Button Grid.Column="1" Style="{StaticResource BrowseButton}" Content="{DynamicResource UiAddPasted}" VerticalAlignment="Stretch" Click="AddPastedFolders_Click"/>
          </Grid>
          <TextBlock x:Name="LandingFolderStatusText" Text="{DynamicResource UiNoFoldersSelected}" Foreground="{StaticResource TextTertiary}" FontSize="12" Margin="2,8,0,0"/>
        </StackPanel>

        <Button x:Name="OpenLastFolderSetButton" Style="{StaticResource BrowseButton}" Height="40" HorizontalAlignment="Stretch" Margin="0,12,0,0"
                Click="OpenLastFolder_Click" ToolTip="{DynamicResource UiOpenLastFolderSetShortcutHelp}"
                AutomationProperties.Name="{DynamicResource UiOpenLastFolderSet}" AutomationProperties.HelpText="{DynamicResource UiOpenLastFolderSetShortcutHelp}">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="{DynamicResource UiOpenLastFolderSet}" Foreground="{StaticResource TextPrimary}" FontWeight="Medium"/>
            <TextBlock x:Name="LastFolderSetText" Text="{DynamicResource UiNoSavedFolderSet}" Foreground="{StaticResource TextTertiary}" FontSize="12" VerticalAlignment="Center"/>
            <TextBlock Text="[Ctrl + Shift + L]" Foreground="{StaticResource TextTertiary}" FontSize="11" Margin="10,0,0,0" VerticalAlignment="Center"/>
          </StackPanel>
        </Button>

        <Grid Margin="2,20,0,8">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <TextBlock Grid.Column="0" Text="{DynamicResource UiFavoriteFolderSets}" Foreground="{StaticResource TextTertiary}" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center"/>
          <Button Grid.Column="1" x:Name="SaveCurrentFolderSetFavoriteButton" Style="{StaticResource GhostButton}" Height="28" Padding="10,0"
                  Click="SaveCurrentFolderSetFavorite_Click" ToolTip="{DynamicResource UiSaveFavoriteFolderSetHelp}">
            <TextBlock Text="{DynamicResource UiSaveFavoriteFolderSet}" FontSize="11.5"/>
          </Button>
        </Grid>
        <Grid>
          <TextBlock x:Name="FavoriteFolderSetEmptyHint" Text="{DynamicResource UiNoFavoriteFolderSets}"
                     Foreground="{StaticResource TextTertiary}" FontSize="12" Margin="2,4,0,4"/>
          <ScrollViewer x:Name="FavoriteFolderSetScrollViewer" MaxHeight="132"
                        VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                        CanContentScroll="False" PanningMode="VerticalOnly"
                        AutomationProperties.Name="Favorite folder sets"
                        AutomationProperties.HelpText="Favorite folder sets remain available when recent history changes.">
            <ItemsControl x:Name="FavoriteFolderSetList" Margin="0,0,4,0">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><StackPanel/></ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Grid Margin="0,0,0,7">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Style="{StaticResource GhostButton}" Height="30" Padding="10,0" HorizontalContentAlignment="Left"
                            Tag="{Binding}" Click="FavoriteFolderSet_Click" ToolTip="{Binding Detail}">
                      <TextBlock Text="{Binding Display}" TextTrimming="CharacterEllipsis"/>
                    </Button>
                    <Button Grid.Column="1" Style="{StaticResource StepButton}" Content="x" Margin="7,0,0,0"
                            Tag="{Binding}" Click="RemoveFavoriteFolderSet_Click"
                            ToolTip="{DynamicResource UiRemoveFavoriteFolderSet}"/>
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Grid>

        <TextBlock Text="{DynamicResource UiRecentFolderSets}" Foreground="{StaticResource TextTertiary}" FontSize="10" FontWeight="SemiBold" Margin="2,20,0,8"/>
        <ScrollViewer x:Name="RecentFolderSetScrollViewer" MaxHeight="160"
                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      CanContentScroll="False" PanningMode="VerticalOnly"
                      AutomationProperties.Name="Recent folder sets"
                      AutomationProperties.HelpText="Recent folder sets are shown in one scrollable column.">
          <ItemsControl x:Name="RecentFolderSetList" Margin="0,0,4,0">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate><StackPanel/></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Button Style="{StaticResource GhostButton}" Height="30" Margin="0,0,0,7" Padding="10,0" FontSize="12"
                        HorizontalContentAlignment="Left" Tag="{Binding}" Click="RecentFolderSet_Click" ToolTip="{Binding Detail}">
                  <TextBlock Text="{Binding Display}" TextTrimming="CharacterEllipsis"/>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
        <WrapPanel Visibility="Collapsed">
          <WrapPanel.Resources>
            <Style TargetType="Button" BasedOn="{StaticResource GhostButton}">
              <Setter Property="Height" Value="30"/><Setter Property="Margin" Value="0,0,7,7"/><Setter Property="FontSize" Value="12"/>
            </Style>
          </WrapPanel.Resources>
          <Button Content="D:\SD\outputs (+3)" Click="StartScan_Click"/>
          <Button Content="E:\art\upscaled" Click="StartScan_Click"/>
          <Button Content="D:\SD\favorites" Click="StartScan_Click"/>
        </WrapPanel>

        <!-- scanning progress -->
        <StackPanel x:Name="ScanPanel" Visibility="Collapsed" Margin="0,26,0,0">
          <Grid Margin="0,0,0,8">
            <TextBlock x:Name="ScanLabel" Text="0 / 12,480 files" Foreground="{StaticResource TextSecondary}" FontSize="13" HorizontalAlignment="Left"/>
            <TextBlock x:Name="ScanPercent" Text="0%" Foreground="{StaticResource TextSecondary}" FontSize="13" HorizontalAlignment="Right"/>
          </Grid>
          <ProgressBar x:Name="ScanBar" Height="6" Minimum="0" Maximum="100" Value="0">
            <ProgressBar.Template>
              <ControlTemplate TargetType="ProgressBar">
                <Border CornerRadius="3" Background="{StaticResource BgTertiary}" ClipToBounds="True">
                  <Grid>
                    <Border x:Name="PART_Indicator" HorizontalAlignment="Left" CornerRadius="3">
                      <Border.Background>
                        <SolidColorBrush Color="{DynamicResource AccentColor}"/>
                      </Border.Background>
                    </Border>
                    <Border x:Name="ScanIndeterminateIndicator" Width="112" HorizontalAlignment="Left" CornerRadius="3" Visibility="Collapsed">
                      <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                          <GradientStop Color="#00ff467c"/>
                          <GradientStop Color="#ffff467c" Offset="0.45"/>
                          <GradientStop Color="#ffc456ff" Offset="0.65"/>
                          <GradientStop Color="#00c456ff" Offset="1"/>
                        </LinearGradientBrush>
                      </Border.Background>
                      <Border.RenderTransform><TranslateTransform X="-112"/></Border.RenderTransform>
                    </Border>
                  </Grid>
                </Border>
                <ControlTemplate.Triggers>
                  <Trigger Property="IsIndeterminate" Value="True">
                    <Setter TargetName="PART_Indicator" Property="Visibility" Value="Collapsed"/>
                    <Setter TargetName="ScanIndeterminateIndicator" Property="Visibility" Value="Visible"/>
                    <Trigger.EnterActions>
                      <BeginStoryboard x:Name="ScanIndeterminateStoryboard">
                        <Storyboard RepeatBehavior="Forever">
                          <DoubleAnimation Storyboard.TargetName="ScanIndeterminateIndicator"
                                           Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                           From="-112" To="560" Duration="0:0:1.15"/>
                        </Storyboard>
                      </BeginStoryboard>
                    </Trigger.EnterActions>
                    <Trigger.ExitActions>
                      <StopStoryboard BeginStoryboardName="ScanIndeterminateStoryboard"/>
                    </Trigger.ExitActions>
                  </Trigger>
                </ControlTemplate.Triggers>
              </ControlTemplate>
            </ProgressBar.Template>
          </ProgressBar>
          <Border CornerRadius="8" Background="{StaticResource BgSecondary}" BorderBrush="{StaticResource GlassBorder}" BorderThickness="1" Padding="0,8" Margin="0,10,0,0">
            <TextBlock x:Name="ScanMessage" Text="{DynamicResource UiScanningFiles}" Foreground="{StaticResource TextSecondary}" FontSize="12.5" HorizontalAlignment="Center" AutomationProperties.Name="Scan status" AutomationProperties.LiveSetting="Polite"/>
          </Border>
          <Button x:Name="CancelScanButton" Style="{StaticResource GhostButton}" Content="{DynamicResource UiCancelScan}" Click="CancelScan_Click" Visibility="Collapsed" IsEnabled="False" HorizontalAlignment="Center" MinWidth="112" Margin="0,10,0,0" AutomationProperties.Name="Cancel scan" AutomationProperties.HelpText="Cancel only the active scan and keep the ordered folder draft."/>
        </StackPanel>
      </StackPanel>
      </ScrollViewer>
      <Border x:Name="LandingFolderDropOverlay" Grid.RowSpan="2" Visibility="Collapsed" IsHitTestVisible="True"
              MouseLeftButtonDown="FolderDropOverlay_MouseLeftButtonDown" Margin="28" CornerRadius="6"
              Background="{StaticResource BgPrimary}" BorderBrush="{StaticResource AccentLight}" BorderThickness="2">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
          <TextBlock Text="{DynamicResource UiDropFoldersTitle}" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center"/>
          <TextBlock Text="{DynamicResource UiDropFoldersHelp}" Foreground="{StaticResource TextSecondary}" FontSize="12.5" Margin="0,5,0,0" HorizontalAlignment="Center"/>
        </StackPanel>
      </Border>
    </Grid>

    <!-- Explicit selected-image enhancement review. Opening and closing this overlay never enqueue work. -->
    <Grid x:Name="BatchEnhancementDialog" Grid.RowSpan="3" Panel.ZIndex="530" Visibility="Collapsed" Background="{DynamicResource OverlayStrongBrush}"
