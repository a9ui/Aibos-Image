                            PreviewKeyDown="RightPreviewMorePopup_PreviewKeyDown"
                            AutomationProperties.Name="More selected image actions menu">
                      <StackPanel Width="160">
                        <Button x:Name="RightPreviewRevealButton" Style="{StaticResource GhostButton}" Margin="0,0,0,4"
                                HorizontalContentAlignment="Left" Content="Show in folder"
                                ToolTip="Show selected source in folder"
                                AutomationProperties.Name="Show selected source in folder"
                                Click="RightPreviewRevealOverflow_Click"/>
                        <Button x:Name="RightPreviewTabButton" Style="{StaticResource GhostButton}" Margin="0,0,0,4"
