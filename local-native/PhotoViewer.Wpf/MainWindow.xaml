              <MenuItem x:Name="ModalContextI2iEdit" Header="髪色…" Click="OpenModalI2iEdit_Click" AutomationProperties.Name="髪色のAI編集を開く"/>
              <MenuItem x:Name="ModalContextI2iV2Edit" Header="統合AI編集（全体・表情・服装・背景・ポーズ）…" Click="OpenModalI2iEditV3_Click"
                        AutomationProperties.Name="複数ターゲットのAI編集を開く"/>
            </MenuItem>
            <Separator/>
            <MenuItem x:Name="ModalContextUpscaleNext" Header="次に高画質化" Click="ModalContextUpscaleNext_Click" AutomationProperties.Name="次に高画質化"/>
            <MenuItem x:Name="ModalContextPhotorealNext" Header="次に実写化" Click="ModalContextPhotorealNext_Click" AutomationProperties.Name="次に実写化"/>
            <Separator/>
            <MenuItem x:Name="ModalContextEnhancedToggle" Header="Show Enhanced / Original" Click="ToggleModalEnhanced_Click" AutomationProperties.Name="Toggle enhanced image output"/>
            <MenuItem Header="左右反転 (H)" Click="ToggleModalFlip_Click" AutomationProperties.Name="Flip image horizontally"/>
            <MenuItem Header="100%表示" Click="ModalOneToOne_Click" AutomationProperties.Name="Show actual pixels at 100 percent"/>
            <MenuItem Header="縮小 (-)" Click="ModalZoomOut_Click" AutomationProperties.Name="Zoom image out"/>
            <MenuItem Header="画面に合わせる (0)" Click="ModalFit_Click" AutomationProperties.Name="Fit image to preview"/>
            <MenuItem Header="拡大 (+)" Click="ModalZoomIn_Click" AutomationProperties.Name="Zoom image in"/>
            <Separator/>
            <MenuItem Header="{DynamicResource UiOpenExternally}" Click="OpenSelectedExternally_Click" AutomationProperties.Name="Open displayed image externally"/>
            <MenuItem Header="{DynamicResource UiShowSourceFolder}" Click="ShowSelectedInFolder_Click" AutomationProperties.Name="Show source in folder"/>
            <MenuItem Header="{DynamicResource UiAddToAlbum}" Click="AddCurrentToAlbum_Click" AutomationProperties.Name="Add current image to Album"/>
            <MenuItem Header="{DynamicResource UiToggleFilmstrip}" Click="ToggleModalFilmstrip_Click" AutomationProperties.Name="Toggle image filmstrip"/>
            <MenuItem Header="メタデータ表示" Click="ToggleModalMetadataSidebar_Click" AutomationProperties.Name="Toggle metadata sidebar"/>
            <MenuItem x:Name="ModalContextFullScreen" Header="Enter full screen (F11)" Click="ToggleModalFullScreen_Click" AutomationProperties.Name="Toggle full screen"/>
            <MenuItem Header="{DynamicResource UiShortcuts}" Click="OpenShortcuts_Click" AutomationProperties.Name="Open keyboard shortcuts"/>
            <Separator/>
            <MenuItem x:Name="ModalContextDeleteDisplayed" Header="Delete displayed media" Click="DeleteDisplayedModalMedia_Click" AutomationProperties.Name="Delete displayed media"/>
          </ContextMenu>
