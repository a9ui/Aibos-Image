                            <DataTrigger Binding="{Binding IsHighlighted}" Value="True">
                              <Setter Property="BorderBrush" Value="{StaticResource AccentLight}"/>
                              <Setter Property="BorderThickness" Value="2"/>
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </Border.Style>
                      <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="76"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Button Width="68" Height="68" Padding="0" BorderThickness="0" Background="Transparent"
                                Tag="{Binding}" Click="OpenEnhancementSourceInViewer_Click"
                                ToolTip="{Binding ThumbnailToolTip}"
                                AutomationProperties.Name="{Binding SourceName, StringFormat=Open {0} in the Aibos viewer}">
                          <Border CornerRadius="3" Background="{StaticResource BgPrimary}" BorderBrush="{StaticResource GlassBorderHover}" BorderThickness="1">
                            <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="LowQuality"/>
                          </Border>
                        </Button>
                        <Grid Grid.Column="1">
                          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                          <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding SourceName}" Foreground="{StaticResource TextPrimary}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding SourcePath}"/>
                            <TextBlock Grid.Column="1" Text="{Binding StatusLabel}" FontSize="11.5" FontWeight="SemiBold" Margin="12,0,0,0">
                              <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                  <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
                                  <Style.Triggers>
                                    <DataTrigger Binding="{Binding Status}" Value="running"><Setter Property="Foreground" Value="{StaticResource AccentLight}"/></DataTrigger>
                                    <DataTrigger Binding="{Binding Status}" Value="queued"><Setter Property="Foreground" Value="{StaticResource Warning}"/></DataTrigger>
                                    <DataTrigger Binding="{Binding Status}" Value="succeeded"><Setter Property="Foreground" Value="{StaticResource Success}"/></DataTrigger>
                                    <DataTrigger Binding="{Binding Status}" Value="failed"><Setter Property="Foreground" Value="{StaticResource DangerText}"/></DataTrigger>
                                    <DataTrigger Binding="{Binding Status}" Value="canceled"><Setter Property="Foreground" Value="{StaticResource TextTertiary}"/></DataTrigger>
                                  </Style.Triggers>
                                </Style>
                              </TextBlock.Style>
                            </TextBlock>
                          </Grid>
                          <DockPanel Grid.Row="1" Margin="0,3,0,0" LastChildFill="True">
                            <TextBlock DockPanel.Dock="Left" Text="{Binding OperationLabel}" FontSize="10.8" FontWeight="Bold" Margin="0,0,9,0">
                              <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                  <Setter Property="Foreground" Value="#67E8F9"/>
                                  <Style.Triggers>
                                    <DataTrigger Binding="{Binding Operation}" Value="photoreal">
                                      <Setter Property="Foreground" Value="#C4B5FD"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Operation}" Value="video">
                                      <Setter Property="Foreground" Value="#F0ABFC"/>
                                    </DataTrigger>
                                  </Style.Triggers>
                                </Style>
                              </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="{Binding PresetSummary}" Foreground="{StaticResource TextTertiary}" FontSize="10.8" TextTrimming="CharacterEllipsis"/>
                          </DockPanel>
                          <ProgressBar Grid.Row="2" Height="4" Minimum="0" Maximum="100" Value="{Binding Progress, Mode=OneWay}" IsIndeterminate="{Binding IsProgressIndeterminate, Mode=OneWay}" Margin="0,7,0,0"
                                       AutomationProperties.Name="{Binding StatusLabel}"/>
                          <TextBlock Grid.Row="3" Text="{Binding DetailText}" Foreground="{StaticResource TextTertiary}" FontSize="10.8" TextWrapping="Wrap" MaxHeight="34" Margin="0,6,0,0"/>
                          <DockPanel Grid.Row="4" Margin="0,8,0,0" LastChildFill="True">
                            <TextBlock Text="{Binding TimestampText}" Foreground="{StaticResource TextTertiary}" FontSize="10.5" VerticalAlignment="Center"/>
                            <WrapPanel DockPanel.Dock="Right" HorizontalAlignment="Right">
                              <Button Style="{StaticResource GhostButton}" Content="{Binding RequestDetailsButtonLabel}" Tag="{Binding}" Click="ToggleEnhancementJobDetails_Click"
                                      Height="28" MinWidth="58" Margin="6,0,0,0" ToolTip="保存されたPromptとAI設定を表示"
                                      AutomationProperties.Name="保存されたPromptとAI設定の詳細を表示"/>
                              <Button Style="{StaticResource GhostButton}" Content="{Binding Action1.Label}" Tag="{Binding}" CommandParameter="{Binding Action1.Kind}" Click="EnhancementJobAction_Click" Height="28" MinWidth="{Binding Action1.MinWidth}" Margin="6,0,0,0" Visibility="{Binding Action1.Visible, Converter={StaticResource BoolToVis}}" IsEnabled="{Binding Action1.Enabled}" ToolTip="{Binding Action1.ToolTip}" AutomationProperties.Name="{Binding Action1.AutomationName}"/>
                              <Button Style="{StaticResource GhostButton}" Content="{Binding Action2.Label}" Tag="{Binding}" CommandParameter="{Binding Action2.Kind}" Click="EnhancementJobAction_Click" Height="28" MinWidth="{Binding Action2.MinWidth}" Margin="6,0,0,0" Visibility="{Binding Action2.Visible, Converter={StaticResource BoolToVis}}" IsEnabled="{Binding Action2.Enabled}" ToolTip="{Binding Action2.ToolTip}" AutomationProperties.Name="{Binding Action2.AutomationName}"/>
                              <Button Style="{StaticResource GhostButton}" Content="{Binding Action3.Label}" Tag="{Binding}" CommandParameter="{Binding Action3.Kind}" Click="EnhancementJobAction_Click" Height="28" MinWidth="{Binding Action3.MinWidth}" Margin="6,0,0,0" Visibility="{Binding Action3.Visible, Converter={StaticResource BoolToVis}}" IsEnabled="{Binding Action3.Enabled}" ToolTip="{Binding Action3.ToolTip}" AutomationProperties.Name="{Binding Action3.AutomationName}"/>
                              <Button Style="{StaticResource GhostButton}" Content="{Binding Action4.Label}" Tag="{Binding}" CommandParameter="{Binding Action4.Kind}" Click="EnhancementJobAction_Click" Height="28" MinWidth="{Binding Action4.MinWidth}" Margin="6,0,0,0" Visibility="{Binding Action4.Visible, Converter={StaticResource BoolToVis}}" IsEnabled="{Binding Action4.Enabled}" ToolTip="{Binding Action4.ToolTip}" AutomationProperties.Name="{Binding Action4.AutomationName}"/>
                              <Button Style="{StaticResource GhostButton}" Content="{Binding Action5.Label}" Tag="{Binding}" CommandParameter="{Binding Action5.Kind}" Click="EnhancementJobAction_Click" Height="28" MinWidth="{Binding Action5.MinWidth}" Margin="6,0,0,0" Visibility="{Binding Action5.Visible, Converter={StaticResource BoolToVis}}" IsEnabled="{Binding Action5.Enabled}" ToolTip="{Binding Action5.ToolTip}" AutomationProperties.Name="{Binding Action5.AutomationName}"/>
                              <Button Style="{StaticResource DangerButton}" Content="{Binding DangerAction.Label}" Tag="{Binding}" CommandParameter="{Binding DangerAction.Kind}" Click="EnhancementJobAction_Click" Height="28" MinWidth="{Binding DangerAction.MinWidth}" Margin="6,0,0,0" Visibility="{Binding DangerAction.Visible, Converter={StaticResource BoolToVis}}" IsEnabled="{Binding DangerAction.Enabled}" ToolTip="{Binding DangerAction.ToolTip}" AutomationProperties.Name="{Binding DangerAction.AutomationName}"/>
                            </WrapPanel>
                          </DockPanel>
                        </Grid>
                        <Border Grid.Row="1" Grid.ColumnSpan="2" Margin="0,10,0,0" Padding="10" CornerRadius="4"
                                Background="{StaticResource BgPrimary}" BorderBrush="{StaticResource GlassBorder}" BorderThickness="1"
                                Visibility="{Binding RequestDetailsExpanded, Converter={StaticResource BoolToVis}}">
                          <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <DockPanel Grid.Row="0" LastChildFill="True">
                              <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="コピー" Tag="{Binding}"
                                      Click="CopyEnhancementJobDetails_Click" Height="27" MinWidth="62" Margin="8,0,0,5"
                                      ToolTip="表示中のPromptと設定をClipboardへコピー"
                                      AutomationProperties.Name="PromptとAI設定をコピー"/>
                              <TextBlock Text="保存されたPrompt・設定" Foreground="{StaticResource TextSecondary}" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </DockPanel>
                            <TextBox Grid.Row="1" Text="{Binding RequestDetailsText, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True"
                                     TextWrapping="Wrap" MaxHeight="300" Padding="8" Background="{StaticResource BgSecondary}"
                                     Foreground="{StaticResource TextPrimary}" BorderBrush="{StaticResource GlassBorder}" BorderThickness="1"
                                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                     AutomationProperties.Name="保存されたAI処理Promptと設定"/>
                          </Grid>
                        </Border>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
              <DockPanel Grid.Row="1" x:Name="EnhancementJobsPaginationPanel" Visibility="Collapsed" LastChildFill="False"
                         HorizontalAlignment="Right" Margin="0,4,2,0">
                <Button x:Name="EnhancementJobsPreviousPageButton" Style="{StaticResource GhostButton}" Content="前へ"
                        Click="EnhancementJobsPreviousPage_Click" Height="28" MinWidth="58" IsEnabled="False"
                        AutomationProperties.Name="Previous enhancement jobs page"/>
                <TextBlock x:Name="EnhancementJobsPageText" Text="0 / 0" Foreground="{StaticResource TextSecondary}"
                           FontSize="11" VerticalAlignment="Center" Margin="10,0"
                           AutomationProperties.Name="Enhancement jobs page range"/>
                <Button x:Name="EnhancementJobsNextPageButton" Style="{StaticResource GhostButton}" Content="次へ"
                        Click="EnhancementJobsNextPage_Click" Height="28" MinWidth="58" IsEnabled="False"
                        AutomationProperties.Name="Next enhancement jobs page"/>
              </DockPanel>
            </Grid>
          </Grid>

          <Border Grid.Row="2" Background="{StaticResource BgPrimary}" BorderBrush="{StaticResource GlassBorder}" BorderThickness="0,1,0,0" Padding="12,0">
            <TextBlock x:Name="EnhancementJobsStatusText" Foreground="{StaticResource TextTertiary}" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                       AutomationProperties.Name="AI enhancement jobs status" AutomationProperties.LiveSetting="Polite"/>
          </Border>
        </Grid>
      </Border>
    </Grid>

    <!-- Explicit I2I edit board. Opening this surface performs only a passive
         capability GET; the companion may start only from the GO button. -->
    <Grid x:Name="I2iEditDialog" Grid.RowSpan="3" Panel.ZIndex="650"
          Visibility="Collapsed" Background="#A9000000"
          MouseLeftButtonDown="I2iEditBackdrop_MouseLeftButtonDown"
          AutomationProperties.Name="AI編集ボード"
          AutomationProperties.HelpText="髪色だけを編集するジョブを明示的に追加します。">
      <Border x:Name="I2iEditBoardBorder" Width="440" MaxHeight="640" Margin="18"
              HorizontalAlignment="Center" VerticalAlignment="Center"
              Padding="18" CornerRadius="8" Background="{StaticResource BgElevated}"
              BorderBrush="{StaticResource BorderStrong}" BorderThickness="1"
              KeyboardNavigation.TabNavigation="Cycle"
              KeyboardNavigation.ControlTabNavigation="Cycle">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <DockPanel Grid.Row="0" LastChildFill="True" Margin="0,0,0,12">
            <Button x:Name="I2iCloseButton" DockPanel.Dock="Right"
                    Style="{StaticResource IconButton}" Width="32" Height="32"
                    Click="CloseI2iEdit_Click" ToolTip="閉じる"
                    AutomationProperties.Name="AI編集ボードを閉じる">
              <Path Data="M18,6 L6,18 M6,6 L18,18" Stroke="{StaticResource TextSecondary}"
                    StrokeThickness="1.8" Stretch="Uniform" Width="14" Height="14"/>
            </Button>
            <StackPanel>
              <TextBlock Text="AI編集" Foreground="{StaticResource TextPrimary}"
                         FontSize="18" FontWeight="SemiBold"/>
              <TextBlock Text="髪色" Foreground="{StaticResource TextTertiary}"
                         FontSize="10.5" Margin="0,3,0,0"/>
            </StackPanel>
          </DockPanel>
          <ScrollViewer x:Name="I2iEditScrollViewer" Grid.Row="1"
                        VerticalScrollBarVisibility="Auto"
                        HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
              <TextBlock Text="入力元" Foreground="{StaticResource TextTertiary}" FontSize="10.5"/>
              <TextBlock x:Name="I2iSourceText" Text="Original"
                         Foreground="{StaticResource TextPrimary}" FontSize="12.5"
                         FontWeight="SemiBold" Margin="0,2,0,12"/>
              <TextBlock Text="髪色（必須）" Foreground="{StaticResource TextPrimary}"
                         FontSize="11.5" Margin="0,0,0,4"/>
              <TextBox x:Name="I2iHairColorTextBox" MaxLength="160"
                       Padding="8,6" Foreground="{StaticResource TextPrimary}"
                       Background="{StaticResource BgPrimary}"
                       CaretBrush="{StaticResource TextPrimary}"
                       SelectionBrush="{StaticResource AccentFill}"
                       BorderBrush="{StaticResource BorderStrong}"
                       TextChanged="I2iEditField_TextChanged"
                       AutomationProperties.Name="編集後の髪色"/>
              <TextBlock Text="補足（任意・240文字まで）"
                         Foreground="{StaticResource TextPrimary}" FontSize="11.5"
                         Margin="0,12,0,4"/>
              <TextBox x:Name="I2iDetailsTextBox" MaxLength="240" MinHeight="68"
                       AcceptsReturn="True" TextWrapping="Wrap"
                       VerticalScrollBarVisibility="Auto" Padding="8,6"
                       Foreground="{StaticResource TextPrimary}"
                       Background="{StaticResource BgPrimary}"
                       CaretBrush="{StaticResource TextPrimary}"
                       SelectionBrush="{StaticResource AccentFill}"
                       BorderBrush="{StaticResource BorderStrong}"
                       TextChanged="I2iEditField_TextChanged"
                       AutomationProperties.Name="髪色編集の補足"/>
              <Grid Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                  <TextBlock Text="Seed" Foreground="{StaticResource TextPrimary}" FontSize="11.5" Margin="0,0,0,4"/>
                  <ComboBox x:Name="I2iSeedModeComboBox"
                            Style="{StaticResource PhotorealSettingsComboBox}"
                            SelectedIndex="0" SelectionChanged="I2iSeedMode_SelectionChanged"
                            AutomationProperties.Name="AI編集 seed mode">
                    <ComboBoxItem Content="Random（推奨）" Tag="random"/>
                    <ComboBoxItem Content="Fixed" Tag="fixed"/>
                  </ComboBox>
                </StackPanel>
                <StackPanel Grid.Column="2">
                  <TextBlock Text="Fixed値（0〜2147483647）" Foreground="{StaticResource TextPrimary}" FontSize="11.5" Margin="0,0,0,4"/>
                  <TextBox x:Name="I2iSeedValueTextBox" MaxLength="10" IsEnabled="False"
                           Padding="7,4" Foreground="{StaticResource TextPrimary}"
                           Background="{StaticResource BgPrimary}"
                           CaretBrush="{StaticResource TextPrimary}"
                           SelectionBrush="{StaticResource AccentFill}"
                           BorderBrush="{StaticResource BorderStrong}"
                           TextChanged="I2iEditField_TextChanged"
                           AutomationProperties.Name="Fixed AI編集 seed"/>
                </StackPanel>
              </Grid>
              <TextBlock x:Name="I2iSeedStatusText" Visibility="Collapsed"
                         Foreground="{StaticResource TextSecondary}" FontSize="10.5"
                         TextWrapping="Wrap" Margin="0,6,0,0"/>
              <Border Margin="0,14,0,0" Padding="10" CornerRadius="5"
                      Background="{StaticResource BgPrimary}"
                      BorderBrush="{StaticResource GlassBorder}" BorderThickness="1">
                <TextBlock Text="顔の中心部と髪以外の画素は、選択した元版から自動復元されます。顔の同一性と未編集領域を保護します。"
                           Foreground="{StaticResource TextSecondary}" FontSize="10.8"
                           TextWrapping="Wrap"/>
              </Border>
              <TextBlock x:Name="I2iEditStatusText"
                         Foreground="{StaticResource TextSecondary}" FontSize="10.8"
                         TextWrapping="Wrap" Margin="0,12,0,0"
                         AutomationProperties.LiveSetting="Polite"/>
            </StackPanel>
          </ScrollViewer>
          <DockPanel Grid.Row="2" Margin="0,14,0,0" LastChildFill="False">
            <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}"
                    Content="閉じる" MinWidth="72" Height="32" Margin="8,0,0,0"
                    Click="CloseI2iEdit_Click"/>
            <Button x:Name="I2iQueueButton" DockPanel.Dock="Right"
                    Style="{StaticResource PrimaryButton}" Content="GO"
                    MinWidth="108" Height="32" IsEnabled="False"
                    Click="QueueI2iEdit_Click"
                    AutomationProperties.Name="GO: AI編集ジョブをキューへ追加"
                    AutomationProperties.HelpText="GOを押した時だけcompanionを起動し、ジョブを追加します。"/>
          </DockPanel>
        </Grid>
      </Border>
    </Grid>

