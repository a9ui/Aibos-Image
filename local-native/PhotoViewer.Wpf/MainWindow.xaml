            <ContextMenu x:Name="RowsContextMenu" AutomationProperties.Name="Image list actions">
              <MenuItem Header="AI高画質化" Click="GalleryContextUpscale_Click" AutomationProperties.Name="AI高画質化"/>
              <MenuItem Header="AI実写化" Click="GalleryContextPhotoreal_Click" AutomationProperties.Name="AI実写化"/>
              <MenuItem Header="AI実写高画質化のみ" Click="GalleryContextPhotorealUpscale_Click" AutomationProperties.Name="AI実写高画質化のみ"/>
              <Separator/>
              <MenuItem Header="次に高画質化" Click="GalleryContextUpscaleNext_Click" AutomationProperties.Name="次に高画質化"/>
              <MenuItem Header="次に実写化" Click="GalleryContextPhotorealNext_Click" AutomationProperties.Name="次に実写化"/>
              <MenuItem Header="動画化" AutomationProperties.Name="Choose video generation source">
                <MenuItem Header="Originalから..." Tag="original" Click="GalleryContextVideo_Click" AutomationProperties.Name="Generate video from Original"/>
                <MenuItem Header="最新の実写版から..." Tag="photoreal" Click="GalleryContextVideo_Click" AutomationProperties.Name="Generate video from latest photoreal version"/>
              </MenuItem>
              <Separator/>
              <MenuItem Header="拡大表示" Click="GalleryContextOpenModal_Click" AutomationProperties.Name="Open enlarged image"/>
              <MenuItem Header="外部アプリで開く" Click="OpenSelectedExternally_Click" AutomationProperties.Name="Open selected image externally"/>
              <MenuItem Header="元画像の場所を開く" Click="ShowSelectedInFolder_Click" AutomationProperties.Name="Show selected source in folder"/>
              <MenuItem Header="Albumへ追加" Click="AddCurrentToAlbum_Click" AutomationProperties.Name="Add selected image to Album"/>
            </ContextMenu>
          </ListBox.ContextMenu>
          <ListBox.ItemsPanel><ItemsPanelTemplate><VirtualizingStackPanel/></ItemsPanelTemplate></ListBox.ItemsPanel>
          <ListBox.GroupStyle>
            <GroupStyle>
              <GroupStyle.HeaderTemplate>
                <DataTemplate>
                  <DockPanel Margin="14,14,14,4">
                    <TextBlock DockPanel.Dock="Left" Text="{Binding Name}" Foreground="{DynamicResource TextSecondary}" FontSize="12" FontWeight="Bold" VerticalAlignment="Center"/>
                    <Rectangle Height="1" VerticalAlignment="Center" Margin="12,0,0,0">
                      <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                          <GradientStop Color="{DynamicResource DividerMediumColor}" Offset="0"/>
                          <GradientStop Color="{DynamicResource DividerSubtleColor}" Offset="1"/>
