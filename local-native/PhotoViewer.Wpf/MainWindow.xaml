                            ToolTip="Increase favorite level for selected images" AutomationProperties.Name="Increase favorite level for selected images"/>
                  </UniformGrid>
                  <Button x:Name="BulkEnhanceSelectedButton" Style="{StaticResource GhostButton}" Content="Enhance selected" Click="OpenBatchEnhancement_Click"
                          ToolTip="Review and create one optional local enhancement job per selected image"
                          AutomationProperties.Name="Enhance selected images"
                          AutomationProperties.HelpText="Opens a review first. Opening or closing the review creates no enhancement jobs."
                          Margin="0,8,0,0"/>
                  <Button x:Name="BulkDeleteButton" Style="{StaticResource DangerButton}" Content="Move selected to Recycle Bin" Click="BulkDeleteSelected_Click"
                          ToolTip="Move every selected source image to the Windows Recycle Bin" AutomationProperties.Name="Move selected images to Recycle Bin" Margin="0,8,0,0"/>
                </StackPanel>
              </Border>

              <!-- actions -->
              <WrapPanel x:Name="SingleSelectionActions" Orientation="Horizontal" Margin="0,0,0,6"
                         KeyboardNavigation.TabNavigation="Continue" AutomationProperties.Name="Selected image actions">
