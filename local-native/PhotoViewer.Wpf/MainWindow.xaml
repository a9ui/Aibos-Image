                  <CheckBox x:Name="EnhancementJobsVideoFilter" Style="{StaticResource EnhancementJobsFilterPill}" Content="動画化" Tag="video" Click="EnhancementJobsOperationFilter_Click" ToolTip="動画化Jobだけを表示"
