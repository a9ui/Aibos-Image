          <Border Background="{StaticResource BgTertiary}" BorderBrush="{StaticResource GlassBorder}" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,0,18">
            <StackPanel>
              <TextBox x:Name="EnhancementOutputRootTextBox"
                       IsReadOnly="True" IsReadOnlyCaretVisible="True"
                       HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                       TextWrapping="NoWrap" Padding="7,5"
                       Background="{StaticResource BgPrimary}" BorderBrush="{StaticResource GlassBorder}"
                       Foreground="{StaticResource TextSecondary}"
                       AutomationProperties.Name="AI enhancement output root"
                       AutomationProperties.HelpText="Parent folder containing the fixed Upscaled, Photorealized, and Videos output folders."/>
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,8,0,0">
                <Button x:Name="ChangeEnhancementOutputRootButton" Style="{StaticResource GhostButton}" Content="変更..." Click="ChangeEnhancementOutputRoot_Click" MinWidth="92" Margin="0,0,8,0"
                        AutomationProperties.Name="Change AI enhancement output folder"/>
                <Button x:Name="OpenEnhancementOutputRootButton" Style="{StaticResource GhostButton}" Content="フォルダを開く" Click="OpenEnhancementOutputRoot_Click" MinWidth="116"
                        AutomationProperties.Name="Open AI enhancement output folder"/>
              </StackPanel>
              <TextBlock x:Name="EnhancementOutputRootStatusText" Foreground="{StaticResource TextTertiary}" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0" AutomationProperties.LiveSetting="Polite"/>
            </StackPanel>
          </Border>
          <TextBlock x:Name="ThumbnailSettingsHeading" Text="THUMBNAILS" Foreground="{StaticResource TextTertiary}" FontSize="10.5" FontWeight="SemiBold" Margin="0,0,0,6" AutomationProperties.Name="Thumbnail settings section"/>
